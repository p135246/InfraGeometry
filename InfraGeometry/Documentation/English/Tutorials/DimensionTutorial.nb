Cell[TextData[{
 "Here the cover size itself changes with resolution, so the fixed-",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d128e611-f23a-4514-b5e2-b586c002c56d"],
 " bound above does not establish the expected exponent. The lattice \
correction, ball shape, target boundary and greedy overhead all affect this \
plot. No universal half-step correction to the covering radius exists."
}], "Text",
 CellDingbat->None,ExpressionUUID->"dc465046-9b6e-4e8f-885e-63b97e24721e"],

Cell["What dimension does not determine", "Section",ExpressionUUID->"5f11a8a8-3cec-4adf-a551-c8cf82a7bd01"],

Cell[TextData[{
 "The square tiling and the plane mesh can have the same volume-growth \
exponent while having different ball shapes. The single-scale quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["log", "2"], 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["B", "TI"], 
       RowBox[{"2", 
        StyleBox["r", "TI"]}]], "(", 
      StyleBox["c", "TI"], ")"}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"71dc70c6-6489-4b7d-ad6e-b4385dd66c9e"],
 " also includes the overlap needed to cover a ball, so it need not match \
that exponent. A greedy cover provides only an upper bound for this \
quantity."
}], "Text",
 CellDingbat->None,ExpressionUUID->"3db7992c-03f3-42ce-a1c7-e28772de2120"],

Cell[TextData[{
 "Ball hulls give another shape-sensitive test. ",
 ButtonBox["InfraBallHull",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull"],
 " intersects all graph balls containing the chosen points. In Euclidean \
space, the corresponding intersection is their convex hull. The gallery \
compares two tilings, a planar mesh, a sphere mesh, a spatial mesh and a \
Sierpinski graph. Each pair is chosen along a shortest path, and a third \
point is chosen at roughly the same distance from both endpoints. The pair \
hull is dark blue; additional vertices in the triple hull are pale blue; the \
three points are red. All choices use graph distance and the graphs retain \
their default layouts."
}], "Text",
 CellDingbat->None,ExpressionUUID->"50836e66-335f-45b6-b0db-83194c42ee46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"BlockRandom", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrate", "[", " ", 
              RowBox[{"name", ",", " ", "\"\<Large\>\""}], " ", "]"}], ",", 
             " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
