Notebook[{

Cell[CellGroupData[{
Cell["Dimension", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Can the same dimension be read from counting vertices and from covering them \
with larger graph balls? We compare these measurements across a range of \
graph distances. The drawing supplies no measurement.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"7fa9f118-6636-45bb-a0b4-38e1af568d26"],

Cell["Growth and scale", "Section",ExpressionUUID->"432436a9-355f-4936-8b9b-6e7229f99a53"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["s", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["c", "TI"], ",", 
        StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
      StyleBox["s", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"65cce49c-f0ec-4b8f-9a0f-b1b8432dc286"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     StyleBox["s", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", "|"}], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["s", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "|"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8bc5f6fa-68a2-4cf4-8379-64a48d4f7048"],
 ". A power law ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     StyleBox["s", "TI"], ")"}], "\[Tilde]", 
    StyleBox["C", "TI"], 
    SuperscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["d", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e1c94657-8f57-435d-afcc-d89c08fffe28"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", 
      StyleBox["s", "TI"]}], ")"}], "/", 
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     StyleBox["s", "TI"], ")"}], "\[Rule]", 
    SuperscriptBox["\[Lambda]", 
     StyleBox["d", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ee540f84-7427-49f8-a60d-0af36f847eb6"],
 " at each fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", ">", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2d8ff81a-1806-458e-ae8c-c444d13464d6"],
 ". Scaling lengths by ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ce81f54d-3198-425b-9530-4285c369dba7"],
 " scales volume by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", 
    StyleBox["d", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4dd79914-9a34-4507-9ca5-1ccd2bc465bf"],
 ". This is the scale comparison we test. A finite graph provides only a \
window between its individual layers and its boundary."
}], "Text",
 CellDingbat->None,ExpressionUUID->"27c4d4bd-2460-4f44-89c6-b80077316074"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a8babcf1-1e72-4b39-86c5-7daf2f1756a7"],

Cell[TextData[{
 "The mesh and regular tilings have reference growth dimension two. The \
Sierpinski triangle has three half-sized copies, giving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"log3", "/", "log2"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8cea6024-9378-41cf-914f-2e80a7dab662"],
 ". The planar Menger carpet has eight third-sized copies, giving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"log8", "/", "log3"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2e8ae458-96e6-4453-aac6-23ae97ff5805"],
 ". These are reference dimensions of the limiting constructions; the graphs \
below are finite approximations. The carpet uses three construction steps to \
keep the covering calculations practical. Three unfilled gray contours show \
convex envelopes of balls at roughly one third, two thirds and the full \
target radius. The target radius is four fifths of the graph radius, rounded \
down. The contours show growth in the drawing; the balls themselves are \
defined by graph distance."
}], "Text",
 CellDingbat->None,ExpressionUUID->"eaf14b59-d2f5-4169-b07b-6e043e6c62a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionSubstrates", " ", "=", " ", 
   RowBox[{"Apply", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"name", ",", " ", "size", ",", " ", "reference"}], " ", "}"}], 
      " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"graph", " ", "=", " ", 
          RowBox[{"InfraSubstrate", "[", " ", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", 
          " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"Floor", "[", " ", 
            RowBox[{"4", " ", 
             RowBox[{
              RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", 
              " ", "5"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"<|", " ", 
         RowBox[{
          RowBox[{"\"\<Name\>\"", " ", "->", " ", "name"}], ",", " ", 
          RowBox[{"\"\<Graph\>\"", " ", "->", " ", "graph"}], ",", " ", 
          RowBox[{"\"\<Centre\>\"", " ", "->", " ", "centre"}], ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}], ",", "\n", 
          "      ", 
          RowBox[{"\"\<Reference\>\"", " ", "->", " ", "reference"}]}], " ", 
         "|>"}]}], " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",",
          " ", "2"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",",
          " ", "2"}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", " ", "\"\<Large\>\"", 
         ",", " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "3", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "2", " ", "]"}]}]}], " ", "}"}], ",", "\n",
        "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<MengerCarpetGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
         " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "8", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "3", " ", "]"}]}]}], " ", "}"}]}], " ", 
      "}"}], ",", " ", 
     RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"data", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"graph", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", 
            " ", 
            RowBox[{"centre", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", 
            " ", 
            RowBox[{"radius", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
           "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"balls", " ", "=", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"r", " ", "|->", " ", 
               RowBox[{"Keys", " ", "@", " ", 
                RowBox[{"InfraMeasurement", "[", " ", 
                 RowBox[{"graph", ",", " ", 
                  RowBox[{"InfraBall", "[", " ", 
                   RowBox[{"centre", ",", " ", "r"}], " ", "]"}], ",", 
                  " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", "\n", 
              "        ", 
              RowBox[{"Floor", "[", " ", 
               RowBox[{"radius", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"1", "/", "3"}], ",", " ", 
                  RowBox[{"2", "/", "3"}], ",", " ", "1"}], " ", "}"}]}], " ",
                "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"Labeled", "[", " ", 
           RowBox[{
            RowBox[{"InfraSubstrateHighlight", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{"centre", " ", "->", " ", "StandardGray"}], " ", "}"}],
               ",", "\n", "      ", 
              RowBox[{"Epilog", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"StandardGray", ",", " ", 
                 RowBox[{"AbsoluteThickness", "[", " ", "1.5", " ", "]"}], ",",
                  " ", 
                 RowBox[{"Map", "[", "\n", "        ", 
                  RowBox[{
                   RowBox[{"vertices", " ", "|->", " ", 
                    RowBox[{"MeshPrimitives", "[", "\n", "          ", 
                    RowBox[{
                    RowBox[{"ConvexHullMesh", "[", " ", 
                    RowBox[{
                    RowBox[{"GraphEmbedding", "[", " ", "graph", " ", "]"}], "[", 
                    RowBox[{"[", " ", 
                    RowBox[{"Map", "[", " ", 
                    RowBox[{
                    RowBox[{"v", " ", "|->", " ", 
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], ",", " ", 
                    "vertices"}], " ", "]"}], " ", "]"}], "]"}], " ", "]"}], ",",
                     " ", "1"}], " ", "]"}]}], ",", "\n", "        ", 
                   "balls"}], " ", "]"}]}], " ", "}"}]}], " ", ",", "\n", 
              "      ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             " ", 
            RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], " ", 
           "]"}]}], " ", "]"}]}], ",", "\n", "  ", "dimensionSubstrates"}], 
      " ", "]"}], ",", " ", "3"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2adc99fe-f458-4946-9525-0edfa87c2b6f"],

