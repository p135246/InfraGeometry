Cell["Does the exponent depend on resolution?", "Section",ExpressionUUID->"67e769c5-5f8b-4694-8afc-075442d4c7fc"],

Cell[TextData[{
 "Fix ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "08cb1f44-b067-4218-9e56-8d04bb0f90c2"],
 " and grow the target ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["s", "TI"]], "(", 
    StyleBox["c", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b049a7ae-cb58-4c1f-8fee-d3c427698ce4"],
 ". Counting a radius-zero cover is exactly counting vertices. At larger ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "366c8401-d2cf-46ea-9af3-8e43e5aa403e"],
 ", each covering ball replaces a bounded number of vertices. Indeed, if \
every radius-",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "76ba4286-fb85-402f-8f7d-be022b3ab2fa"],
 " ball has at most ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["r", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "56a22bf0-6a2f-4548-bd20-ef9af66c6142"],
 " vertices, then"
}], "Text",
 CellDingbat->None,ExpressionUUID->"5e358280-cc53-46d4-9a9e-c5bb237aea94"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     TemplateBox[{
       RowBox[{
         StyleBox["T", "TI"]}]},
      "Abs"], 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox["r", "TI"]]], "\[LessEqual]", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], 
    RowBox[{"\[LessEqual]", "|"}], 
    StyleBox["T", "TI"], 
    RowBox[{"|", "."}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cda41048-acd1-4aec-b41c-81f2eece1eeb"],
 "  "
}], "DisplayFormula",ExpressionUUID->"63abff4a-6ac6-452a-9690-e717ac1580f4"],

Cell[TextData[{
 "The left inequality counts how many vertices the covering balls contain. \
The right inequality places one ball at each target vertex. Therefore, on an \
infinite graph with this bound, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "|"}], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["s", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], 
    RowBox[{"|", 
     RowBox[{"/", "log"}]}], 
    StyleBox["s", "TI"], "\[Rule]", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e1310bd0-dd64-4866-bc63-3ddcacd61a48"],
 " implies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", 
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["s", "TI"]], "(", 
      StyleBox["c", "TI"], ")"}], ")"}], 
    RowBox[{"/", "log"}], 
    StyleBox["s", "TI"], "\[Rule]", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "52d654a4-f969-4790-8e41-37993f66ea71"],
 ". The multiplicative factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["r", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28b4fcd9-ebba-4d8c-b163-f0a10adbe2bd"],
 " disappears after dividing its logarithm by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "949aa461-597c-475d-841d-6bb147f5846b"],
 ". This preserves the growth exponent at each fixed resolution; it does not \
prove that a finite graph has a power-law window."
}], "Text",
 CellDingbat->None,ExpressionUUID->"7b62b99e-6fec-4cd9-9524-6a76bf2483ba"],

Cell[TextData[{
 "The following profiles compare vertex counts with greedy covers of radii \
one and two. For a count ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "(", 
    StyleBox["s", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b7cef052-bad6-4751-835d-9fe1f05da004"],
 " and reference exponent ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c1bb06f4-03d3-4d45-977c-f9f0a209d4d4"],
 ", we plot"
}], "Text",
 CellDingbat->None,ExpressionUUID->"586974ba-770f-4895-9f79-818be4e4b282"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"(", 
       StyleBox["s", "TI"], ")"}], "/", 
      SuperscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["d", "TI"]]}], 
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["s", "TI"], "0"], ")"}], "/", 
      SubsuperscriptBox[
       StyleBox["s", "TI"], "0", 
       StyleBox["d", "TI"]]}]], ",", "    ", 
    RowBox[{
     SubscriptBox[
      StyleBox["s", "TI"], "0"], 
     RowBox[{"\[LongEqual]", "4."}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"68a1f94f-8c9e-463c-b123-4d440c57dfea"],
 "  "
}], "DisplayFormula",ExpressionUUID->"d37f3947-e39c-4f4b-b38b-f5bd5e0e4e77"],

Cell[TextData[{
 "A horizontal profile means that the exponent ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7bb11b2b-0fab-4408-9331-50bab7a1da0b"],
 " describes this measurement over the displayed window. Dividing by the \
first value removes the different units of the three counts. The dashed curve \
in the square-tiling panel is the exact lattice count ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], 
    RowBox[{"+", "2"}], 
    StyleBox["s", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "65f805b7-c700-4a31-8ad0-31ecc83e37b4"],
 ", normalized in the same way. It provides a control for the drift caused by \
individual graph layers."
}], "Text",
 CellDingbat->None,ExpressionUUID->"1f0d99f6-d21a-4a70-963e-b713bc230f31"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionProfiles", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"data", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
          
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"radii", " ", "=", " ", 
          RowBox[{"Range", "[", " ", 
           RowBox[{"4", ",", " ", "radius"}], " ", "]"}]}], " ", "}"}], ",", 
        "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"regions", " ", "=", " ", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{"s", " ", "|->", " ", 
             RowBox[{"InfraBall", "[", " ", 
              RowBox[{"centre", ",", " ", "s"}], " ", "]"}]}], ",", " ", 
            "radii"}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"counts", " ", "=", " ", 
          RowBox[{"Prepend", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"Table", "[", " ", 
             RowBox[{
              RowBox[{"Map", "[", " ", 
               RowBox[{
                RowBox[{"region", " ", "|->", " ", 
                 RowBox[{"Length", " ", "@", " ", 
                  RowBox[{"FindBallCover", "[", " ", 
                   RowBox[{
                   "graph", ",", " ", "r", ",", " ", "region", ",", " ", 
                    RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], 
                   " ", "]"}]}]}], ",", " ", "regions"}], " ", "]"}], ",", 
              " ", 
              RowBox[{"{", " ", 
               RowBox[{"r", ",", " ", "1", ",", " ", "2"}], " ", "}"}]}], " ",
              "]"}], ",", "\n", "        ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{
             "graph", ",", " ", "regions", ",", 
              " ", "\"\<CountingMeasure\>\""}], " ", "]"}]}], " ", "]"}]}], 
         " ", "}"}], ",", "\n", "    ", 
        RowBox[{"Join", "[", " ", 
         RowBox[{"data", ",", " ", 
          RowBox[{"<|", " ", 
           RowBox[{
            RowBox[{"\"\<GrowthRadii\>\"", " ", "->", " ", "radii"}], ",", 
            " ", 
            RowBox[{"\"\<GrowthCounts\>\"", " ", "->", " ", "counts"}]}], " ",
            "|>"}]}], " ", "]"}]}], " ", "]"}]}], ",", "\n", "  ", 
     "dimensionSubstrates"}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"data", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"radii", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}]}], ",",
             " ", 
            RowBox[{"dimension", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Reference\>\"", " ", "]"}]}], ",",
             " ", 
            RowBox[{"square", " ", "=", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}], " ", "===",
               " ", "\"\<SquareTilingGraph\>\""}]}]}], " ", "}"}], ",", "\n", 
          "    ", 
          RowBox[{"{", " ", 
           RowBox[{"profiles", " ", "=", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"counts", " ", "|->", " ", 
               RowBox[{"counts", " ", "/", " ", 
                RowBox[{"radii", "^", "dimension"}]}]}], ",", " ", 
              RowBox[{"data", "[", " ", "\"\<GrowthCounts\>\"", " ", "]"}]}], 
             " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"compared", " ", "=", " ", 
            RowBox[{"If", "[", " ", 
             RowBox[{"square", ",", " ", 
              RowBox[{"Append", "[", " ", 
               RowBox[{"profiles", ",", " ", 
                RowBox[{"2", " ", "+", " ", 
                 RowBox[{"2", " ", "/", " ", "radii"}], " ", "+", " ", 
                 RowBox[{"1", " ", "/", " ", 
                  RowBox[{"radii", "^", "2"}]}]}]}], " ", "]"}], ",", " ", 
              "profiles"}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"ListLinePlot", "[", " ", 
           RowBox[{
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"profile", " ", "|->", " ", 
               RowBox[{"Transpose", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"radii", ",", " ", 
                  RowBox[{"profile", " ", "/", " ", 
                   RowBox[{"First", "[", " ", "profile", " ", "]"}]}]}], " ", 
                 "}"}], " ", "]"}]}], ",", " ", "compared"}], " ", "]"}], ",",
             "\n", "      ", 
            RowBox[{"PlotLabel", " ", "->", " ", 
             RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], ",", 
            "\n", "      ", 
            RowBox[{"PlotLegends", " ", "->", " ", 
             RowBox[{"If", "[", " ", 
              RowBox[{"square", ",", " ", 
               RowBox[{"{", " ", 
                
                RowBox[{"\"\<vertices\>\"", ",", " ", "\"\<radius 1\>\"", ",",
                  " ", "\"\<radius 2\>\"", ",", 
                 " ", "\"\<exact lattice\>\""}], " ", "}"}], ",", " ", 
               RowBox[{"{", " ", 
                
                RowBox[{"\"\<vertices\>\"", ",", " ", "\"\<radius 1\>\"", ",",
                  " ", "\"\<radius 2\>\""}], " ", "}"}]}], " ", "]"}]}], ",", 
            "\n", "      ", 
            RowBox[{"PlotStyle", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{
              "StandardBlue", ",", " ", "StandardOrange", ",", " ", 
               "StandardGreen", ",", " ", 
               RowBox[{"Directive", "[", " ", 
                RowBox[{"StandardGray", ",", " ", "Dashed"}], " ", "]"}]}], 
              " ", "}"}]}], ",", "\n", "      ", 
            RowBox[{"AxesLabel", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"\"\<s\>\"", ",", " ", "\"\<normalized count\>\""}], 
              " ", "}"}]}], ",", " ", 
            RowBox[{"GridLines", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"None", ",", " ", 
               RowBox[{"{", " ", "1", " ", "}"}]}], " ", "}"}]}], ",", " ", 
            RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}]}], " ",
          "]"}]}], ",", "\n", "  ", "dimensionProfiles"}], " ", "]"}], ",", 
     " ", "3"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"06554c17-8cd8-496d-8ee9-538baa94cef0"],

