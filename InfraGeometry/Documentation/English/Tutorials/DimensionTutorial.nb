Cell[TextData[{
 "These are finite hulls, whose size depends on the surrounding graph and its \
available enclosing balls. A pair can already have a substantial hull. The \
square-tiling example below chooses a pair with a unique shortest path, shown \
in green. Its blue ball hull extends beyond that path. We then add a third \
point outside the path but inside the hull. The hull remains unchanged: every \
ball containing the original pair already contains the third point. More \
generally, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["S", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3bbbcd36-e260-4156-95a9-3e0a96a75232"],
 " is the intersection of all balls containing ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6b94fbb1-e67c-4d36-b81b-4cfce873cf16"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[Element]", 
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     StyleBox["S", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9e9a1c17-add4-4328-9ea9-219f78db4bec"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S", "TI"], "\[Union]", 
      RowBox[{"{", 
       StyleBox["q", "TI"], "}"}]}], ")"}], "\[LongEqual]", 
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     StyleBox["S", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6d965b5-d19e-435f-a721-b2a88a7b3ce5"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"83f93cfb-8767-4708-b115-9d59b20f556d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", " ", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", " ", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], " ",
         "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"centre", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", " ", 
     RowBox[{"separation", " ", "=", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Floor", "[", " ", 
        RowBox[{
         RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", " ", 
         "4"}], " ", "]"}]}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraShell", "[", " ", 
         RowBox[{"centre", ",", " ", "separation"}], " ", "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{"endpoint", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", " ", 
      RowBox[{"shell", ",", "\n", "      ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", " ", 
          RowBox[{"graph", ",", " ", 
           RowBox[{"InfraSegment", "[", " ", 
            RowBox[{"centre", ",", " ", "v"}], " ", "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], " ", "]"}], " ", "===", " ", 
         "1"}]}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"pair", " ", "=", " ", 
      RowBox[{"{", " ", 
       RowBox[{"centre", ",", " ", "endpoint"}], " ", "}"}]}], ",", " ", 
     RowBox[{"distances", " ", "=", " ", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", " ", 
         RowBox[{"graph", ",", " ", "centre"}], " ", "]"}], ",", " ", 
        RowBox[{"GraphDistance", "[", " ", 
         RowBox[{"graph", ",", " ", "endpoint"}], " ", "]"}]}], " ", 
       "}"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"pairHull", " ", "=", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"graph", ",", " ", 
         RowBox[{"InfraBallHull", "[", " ", "pair", " ", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"interval", " ", "=", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"graph", ",", " ", 
         RowBox[{"InfraSegment", "[", " ", 
          RowBox[{"centre", ",", " ", "endpoint"}], " ", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"third", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", " ", 
       RowBox[{
        RowBox[{"Complement", "[", " ", 
         RowBox[{"pairHull", ",", " ", "interval"}], " ", "]"}], ",", "\n", 
        "      ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{"Min", "[", " ", 
          RowBox[{"distances", "[", 
           RowBox[{"[", " ", 
            RowBox[{"All", ",", " ", 
             RowBox[{"VertexIndex", "[", " ", 
              RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], " ", "]"}], 
           "]"}], " ", "]"}]}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"seeds", " ", "=", " ", 
     RowBox[{"Append", "[", " ", 
      RowBox[{"pair", ",", " ", "third"}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsGrid", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{"Table", "[", " ", 
       RowBox[{
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"points", " ", "=", " ", 
            RowBox[{"Take", "[", " ", 
             RowBox[{"seeds", ",", " ", "k"}], " ", "]"}]}], " ", "}"}], ",", 
          "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"hull", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", " ", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"InfraBallHull", "[", " ", "points", " ", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",",
           "\n", "    ", 
          RowBox[{"Labeled", "[", " ", 
           RowBox[{
            RowBox[{"InfraSubstrateHighlight", "[", " ", 
             RowBox[{"graph", ",", "\n", "      ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Complement", "[", " ", 
                  RowBox[{"hull", ",", " ", 
                   RowBox[{"Join", "[", " ", 
                    RowBox[{"interval", ",", " ", "points"}], " ", "]"}]}], 
                  " ", "]"}], " ", "->", " ", "StandardBlue"}], ",", "\n", 
                "        ", 
                RowBox[{
                 RowBox[{"InfraSegment", "[", " ", 
                  RowBox[{"centre", ",", " ", "endpoint"}], " ", "]"}], " ", "->",
                  " ", "StandardGreen"}], ",", " ", 
                RowBox[{"points", " ", "->", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"StandardRed", ",", " ", 
                   RowBox[{"AbsolutePointSize", "[", " ", "7", " ", "]"}]}], 
                  " ", "}"}]}]}], " ", "}"}], " ", ",", "\n", "      ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             "\n", "      ", 
            RowBox[{"If", "[", " ", 
             RowBox[{
              RowBox[{"k", " ", "===", " ", "2"}], ",", 
              " ", "\"\<two points: hull beyond the path\>\"", ",", 
              " ", "\"\<third point: same hull\>\""}], " ", "]"}]}], " ", 
           "]"}]}], " ", "]"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"k", ",", " ", "2", ",", " ", "3"}], " ", "}"}]}], " ", 
       "]"}], " ", "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"b58118ea-7fef-48f1-990e-3fd000cca302"],

