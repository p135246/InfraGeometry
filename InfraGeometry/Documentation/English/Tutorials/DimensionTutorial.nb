Cell[TextData[{
 "Drift from the horizontal line shows how the finite profiles differ from a \
single power law. On the square lattice, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     StyleBox["s", "TI"], ")"}], "/", 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"2", "+", 
      RowBox[{"2", "/"}]}]}], 
    StyleBox["s", "TI"], 
    RowBox[{
     RowBox[{"+", "1"}], "/"}], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75bb5b03-cdb8-4349-8193-9f2d1419a84a"],
 " explains such drift even though the leading growth dimension is exactly \
two. The measured vertex profile coincides with this dashed control before \
the finite graph truncates the balls. Integer cover counts can produce steps, \
and the self-similar examples can oscillate with scale. The available scale \
windows differ between substrates. The greedy algorithm uses at most one ball \
per target vertex, so its counts satisfy the same bounds with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["r", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "30f0fafa-dff9-4905-aa54-83a8decf4837"],
 " at fixed ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e3d94f4e-694e-4baa-a299-2a6a85c5fabb"],
 ". Those bounds preserve an asymptotic exponent but do not control the \
fitting error over this finite window."
}], "Text",
 CellDingbat->None,ExpressionUUID->"f3ddc4a7-71eb-471c-9b30-ba6bc3ce263b"],

Cell["Changing the covering radius", "Section",ExpressionUUID->"a88a43d7-9cb3-40c6-8f24-c750f4d9d709"],

Cell[TextData[{
 "Now fix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["B", "TI"], "\[Rho]"], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2eec876f-f666-4969-a18d-d42bf4d5d4b8"],
 " and vary ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bea85481-0b6b-4331-a451-fed60e8ec227"],
 ". For a homogeneous ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "08889384-02f5-4437-9e65-bbac9f5923aa"],
 "-dimensional region one expects ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["r", "TI"]], "(", 
    StyleBox["T", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5fd571d3-3c1d-48ac-b776-642c6c2c0475"],
 " to have order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Rho]", "/"}], 
      StyleBox["r", "TI"]}], ")"}], 
    StyleBox["d", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bd50bfde-e590-4023-9bb8-7643c49f6dc4"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "\[LessLess]"}], 
    StyleBox["r", "TI"], 
    RowBox[{"\[LessLess]", "\[Rho]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"19227ff9-647f-40d4-9640-01d454225946"],
 ". We therefore plot the greedy count multiplied by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["d", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "467b5ce6-9144-456c-ab83-5d86c9430bb9"],
 ", again divided by its first value. The graph may be too small to provide a \
broad interval satisfying both inequalities."
}], "Text",
 CellDingbat->None,ExpressionUUID->"87b9069e-1335-4beb-bf65-617ba3b32100"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"data", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"graph", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", 
            " ", 
            RowBox[{"target", " ", "=", " ", 
             RowBox[{"InfraBall", "[", " ", 
              RowBox[{
               RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}], ",", 
               " ", 
               RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}], " ", 
              "]"}]}], ",", "\n", "      ", 
            RowBox[{"radii", " ", "=", " ", 
             RowBox[{"Range", "[", " ", 
              RowBox[{"Floor", "[", " ", 
               RowBox[{
                RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}], " ", "/",
                 " ", "2"}], " ", "]"}], " ", "]"}]}], ",", " ", 
            RowBox[{"dimension", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Reference\>\"", " ", "]"}]}]}], 
           " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"counts", " ", "=", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"r", " ", "|->", " ", 
               RowBox[{"Length", " ", "@", " ", 
                RowBox[{"FindBallCover", "[", " ", 
                 RowBox[{"graph", ",", " ", "r", ",", " ", "target", ",", " ", 
                  RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ",
                  "]"}]}]}], ",", " ", "radii"}], " ", "]"}]}], " ", "}"}], ",",
           "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"profile", " ", "=", " ", 
            RowBox[{"counts", " ", 
             RowBox[{"radii", "^", "dimension"}]}]}], " ", "}"}], ",", "\n", 
          "    ", 
          RowBox[{"ListLinePlot", "[", " ", 
           RowBox[{
            RowBox[{"Transpose", "[", " ", 
             RowBox[{"{", " ", 
              RowBox[{"radii", ",", " ", 
               RowBox[{"profile", " ", "/", " ", 
                RowBox[{"First", "[", " ", "profile", " ", "]"}]}]}], " ", 
              "}"}], " ", "]"}], ",", "\n", "      ", 
            RowBox[{"PlotLabel", " ", "->", " ", 
             RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], ",", " ", 
            RowBox[{"AxesLabel", " ", "->", " ", 
             RowBox[{"{", " ", 
              
              RowBox[{"\"\<r\>\"", ",", 
               " ", "\"\<normalized cover count\>\""}], " ", "}"}]}], ",", 
            "\n", "      ", 
            RowBox[{"GridLines", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"None", ",", " ", 
               RowBox[{"{", " ", "1", " ", "}"}]}], " ", "}"}]}], ",", " ", 
            RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}]}], " ",
          "]"}]}], ",", "\n", "  ", "dimensionSubstrates"}], " ", "]"}], ",", 
     " ", "3"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"90b02acb-3f5a-4fb4-9a19-564d07b648d3"],

