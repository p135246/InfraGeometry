Cell[TextData[{
 "The taxicab-plane calculation explains this filled hull. In the taxicab \
plane, the ball hull of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"-", 
     StyleBox["a", "TI"], 
     RowBox[{",", "0"}]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b77a9282-f89e-4612-8180-2b16e4513624"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], 
     RowBox[{",", "0"}]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e092471e-29e6-4b13-b578-f8f2c8c8e42f"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["x", "TI"], 
    RowBox[{"|", 
     RowBox[{"+", "|"}]}], 
    StyleBox["y", "TI"], 
    RowBox[{"|", "\[LessEqual]"}], 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "650fb630-8713-4bb1-b6c4-6fe44f4b6abd"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{">", "0"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a66dc06a-5741-4b8f-8c60-743075846906"],
 ". For a centre ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "450d046f-36ca-4641-bb51-7084ddf04b03"],
 ", the least enclosing radius is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"+", "\[DoubleVerticalBar]"}], 
    StyleBox["z", "TI"], 
    SubscriptBox["\[DoubleVerticalBar]", "1"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1cabcfdc-f595-4f14-ac3a-3c5d4830aa1a"],
 ", so the triangle inequality places the diamond in every enclosing ball. \
The radius-",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "af778196-aec1-4af8-a8f4-63f73a2780fa"],
 " ball at the origin gives the reverse inclusion. Thus this pair spans an \
area even when volume growth has dimension two."
}], "Text",
 CellDingbat->None,ExpressionUUID->"959d65ed-f598-45df-b28c-2e38e1b4682b"],

