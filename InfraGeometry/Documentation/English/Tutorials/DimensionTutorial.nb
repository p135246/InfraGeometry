Cell["\<\
The same construction on the six substrates uses greedy covers. The covering \
radius is roughly one third of the target radius.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"170b0475-d4e3-48b3-9070-e641994ed7f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"data", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"graph", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", 
            " ", 
            RowBox[{"centre", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", 
            " ", 
            RowBox[{"targetRadius", " ", "=", " ", 
             RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
           "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"radius", " ", "=", " ", 
             RowBox[{"Max", "[", " ", 
              RowBox[{"1", ",", " ", 
               RowBox[{"Floor", "[", " ", 
                RowBox[{"targetRadius", " ", "/", " ", "3"}], " ", "]"}]}], 
              " ", "]"}]}], ",", " ", 
            RowBox[{"target", " ", "=", " ", 
             RowBox[{"InfraBall", "[", " ", 
              RowBox[{"centre", ",", " ", "targetRadius"}], " ", "]"}]}]}], 
           " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"centres", " ", "=", " ", 
            RowBox[{"FindBallCover", "[", " ", 
             RowBox[{
             "graph", ",", " ", "radius", ",", " ", "target", ",", " ", 
              RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
             "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"Labeled", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"Show", "[", " ", 
             RowBox[{"InfraSubstrateHighlight", "[", " ", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"target", " ", "->", " ", "StandardGray"}], ",", " ", 
                 RowBox[{"centres", " ", "->", " ", "StandardGray"}]}], " ", 
                "}"}], ",", "\n", "        ", 
               RowBox[{"Epilog", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"StandardGray", ",", " ", 
                  RowBox[{"AbsoluteThickness", "[", " ", "1.5", " ", "]"}], ",",
                   " ", 
                  RowBox[{"Map", "[", "\n", "          ", 
                   RowBox[{
                    RowBox[{"point", " ", "|->", " ", 
                    RowBox[{"With", "[", "\n", "            ", 
                    RowBox[{
                    RowBox[{"{", " ", 
                    RowBox[{"vertices", " ", "=", " ", 
                    RowBox[{"Keys", " ", "@", " ", 
                    RowBox[{"InfraMeasurement", "[", " ", 
                    RowBox[{"graph", ",", " ", 
                    RowBox[{"InfraBall", "[", " ", 
                    RowBox[{"point", ",", " ", "radius"}], " ", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", 
                    "}"}], ",", "\n", "            ", 
                    RowBox[{"MeshPrimitives", "[", " ", 
                    RowBox[{
                    RowBox[{"ConvexHullMesh", "[", " ", 
                    RowBox[{
                    RowBox[{"GraphEmbedding", "[", " ", "graph", " ", "]"}], "[", 
                    RowBox[{"[", " ", 
                    RowBox[{"Map", "[", " ", 
                    RowBox[{
                    RowBox[{"v", " ", "|->", " ", 
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], ",", " ", 
                    "vertices"}], " ", "]"}], " ", "]"}], "]"}], " ", "]"}], ",",
                     " ", "1"}], " ", "]"}]}], " ", "]"}]}], ",", "\n", 
                    "          ", "centres"}], " ", "]"}]}], " ", "}"}]}], 
               " ", ",", "\n", "        ", 
               RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], 
             " ", "]"}], ",", "\n", "      ", 
            RowBox[{"Row", "[", " ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}], ",", 
               " ", "\"\<: \>\"", ",", " ", 
               RowBox[{"Length", "[", " ", "centres", " ", "]"}], ",", 
               " ", "\"\< balls, radius \>\"", ",", " ", "radius"}], " ", 
              "}"}], " ", "]"}]}], " ", "]"}]}], " ", "]"}]}], ",", "\n", 
       "  ", "dimensionSubstrates"}], " ", "]"}], ",", " ", "3"}], " ", "]"}],
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f7374f16-01c8-4dff-8501-d7bccc93e294"],

