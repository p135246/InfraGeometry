Cell["Covering a region", "Section",ExpressionUUID->"752e3aec-7042-42ca-a44d-f3cde6ed61db"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["N", "TI"], 
     StyleBox["r", "TI"]], "(", 
    StyleBox["T", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0336a515-3571-48c5-9f66-b8121ba5c8a7"],
 " be the least number of closed graph balls of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d06396a2-57db-43cd-a0b7-f3724701e67d"],
 " covering a target ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f26f2430-9a3f-40fb-90d5-c6a68fb43910"],
 ". Their centres may lie outside ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d81fd635-efa3-4aa1-b884-a1a2fc7c396c"],
 ", and shortest paths are measured in the surrounding graph. ",
 ButtonBox["FindBallCover",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/FindBallCover"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/FindBallCover"],
 " minimizes the number of centres by default; ",
 Cell["Method -> \"Greedy\"", "InlineCode",ExpressionUUID->
  "25b217b0-f55c-4be5-a1e7-07a6bcde6d4f"],
 " gives an upper bound. ",
 ButtonBox["BallCoverNumber",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber"],
 " returns the minimum."
}], "Text",
 CellDingbat->None,ExpressionUUID->"0c501017-31d5-4bfa-9141-aaab9d8ae8b7"],

Cell[TextData[{
 "Here an exact cover of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], "4"], "(", 
    StyleBox["c", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0509ca92-6947-4066-a2ff-be1e89b68239"],
 " uses balls of radius two. The target is gray. Unfilled gray contours show \
convex envelopes of the covering balls in the drawing, keeping their overlaps \
visible. The cover is computed from graph balls, not these envelopes."
}], "Text",
 CellDingbat->None,ExpressionUUID->"67d7f09b-1627-4b90-8a3b-2369d800ea50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", " ", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"target", " ", "=", " ", 
      RowBox[{"InfraBall", "[", " ", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}], ",", " ", 
        "4"}], " ", "]"}]}], ",", " ", 
     RowBox[{"radius", " ", "=", " ", "2"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"centres", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", " ", 
      RowBox[{"graph", ",", " ", "radius", ",", " ", "target"}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"graph", ",", " ", 
           RowBox[{"{", " ", 
            RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", "}"}], 
           " ", ",", "\n", "      ", 
           RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
          " ", "\"\<target\>\""}], " ", "]"}], ",", "\n", "    ", 
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"Show", "[", " ", 
          RowBox[{"InfraSubstrateHighlight", "[", " ", 
           RowBox[{"graph", ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"target", " ", "->", " ", "StandardGray"}], ",", " ", 
              RowBox[{"centres", " ", "->", " ", "StandardGray"}]}], " ", 
             "}"}], ",", "\n", "      ", 
            RowBox[{"Epilog", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"StandardGray", ",", " ", 
               RowBox[{"AbsoluteThickness", "[", " ", "1.5", " ", "]"}], ",", 
               " ", 
               RowBox[{"Map", "[", "\n", "        ", 
                RowBox[{
                 RowBox[{"point", " ", "|->", " ", 
                  RowBox[{"With", "[", "\n", "          ", 
                   RowBox[{
                    RowBox[{"{", " ", 
                    RowBox[{"vertices", " ", "=", " ", 
                    RowBox[{"Keys", " ", "@", " ", 
                    RowBox[{"InfraMeasurement", "[", " ", 
                    RowBox[{"graph", ",", " ", 
                    RowBox[{"InfraBall", "[", " ", 
                    RowBox[{"point", ",", " ", "radius"}], " ", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", 
                    "}"}], ",", "\n", "          ", 
                    RowBox[{"MeshPrimitives", "[", " ", 
                    RowBox[{
                    RowBox[{"ConvexHullMesh", "[", " ", 
                    RowBox[{
                    RowBox[{"GraphEmbedding", "[", " ", "graph", " ", "]"}], "[", 
                    RowBox[{"[", " ", 
                    RowBox[{"Map", "[", " ", 
                    RowBox[{
                    RowBox[{"v", " ", "|->", " ", 
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], ",", " ", 
                    "vertices"}], " ", "]"}], " ", "]"}], "]"}], " ", "]"}], ",",
                     " ", "1"}], " ", "]"}]}], " ", "]"}]}], ",", "\n", 
                 "        ", "centres"}], " ", "]"}]}], " ", "}"}]}], " ", ",",
             "\n", "      ", 
            RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], 
          " ", "]"}], ",", " ", "\"\<minimum radius-two cover\>\""}], " ", 
        "]"}]}], " ", "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a59b4ccf-7f90-4e9f-9b8a-7e95caad62d9"],

