Cell["Measuring straightness", "Section",ExpressionUUID->"31544863-d299-49f8-aa03-41937a6ff36b"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eta]", "\[LongEqual]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "0"], 
      RowBox[{",", "\[Ellipsis]", ","}], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["m", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b5fe4429-93f0-4d93-b834-a8ea52bc344c"],
 " be the extension after removing the incoming germ, while retaining their \
common vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "0"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fdbf96e5-dfaa-4970-97d5-54bc4f27eee2"],
 ". Its normalized excess is"
}], "Text",
 CellDingbat->None,ExpressionUUID->"153cf0a0-a908-4d69-818a-4f9562e10cdf"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    RowBox[{
     RowBox[{"(", "\[Eta]", ")"}], "\[LongEqual]"}], 
    FractionBox[
     RowBox[{
      StyleBox["m", "TI"], "-", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "0"], ",", 
        SubscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["m", "TI"]]}], ")"}]}], 
     StyleBox["m", "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"28f9f916-1ed2-4a5b-a5f6-b6fc240d6471"],
 "  "
}], "DisplayFormula",ExpressionUUID->"cd7117e2-4282-4a9e-a001-4621d5ac156f"],

Cell[TextData[{
 "This is zero exactly when the extension is a shortest path. For the \
unit-edge planar embedding ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ee38973-ec92-4d4f-be68-23d1af494645"],
 ", also measure"
}], "Text",
 CellDingbat->None,ExpressionUUID->"05e6d9c4-f497-4565-ad1a-3cf0e7f65631"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{
     RowBox[{"(", "\[Eta]", ")"}], "\[LongEqual]"}], 
    FractionBox["1", 
     StyleBox["m", "TI"]], 
    UnderscriptBox["max", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    StyleBox[
     RowBox[{"d", "i", "s", "t"}], "TI"], 
    RowBox[{"(", 
     RowBox[{"\[CurlyPhi]", 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["i", "TI"]], ")"}], ",", 
      RowBox[{"[", 
       RowBox[{"\[CurlyPhi]", 
        RowBox[{"(", 
         SubscriptBox[
          StyleBox["x", "TI"], "0"], ")"}], 
        RowBox[{",", "\[CurlyPhi]"}], 
        RowBox[{"(", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["m", "TI"]], ")"}]}], "]"}]}], ")"}], "."}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "35c07b1e-6ff2-44da-8c67-65db9042afc9"],
 "  "
}], "DisplayFormula",ExpressionUUID->"c41f48af-3935-422e-acad-705b73841455"],

Cell[TextData[{
 "This second quantity measures deviation from a Euclidean chord. A graph \
shortest path may still be a staircase with positive chord deviation. \
Returning to the three lattices, the next pictures isolate the selected \
extensions at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "6"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"37fde4ff-7d18-4a09-a657-53f0da75524c"],
 ". The incoming germ is blue, the extensions red and their Euclidean chords \
dashed orange. The staircase shape remains visible even when the graph excess \
is zero."
}], "Text",
 CellDingbat->None,ExpressionUUID->"de00b930-c5b2-4885-9600-da10e175b732"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"Graph", "[", " ", 
          RowBox[{
           RowBox[{"TessellationNeighborhoodGraph", "[", " ", 
            RowBox[{"configuration", ",", " ", "14"}], " ", "]"}], ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{
            "InfraSubstrateStyle", "[", " ", "\"\<Large\>\"", " ", "]"}]}]}], 
          " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"centre", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", "\n", 
         "        ", 
         RowBox[{"coordinates", " ", "=", " ", 
          RowBox[{"AssociationThread", "[", " ", 
           RowBox[{
            RowBox[{"VertexList", "[", " ", "g", " ", "]"}], ",", " ", 
            RowBox[{"GraphEmbedding", "[", " ", "g", " ", "]"}]}], " ", 
           "]"}]}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"start", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", " ", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", " ", 
              RowBox[{"centre", ",", " ", "8"}], " ", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
        "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"germ", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"RandomInfraSegment", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", " ", 
             RowBox[{"start", ",", " ", "centre"}], " ", "]"}], ",", " ", "1",
             ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"walks", " ", "=", " ", 
         RowBox[{"RandomInfraGeodesic", "[", " ", 
          RowBox[{"g", ",", " ", "germ", ",", " ", "6", ",", " ", 
           RowBox[{"{", " ", "10", " ", "}"}], ",", " ", "All"}], " ", 
          "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"selected", " ", "=", " ", 
         RowBox[{"SelectInfraWalk", "[", " ", 
          RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
           RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MostVisited\>\""}]}], 
          " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"extensions", " ", "=", " ", 
         RowBox[{"Map", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"walk", " ", "|->", " ", 
            RowBox[{"Drop", "[", " ", 
             RowBox[{
              RowBox[{"Last", " ", "/@", " ", 
               RowBox[{"SortBy", "[", " ", 
                RowBox[{
                 RowBox[{"VertexList", "[", " ", "walk", " ", "]"}], ",", " ",
                  "First"}], " ", "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", " ", "germ", " ", "]"}], " ", "-", " ", 
               "1"}]}], " ", "]"}]}], ",", " ", "selected"}], " ", "]"}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"InfraSubstrateHighlight", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"selected", " ", "->", " ", "StandardRed"}], ",", " ", 
           RowBox[{
            RowBox[{"InfraWalk", "[", " ", "germ", " ", "]"}], " ", "->", " ",
             "StandardBlue"}]}], " ", "}"}], ",", "\n", "        ", 
         RowBox[{"Epilog", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{
           "StandardOrange", ",", " ", "Dashed", ",", "\n", "          ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"path", " ", "|->", " ", 
               RowBox[{"Line", "[", " ", 
                RowBox[{"Lookup", "[", " ", 
                 RowBox[{"coordinates", ",", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{
                    RowBox[{"First", "[", " ", "path", " ", "]"}], ",", " ", 
                    RowBox[{"Last", "[", " ", "path", " ", "]"}]}], " ", 
                   "}"}]}], " ", "]"}], " ", "]"}]}], ",", " ", 
              "extensions"}], " ", "]"}]}], " ", "}"}]}], " ", ",", "\n", 
         "        ", 
         RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], " ",
       "]"}], ",", "\n", "    ", 
     RowBox[{"{", " ", 
      RowBox[{"configuration", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"3", ",", " ", "6", ",", " ", "3", ",", " ", "6"}], " ", 
          "}"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"4", ",", " ", "8", ",", " ", "8"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"3", ",", " ", "4", ",", " ", "6", ",", " ", "4"}], " ", 
          "}"}]}], " ", "}"}]}], " ", "}"}]}], " ", "]"}], ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"87c08bf7-6400-48ca-9a49-66e12c4ab85d"],

