Notebook[{

Cell[CellGroupData[{
Cell["Straightening at a Scale", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Can straightness over a local horizon produce a globally shortest extension? \
We fix an incoming path, extend it by ten steps, and increase the horizon \
used to test each continuation. The resulting beam can change from walks that \
curl back toward the starting region to shortest paths that leave it.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"396c3b87-97ea-423d-ba29-05b140893fcd"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c4f78fb4-0ffd-4858-a13d-d2b792b5060d"],

Cell["A beam at a scale", "Section",ExpressionUUID->"11d2f585-5c45-4dc3-9e07-53a9e53c8c6a"],

Cell[TextData[{
 "A walk is ",
 StyleBox["geodesic at infra-scale",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5173db1b-0ef6-4dcc-afe6-bb74854d8714"],
 " if each subwalk of at most ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c39e4941-6370-436f-a595-e1595a5eabd5"],
 " edges is a shortest path between its ends. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "\[Infinity]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d0942109-3203-4543-bd18-714d1db4a350"],
 ", the whole walk must be shortest. A ",
 StyleBox["germ",
  FontWeight->Bold],
 " is the initial shortest path; here it has eight edges and ends at the \
graph centre. The ",
 StyleBox["beam",
  FontWeight->Bold],
 " consists of its ten-step extensions that satisfy the scale-",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf9fa199-82fb-4f4f-a146-cdb43a8c0f3b"],
 " condition."
}], "Text",
 CellDingbat->None,ExpressionUUID->"2e34288e-7c2d-473a-8cae-b0b111685c83"],

Cell[TextData[{
 ButtonBox["SelectInfraWalk",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk"],
 " with ",
 Cell["\"From\" -> \"MostVisited\"", "InlineCode",ExpressionUUID->
  "de5c48be-4af7-43de-9ae1-0291f95d3caf"],
 " chooses the members with the largest total occupation count along their \
vertices and edges. Counts include repeated visits, so this selection can \
favour a walk that returns to a busy region. We keep all ties."
}], "Text",
 CellDingbat->None,ExpressionUUID->"bb5e536a-11b7-495f-ab3e-173458020c82"],

Cell[TextData[{
 "The rows below are the trihexagonal, truncated square and \
rhombitrihexagonal tilings. The columns use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{
     RowBox[{"\[LongEqual]", "3"}], ",", "4", ",", "6"}]}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"ed67388f-96b8-4721-836b-a33f67639c2e"],
 ", so each row shows the change as the horizon grows. The beam is orange and \
the selected members are red; the incoming germ is drawn last. All \
shortest-path and occupation calculations use graph distances."
}], "Text",
 CellDingbat->None,ExpressionUUID->"0129faff-3b50-423e-ac97-3f0ba586786a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"Graph", "[", " ", 
          RowBox[{
           RowBox[{"TessellationNeighborhoodGraph", "[", " ", 
            RowBox[{"configuration", ",", " ", "14"}], " ", "]"}], ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{
            "InfraSubstrateStyle", "[", " ", "\"\<Large\>\"", " ", "]"}]}]}], 
          " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"centre", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], " ", "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"start", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", " ", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", " ", 
              RowBox[{"centre", ",", " ", "8"}], " ", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"germ", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"RandomInfraSegment", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", " ", 
             RowBox[{"start", ",", " ", "centre"}], " ", "]"}], ",", " ", "1",
             ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"walks", " ", "=", " ", 
         RowBox[{"RandomInfraGeodesic", "[", " ", 
          RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
           RowBox[{"{", " ", "10", " ", "}"}], ",", " ", "All"}], " ", 
          "]"}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"Labeled", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "\n", "        ", 
            RowBox[{
             RowBox[{"walks", " ", "->", " ", "StandardOrange"}], ",", "\n", 
             "        ", 
             RowBox[{
              RowBox[{"SelectInfraWalk", "[", " ", 
               RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
                
                RowBox[{"\"\<From\>\"", " ", "->", 
                 " ", "\"\<MostVisited\>\""}]}], " ", "]"}], " ", "->", " ", 
              "StandardRed"}], ",", "\n", "        ", 
             RowBox[{
              RowBox[{"InfraWalk", "[", " ", "germ", " ", "]"}], " ", "->", 
              " ", "StandardOrange"}]}], " ", "}"}], ",", " ", 
           RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{"1.25", ",", " ", "3.75"}], " ", "}"}]}]}], " ", "]"}], ",",
          "\n", "      ", 
         RowBox[{"Row", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
           "configuration", ",", " ", "\"\<, r = \>\"", ",", " ", "r"}], " ", 
           "}"}], " ", "]"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"configuration", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"3", ",", " ", "6", ",", " ", "3", ",", " ", "6"}], " ", 
          "}"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"4", ",", " ", "8", ",", " ", "8"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"3", ",", " ", "4", ",", " ", "6", ",", " ", "4"}], " ", 
          "}"}]}], " ", "}"}]}], " ", "}"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"r", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"3", ",", " ", "4", ",", " ", "6"}], " ", "}"}]}], " ", 
      "}"}]}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0a4cade2-ec77-4628-8a51-2cb6741178bd"],

