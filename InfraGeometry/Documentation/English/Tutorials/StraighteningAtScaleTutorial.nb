Cell["\<\
Consequently, local straightness alone cannot guarantee global straightness \
on arbitrary graphs. The lattice experiments test whether the \
occupation-based selection suppresses these returns before the horizon itself \
excludes them.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"d041a355-27e8-4122-922a-b72eec889b7c"],

Cell["The same rule on meshes", "Section",ExpressionUUID->"febbdc27-2ffb-410f-a6ba-006f338024c5"],

Cell[TextData[{
 "The rows below are large square, cube and sphere meshes; the columns use \
horizons ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{
     RowBox[{"\[LongEqual]", "2"}], ",", "4", ",", "6"}]}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"47db244f-77ef-444d-b8a9-078f8b80b81d"],
 ". Each panel starts from a six-edge germ and samples 128 continuations of \
at most eight further steps. Each step chooses an admissible neighbour \
uniformly. The sample is orange, its most visited members red, and the \
incoming germ blue. Selection here is relative to this finite sample. The \
points and walks are chosen entirely from graph distances; the layouts are \
illustrations."
}], "Text",
 CellDingbat->None,ExpressionUUID->"d13801e3-21b6-4dfa-ad2b-237e7b9dc490"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"BlockRandom", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrate", "[", " ", 
            RowBox[{
             RowBox[{"specification", "[", 
              RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", 
             " ", "\"\<Large\>\""}], " ", "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"centre", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], " ", "}"}], ",",
        "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"start", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", " ", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", " ", 
              RowBox[{"centre", ",", " ", "6"}], " ", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
        "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"germ", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"RandomInfraSegment", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", " ", 
             RowBox[{"start", ",", " ", "centre"}], " ", "]"}], ",", " ", "1",
             ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"walks", " ", "=", " ", 
         RowBox[{"RandomInfraGeodesic", "[", " ", 
