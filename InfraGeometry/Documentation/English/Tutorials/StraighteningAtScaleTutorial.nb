                   RowBox[{"True", ",", "True", ",", "True"}], "}"}]}], ",", 
               RowBox[{"LabelStyle", "\[Rule]", 
                 RowBox[{"{", "}"}]}], ",", 
               RowBox[{"LegendLayout", "\[Rule]", "\"Column\""}]}], "]"}]& ), 
          Editable -> True], TraditionalForm], TraditionalForm]},
      "Legended",
      DisplayFunction->(FormBox[
        GridBox[{{
           TagBox[
            ItemBox[
             PaneBox[
              TagBox[#, "SkipImageSizeLevel"], 
              Alignment -> {Center, Baseline}, BaselinePosition -> Baseline], 
             DefaultBaseStyle -> "Labeled"], "SkipImageSizeLevel"], 
           ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}}, 
         GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
         AutoDelete -> False, GridBoxItemSize -> Automatic, 
         BaselinePosition -> {1, 1}], TraditionalForm]& ),
      Editable->True,
      InterpretationFunction->(FormBox[
        RowBox[{"Legended", "(", 
          RowBox[{#, ",", 
            RowBox[{"Placed", "[", 
              RowBox[{#2, ",", "After"}], "]"}]}], ")"}], 
        TraditionalForm]& )], {488., -72.66666666666667}, {Center, Center}, {305., 125.00000000000001},
     
     BaseStyle->{Graphics3DBoxOptions -> {SphericalRegion -> False}}]}, {}},
  ImageSize->1000,
  Method->{"IgnoreImageSizeAutomaticLimit" -> True},
  PlotRange->{{0, 650.6666666666666}, {-145.33333333333334`, 0}},
  PlotRangePadding->Automatic]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"bead043f-e947-4740-9cb2-297aa9382765"]
}, Open  ]],

Cell[TextData[{
 "In this finite sweep, the excess first vanishes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "4"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"38651c45-48c1-479b-b423-abd5025de2d1"],
 " on the trihexagonal tiling, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "6"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9d61dd15-c1d5-4eae-af10-63a2394cc53e"],
 " on the truncated square tiling and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "5"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1bbb2032-7549-458f-9897-19b54a6ae33e"],
 " on the rhombitrihexagonal tiling, and remains zero through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[LongEqual]", "10"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b4d87f15-5a9e-4afc-b0e9-a5176cc824ca"],
 ". A zero excess means every selected extension is shortest; it says nothing \
by itself about continuing the germ's Euclidean direction. Once ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[GreaterEqual]", 
    StyleBox["m", "TI"], 
    RowBox[{"\[LongEqual]", "10"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"39bb16a6-bc43-49e1-8eb3-88d7b66e4e60"],
 ", every admissible extension must be shortest because the horizon contains \
that whole extension. Straightening at a smaller ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b5d90c14-58b8-4021-8aa9-8d6ac22a2b9e"],
 " therefore measures the effect of selecting the most visited members before \
the local constraint forces it."
}], "Text",
 CellDingbat->None,ExpressionUUID->"ea4ea419-6fdf-4b8f-8d52-816f49f213bb"],

Cell["Comparing resolutions", "Section",ExpressionUUID->"609eed96-02f9-425e-b0e8-3bc4f9ce56a2"],

Cell[TextData[{
 "This experiment changes the observation horizon on a fixed substrate and a \
fixed extension length. A comparison across resolutions would instead grow \
the germ length, extension length ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "db5216a2-bbcd-4c33-9d8d-093b74b72d00"],
 " and horizon ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2b690630-c441-4e9c-b69a-87abd4cf345d"],
 " together, keeping their ratios fixed. Lengths in the pictures would be \
divided by ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7c42af34-f8aa-4b02-a9c8-133ab0d07a26"],
 ", while ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8f2a10a5-418f-4ba7-828f-3fdd716db14a"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "956e99f2-20a8-4207-8b38-9f823ec0da74"],
 " already have no units. Scale consistency would mean that these normalized \
readouts approach stable functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "/", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9b81d240-6087-49dc-9726-601dd3636949"],
 ". The present finite sweep does not establish that limit."
}], "Text",
 CellDingbat->None,ExpressionUUID->"867f5f0a-cec6-4032-97bd-f614092dbe51"],

Cell[TextData[{
 "Two questions remain. At fixed ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec9dae31-b7c8-41fb-801b-597e7e383672"],
 ", do the selected extensions approach rays as their allowed length grows, \
and how does this depend on the germ? On meshes without the same preferred \
lattice directions, does the selected continuation recover the germ's \
direction at large scales? For concentration of the whole path family under a \
specified rescaling, see ",
 ButtonBox["The Breathless Line",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/tutorial/\
BreathlessLineTutorial"], None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/tutorial/BreathlessLineTutorial"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5e75628a-20f5-41d9-831a-06c1d3411a9f"],

