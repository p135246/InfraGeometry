Cell[TextData[{
 "A small horizon permits a return around a face whose shorter subwalks are \
still shortest. Increasing ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "293e336a-217e-4b9a-97fc-dbc573b0f8a5"],
 " removes such returns from the beam. The sets of admissible walks shrink, \
but their most visited members need not vary monotonically: the occupation \
counts change with the beam."
}], "Text",
 CellDingbat->None,ExpressionUUID->"8fabe426-4d11-4a12-91a2-f7ac66eeab18"],

Cell["A local rule can miss a complete turn", "Section",ExpressionUUID->"55dadc00-aa67-46d2-9cba-bd28946e8fe8"],

Cell[TextData[{
 "On the cycle graph ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["q", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a3d71fe-f079-4637-a9cb-d1bdae5c7197"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], 
    RowBox[{"\[GreaterEqual]", "3"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fff90387-6024-4156-9de0-e2cdd641e8ea"],
 ", follow the edges repeatedly in one direction. A subwalk of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LessEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "925154c4-c15f-4f97-8b28-11ca4983d9d4"],
 " edges has endpoint distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"min", "("}], 
    RowBox[{
     StyleBox["k", "TI"], ",", 
     StyleBox["q", "TI"], "-", 
     StyleBox["k", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6313622e-9271-4ee4-ad6a-1dd19522aa42"],
 ". It is shortest precisely when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LessEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["q", "TI"], 
      RowBox[{"/", "2"}]}], "\[RightFloor]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f9bd2a9d-089c-484d-9f05-ffe8910c2402"],
 ". Thus arbitrarily many complete turns satisfy every horizon ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LessEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["q", "TI"], 
      RowBox[{"/", "2"}]}], "\[RightFloor]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0575fce4-8c83-4451-b2b9-b2c403c52f8c"],
 ", although each complete turn returns to its starting vertex. A horizon of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["q", "TI"], 
      RowBox[{"/", "2"}]}], "\[RightFloor]"}], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "710de9c0-f567-4976-a27e-6b243d942b07"],
 " detects a shortcut as soon as that many edges have been traversed."
}], "Text",
 CellDingbat->None,ExpressionUUID->"9a57bdc5-9060-4bdf-b6e4-ceeff3485d5f"],

Cell["\<\
The two panels use the same twelve-cycle in its native layout. At horizon \
six, the orange half-cycle and its blue complement have equal length. At \
horizon seven, the seven orange edges have a five-edge blue shortcut. This \
exact obstruction depends on the length of a cycle, not its apparent \
roundness in the drawing.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"0cc40586-fd69-43de-b96c-fa9c3b419c7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CycleGraph", "[", " ", 
          RowBox[{"12", ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{
            "InfraSubstrateStyle", "[", " ", "\"\<Medium\>\"", " ", "]"}]}]}],
           " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"forward", " ", "=", " ", 
          RowBox[{"Range", "[", " ", 
           RowBox[{"r", " ", "+", " ", "1"}], " ", "]"}]}], ",", " ", 
         RowBox[{"complement", " ", "=", " ", 
          RowBox[{"Join", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", "1", " ", "}"}], ",", " ", 
            RowBox[{"Range", "[", " ", 
             RowBox[{"12", ",", " ", 
              RowBox[{"r", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"-", "1"}]}], " ", "]"}]}], " ", "]"}]}]}], " ", "}"}], 
       ",", "\n", "      ", 
       RowBox[{"Labeled", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "\n", "          ", 
            RowBox[{
             RowBox[{
              RowBox[{"InfraWalk", "[", " ", "forward", " ", "]"}], " ", "->",
               " ", "StandardOrange"}], ",", "\n", "          ", 
             RowBox[{
              RowBox[{"InfraWalk", "[", " ", "complement", " ", "]"}], " ", "->",
               " ", "StandardBlue"}], ",", " ", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{"1", ",", " ", 
                RowBox[{"r", " ", "+", " ", "1"}]}], " ", "}"}], " ", "->", 
              " ", "StandardRed"}]}], " ", "}"}], ",", "\n", "          ", 
           RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{"2", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",", 
         "\n", "        ", 
         RowBox[{"Row", "[", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<r = \>\"", ",", " ", "r", ",", " ", "\"\<: \>\"", ",",
             " ", "r", ",", " ", "\"\< edges versus \>\"", ",", " ", 
            RowBox[{"12", " ", "-", " ", "r"}]}], " ", "}"}], " ", "]"}]}], 
        " ", "]"}]}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"{", " ", 
      RowBox[{"r", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"6", ",", " ", "7"}], " ", "}"}]}], " ", "}"}]}], " ", "]"}], 
   ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "900"}]}], " ", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9e32dd97-5f71-4bfb-af4c-cf0cf95e43f2"],

