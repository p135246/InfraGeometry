Cell[TextData[{
 "For generated examples, ",
 ButtonBox["RandomInfraFiberedGraph",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph"],
 " accepts explicit properties such as ",
 Cell["Properties -> { \"FiberBundle\" }", "InlineCode",ExpressionUUID->
  "36d98b6a-cb30-4007-983e-3acbd0f5f88b"],
 ". Its reference page gives the size and edge-count options."
}], "Text",
 CellDingbat->None,ExpressionUUID->"6ac2174a-a9fd-44d5-bb86-63a0adfb61ad"],

Cell["Connections and sections", "Section",ExpressionUUID->"4a800889-38ea-4236-b551-8614d0963350"],

Cell[TextData[{
 "A ",
 StyleBox["complete connection",
  FontSlant->Italic],
 " selects a perfect matching above every base edge, using transverse edges \
of the total graph. These matchings transport fiber vertices bijectively. ",
 ButtonBox["InfraHorizontalLift",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift"], 
    None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift"],
 " composes them along a base walk from a chosen starting vertex, and ",
 ButtonBox["InfraParallelTransport",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport"],
 " records all resulting endpoints. Preserving the vertical fiber graph is an \
additional requirement on the matchings. If the fibers are isomorphic and the \
matchings preserve adjacency, the vertical and selected transverse edges form \
a graph bundle."
}], "Text",
 CellDingbat->None,ExpressionUUID->"06321bf5-e70d-495e-b0fa-603ffc48d8e3"],

Cell[TextData[{
 "Weak lifting does not ensure that such a connection exists. For two \
three-point fibers, take transverse edges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "1"], 
    SubscriptBox[
     StyleBox["y", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["x", "TI"], "2"], 
    SubscriptBox[
     StyleBox["y", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["x", "TI"], "3"], 
    SubscriptBox[
     StyleBox["y", "TI"], "2"], ",", 
    SubscriptBox[
     StyleBox["x", "TI"], "3"], 
    SubscriptBox[
     StyleBox["y", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a46226fa-88dd-475b-b1a3-44858aeb4193"],
 ". Every endpoint has a neighbour, but ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"01b6eeaa-dca5-4a57-950b-81224c55f4e9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf8f1738-1fdd-4232-8ee7-9c90427724e4"],
 " cannot both receive distinct partners. The left picture marks these two \
states in blue and their only possible partner in orange. On the right, \
adding the edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "2"], 
    SubscriptBox[
     StyleBox["y", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"15d0f465-4d1b-4061-ab83-0eb877f63067"],
 " allows a complete matching, drawn in blue. The other available edges \
remain gray."
}], "Text",
 CellDingbat->None,ExpressionUUID->"ea6add50-8f78-4fc8-94d7-2f3c43c648aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"edges", " ", "=", " ", 
      RowBox[{"UndirectedEdge", " ", "@@@", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "4"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"2", ",", " ", "4"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", 
