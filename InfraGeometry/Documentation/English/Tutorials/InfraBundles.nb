Cell[TextData[{
 ButtonBox["InfraEdgeLiftMultiplicity",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity"]\
, None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity"],
 " records these counts, including zeros. Vertical neighbours do not enter \
the count."
}], "Text",
 CellDingbat->None,ExpressionUUID->"ff120ba0-43f7-47f2-87ff-7858adc6a10c"],

Cell[TextData[{
 "Positive multiplicities give weak edge lifting, tested by ",
 ButtonBox["InfraFibrationQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ"],
 ". Multiplicities at most one give ",
 ButtonBox["InfraAtMostOneEdgeLiftQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ"],
 ", and multiplicities exactly one give ",
 ButtonBox["InfraUniqueEdgeLiftingQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ"],
 ". A covering has unique lifts and edgeless fibers. A graph bundle has \
isomorphic fibers and unique lifts that preserve vertical adjacency."
}], "Text",
 CellDingbat->None,ExpressionUUID->"fee267ef-5fae-4f95-9530-5155ea9bef19"],

Cell["\<\
Unique lifting makes the edges above each base edge a perfect matching. Every \
vertex on either side has exactly one partner, so fiber sizes match along the \
edge and hence throughout each connected base component. A covering over a \
connected base is therefore a bundle with a discrete fiber. Different base \
components may have different sheet counts.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"9315f4fe-c5b9-4919-ac7b-aaf89dbeafd9"],

Cell["\<\
Constancy of the multiplicities within each fiber is transverse equitability. \
Full equitability also requires constant vertical degree within each fiber.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"44c131aa-8552-4c16-b037-f1bb56d589a5"],

Cell["\<\
The three pictures have the same two six-point fibers. On the left, one point \
in each fiber has no lift. In the middle, every point has several possible \
lifts. On the right, the transverse edges form a perfect matching. Equal \
fiber sizes alone do not distinguish these cases.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"c4e73750-435e-4e14-8af7-3a4b4ae45202"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"matching", " ", "=", " ", 
      RowBox[{"UndirectedEdge", " ", "@@@", " ", 
       RowBox[{"Transpose", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"Range", "[", " ", "6", " ", "]"}], ",", " ", 
          RowBox[{"Range", "[", " ", 
           RowBox[{"7", ",", " ", "12"}], " ", "]"}]}], " ", "}"}], " ", 
        "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"complete", " ", "=", " ", 
      RowBox[{"UndirectedEdge", " ", "@@@", " ", 
       RowBox[{"Tuples", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"Range", "[", " ", "6", " ", "]"}], ",", " ", 
          RowBox[{"Range", "[", " ", 
           RowBox[{"7", ",", " ", "12"}], " ", "]"}]}], " ", "}"}], " ", 
        "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"coordinates", " ", "=", " ", 
      RowBox[{"Join", "[", " ", 
       RowBox[{
        RowBox[{"Table", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"0", ",", " ", "index"}], " ", "}"}], ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{"index", ",", " ", "6"}], " ", "}"}]}], " ", "]"}], ",", 
        " ", 
        RowBox[{"Table", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"2", ",", " ", "index"}], " ", "}"}], ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{"index", ",", " ", "6"}], " ", "}"}]}], " ", "]"}]}], " ", 
       "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"edges", " ", "|->", " ", 
        RowBox[{"InfraFiberedGraphHighlight", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"InfraFiberedGraph", "[", " ", 
           RowBox[{
            RowBox[{"Graph", "[", " ", 
             RowBox[{
              RowBox[{"Range", "[", " ", "12", " ", "]"}], ",", " ", 
              "edges"}], " ", "]"}], ",", " ", 
            RowBox[{"vertex", " ", "|->", " ", 
             RowBox[{"Ceiling", "[", " ", 
              RowBox[{"vertex", " ", "/", " ", "6"}], " ", "]"}]}]}], " ", 
           "]"}], ",", "\n", "    ", 
          RowBox[{"Method", " ", "->", " ", "\"\<HighlightFiber\>\""}], ",", 
          " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}], ",", 
          " ", 
          RowBox[{"VertexLabels", " ", "->", " ", "None"}], " ", ",", "\n", 
          "    ", 
          RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Most", "[", " ", "matching", " ", "]"}], ",", " ", 
         "complete", ",", " ", "matching"}], " ", "}"}]}], " ", "]"}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"07ce9871-85de-404b-9da4-c056812e474b"],

