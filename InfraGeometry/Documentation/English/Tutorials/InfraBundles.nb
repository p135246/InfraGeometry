Cell["When does the projection give a bundle?", "Section",ExpressionUUID->"2fb778dd-11ee-4643-b2a4-44eab2da5709"],

Cell[TextData[{
 "For a total vertex ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "19e0af06-fd55-4bc6-9732-dd03fa8a840c"],
 " above ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bd5bf14b-98f5-40ee-a05d-057a50e66701"],
 " and a base neighbour ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "153f905e-dbbb-475a-beaa-49bd8fdd60c8"],
 ", the ",
 StyleBox["edge-lift multiplicity",
  FontSlant->Italic],
 " is"
}], "Text",
 CellDingbat->None,ExpressionUUID->"17e2b7ab-67d2-4fe7-8950-814d0a6e1fd1"],

