Cell[TextData[{
 "At every resolution the blue walk joins the two orange states in the \
starting fiber. The twist survives blocking. This follows from an exact rule, \
beyond these three illustrations. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "|", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e42c430d-35fd-4440-a24c-7fd96ba76360"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", 
    StyleBox["b", "TI"], 
    RowBox[{"\[GreaterEqual]", "3"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e53efa3b-623b-45e2-8dc9-cddf7d0715b8"],
 ", write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["n", "TI"]], ":", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{"2", 
      StyleBox["n", "TI"]}]], "\[Rule]", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c65557b7-8e1d-4c88-a5bb-20c70be79444"],
 " for reduction of vertex labels modulo ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f3c8c852-b047-4959-aac0-992173f71a24"],
 ", using labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", ",", "\[Ellipsis]", ","}], 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99dc8222-9c26-492a-b0ca-79961d2f7f87"],
 ". The block maps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["b", "TI"]], 
    RowBox[{"(", 
     StyleBox["v", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"\[LeftCeiling]", 
     RowBox[{
      StyleBox["v", "TI"], "/", 
      StyleBox["b", "TI"]}], "\[RightCeiling]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"77718bfb-a89b-4ff0-8d9b-eece544b61fb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", 
     StyleBox["b", "TI"]], 
    RowBox[{"(", 
     StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"\[LeftCeiling]", 
     RowBox[{
      StyleBox["p", "TI"], "/", 
      StyleBox["b", "TI"]}], "\[RightCeiling]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a80b13e1-69fe-41bb-b62e-11f1b295b687"],
 " satisfy"
}], "Text",
 CellDingbat->None,ExpressionUUID->"27408c45-89c7-4c46-81f4-ea1b3c1f3f2c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     RowBox[{
      StyleBox["n", "TI"], "/", 
      StyleBox["b", "TI"]}]], "\[EmptySmallCircle]", 
    SubscriptBox["\[Alpha]", 
     StyleBox["b", "TI"]], "\[LongEqual]", 
    SubscriptBox["\[Beta]", 
     StyleBox["b", "TI"]], "\[EmptySmallCircle]", 
    SubscriptBox["\[Pi]", 
     StyleBox["n", "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"55ba99d7-2a42-413c-bec6-a5f90874b6e7"],
 "  "
}], "DisplayFormula",ExpressionUUID->"3b0da7af-9243-4a07-a7a2-8b7461f62812"],

Cell[TextData[{
 "Edges within a block collapse, and edges between successive blocks form the \
smaller cycles. A circuit of the smaller base still lifts through half its \
total cycle and exchanges the two states. Assigning each coarse edge ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "52a9991a-0ff1-4e6a-afb8-e8bbc3f2f928"],
 " times the original length also keeps the base circumference fixed. Thus \
this family has an explicit renormalization rule preserving covering degree \
and monodromy."
}], "Text",
 CellDingbat->None,ExpressionUUID->"0f3862cc-92a5-4d27-8563-65ea94f511be"],

Cell["Scope and further examples", "Section",ExpressionUUID->"427e0b4f-c227-43ad-8e3a-006657477996"],

Cell[TextData[{
 "The bundle predicate uses the Cartesian graph-bundle convention: above a \
base edge the graph is the Cartesian product of that edge with the common \
fiber. This permits global twisting; see ",
 ButtonBox["Algorithm for recognizing Cartesian graph bundles, Section 2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.sciencedirect.com/science/article/pii/S0166218X01002967"]\
, None},
  ButtonNote->
   "https://www.sciencedirect.com/science/article/pii/S0166218X01002967"],
 ". Topological bundles require local product charts, while the weak \
fibration predicate here asks only for edge lifts; see ",
 ButtonBox["Hatcher, Algebraic Topology, Section 4.2, pp. 376\[Dash]377",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"], None},
  ButtonNote->"https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"],
 ". Curvature requires a specified family of faces or loops in addition to \
the graph."
}], "Text",
 CellDingbat->None,ExpressionUUID->"64471e7c-845d-49fc-905d-358ecbfbd7b6"],

Cell[TextData[{
 ButtonBox["Experimental Infra Bundles",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/tutorial/\
ExperimentalInfraBundles"], None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/tutorial/ExperimentalInfraBundles"],\

 " constructs direction fibers from geodesic rays and tests their emergence \
across observation scales. The exact blocking rule above concerns this cycle \
family; other observation rules need their own compatibility checks."
}], "Text",
 CellDingbat->None,ExpressionUUID->"ee4b0da4-7de2-4a6c-bfa0-b330537c97c9"],

Cell["\<\
The original tutorial credits the broad object and separate predicates to the \
April 2026 Meeting 1 notes of Pavel Hajek, Ioana Milea and Stephen Wolfram, \
unpublished. It credits fiber automorphisms and permutation holonomy to Ioana \
Milea's one-page Fibered Graph Gauge Theory Basics.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"6d907d07-046b-464e-a1c4-e6d3647eb1b8"],

