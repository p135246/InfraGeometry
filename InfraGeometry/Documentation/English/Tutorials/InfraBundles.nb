Cell["Twisting and holonomy", "Section",ExpressionUUID->"8f515e9e-e600-409a-a8a8-6512cf7d0f32"],

Cell[TextData[{
 "The ",
 StyleBox["holonomy",
  FontSlant->Italic],
 " of a closed base walk is its transport permutation of the starting fiber. \
The product on the left and the twisted cover on the right have the same \
sixteen-cycle base and two-point fibers. The colored walks lift one base \
circuit from the two states above vertex 1. Below each covering, arrows run \
from a copy of the starting fiber on the left to its endpoint fiber on the \
right."
}], "Text",
 CellDingbat->None,ExpressionUUID->"985c903f-3ec3-4b69-9a53-fbd387d2e15d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"product", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"GraphProduct", "[", " ", 
         RowBox[{
          RowBox[{"CycleGraph", "[", " ", "16", " ", "]"}], ",", " ", 
          RowBox[{"Graph", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
            RowBox[{"{", " ", "}"}]}], " ", "]"}], ",", 
          " ", "\"\<Cartesian\>\""}], " ", "]"}], ",", " ", "First"}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"twisted", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{
        RowBox[{"CycleGraph", "[", " ", "32", " ", "]"}], ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "16", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsGrid", "[", " ", 
    RowBox[{
     RowBox[{"Transpose", "[", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{
        RowBox[{"fib", " ", "|->", " ", 
         RowBox[{"With", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"connection", " ", "=", " ", 
              RowBox[{"InfraConnection", "[", " ", 
               RowBox[{"EdgeList", "[", " ", 
                RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], " ", 
                "]"}], " ", "]"}]}], ",", "\n", "      ", 
             RowBox[{"fiber", " ", "=", " ", 
              RowBox[{"VertexList", "[", " ", 
               RowBox[{"InfraFiber", "[", " ", 
                RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "]"}]}], ",",
              " ", 
             RowBox[{"loop", " ", "=", " ", 
              RowBox[{"Append", "[", " ", 
               RowBox[{
                RowBox[{"Range", "[", " ", "16", " ", "]"}], ",", " ", "1"}], 
               " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"lifts", " ", "=", " ", 
              RowBox[{"Map", "[", " ", 
               RowBox[{
                RowBox[{"start", " ", "|->", " ", 
                 RowBox[{"InfraHorizontalLift", "[", " ", 
                  RowBox[{
                  "fib", ",", " ", "connection", ",", " ", "start", ",", " ", 
                   "loop"}], " ", "]"}]}], ",", " ", "fiber"}], " ", "]"}]}], 
             ",", "\n", "      ", 
             RowBox[{"permutation", " ", "=", " ", 
              RowBox[{"PermutationList", "[", " ", 
               RowBox[{
                RowBox[{"InfraHolonomy", "[", " ", 
                 RowBox[{"fib", ",", " ", "connection", ",", " ", "loop"}], 
                 " ", "]"}], ",", " ", "2"}], " ", "]"}]}]}], " ", "}"}], ",",
            "\n", "    ", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
              RowBox[{"fib", ",", "\n", "        ", 
               RowBox[{"MapThread", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"lift", ",", " ", "color"}], " ", "}"}], " ", "|->",
                   " ", 
                  RowBox[{"Style", "[", " ", 
                   RowBox[{
                    RowBox[{"InfraWalk", "[", " ", "lift", " ", "]"}], ",", 
                    " ", "color"}], " ", "]"}]}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"lifts", ",", " ", 
                   RowBox[{"{", " ", 
                    RowBox[{"StandardBlue", ",", " ", "StandardOrange"}], " ",
                     "}"}]}], " ", "}"}]}], " ", "]"}], ",", "\n", "        ", 
               
               RowBox[{"\"\<BaseGraphLayout\>\"", " ", "->", 
                " ", "\"\<CircularEmbedding\>\""}], ",", " ", 
               RowBox[{"VertexLabels", " ", "->", " ", "None"}], " ", ",", 
               "\n", "      ", 
               RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], 
             ",", "\n", "      ", 
             RowBox[{"Graph", "[", " ", 
              RowBox[{
               RowBox[{"Tuples", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"0", ",", " ", "1"}], " ", "}"}], ",", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"1", ",", " ", "2"}], " ", "}"}]}], " ", "}"}], 
                " ", "]"}], ",", "\n", "        ", 
               RowBox[{"MapThread", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"state", ",", " ", "endpoint"}], " ", "}"}], " ", "|->",
                   " ", 
                  RowBox[{"DirectedEdge", "[", " ", 
                   RowBox[{
                    RowBox[{"{", " ", 
                    RowBox[{"0", ",", " ", "state"}], " ", "}"}], ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{"1", ",", " ", "endpoint"}], " ", "}"}]}], " ", 
                   "]"}]}], ",", "\n", "          ", 
                 RowBox[{"{", " ", 
                  RowBox[{
                   RowBox[{"Range", "[", " ", "2", " ", "]"}], ",", " ", 
                   "permutation"}], " ", "}"}]}], " ", "]"}], ",", "\n", 
               "        ", 
               RowBox[{"VertexCoordinates", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"0", ",", " ", "1"}], " ", "}"}], ",", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"0", ",", " ", "0"}], " ", "}"}], ",", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"2", ",", " ", "1"}], " ", "}"}], ",", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"2", ",", " ", "0"}], " ", "}"}]}], " ", "}"}]}], ",",
                "\n", "        ", 
               RowBox[{"VertexStyle", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", " ", 
                    RowBox[{"0", ",", " ", "1"}], " ", "}"}], " ", "->", " ", 
                   "StandardBlue"}], ",", " ", 
                  RowBox[{
                   RowBox[{"{", " ", 
                    RowBox[{"1", ",", " ", "1"}], " ", "}"}], " ", "->", " ", 
                   "StandardBlue"}], ",", "\n", "          ", 
                  RowBox[{
                   RowBox[{"{", " ", 
                    RowBox[{"0", ",", " ", "2"}], " ", "}"}], " ", "->", " ", 
                   "StandardOrange"}], ",", " ", 
                  RowBox[{
                   RowBox[{"{", " ", 
                    RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "->", " ", 
                   "StandardOrange"}]}], " ", "}"}]}], ",", " ", 
               RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
               RowBox[{"VertexSize", " ", "->", " ", ".12"}]}], " ", "]"}]}], 
            " ", "}"}]}], " ", "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"product", ",", " ", "twisted"}], " ", "}"}]}], " ", "]"}], 
      " ", "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"3ccf19eb-c64b-49a4-b59a-38d0a7783f3c"],

