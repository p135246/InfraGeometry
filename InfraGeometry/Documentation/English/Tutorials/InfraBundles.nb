Notebook[{

Cell[CellGroupData[{
Cell["Infra Bundles", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
We extract fibers, transport and global twisting from a graph and a vertex \
projection. The projection specifies observed positions; the vertices above \
each position are its internal states. We compare bundles over regular and \
irregular substrates, then follow a twisted covering through several \
resolutions.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"2d0543a4-a02e-47d8-afa4-198f262924f1"],

Cell["Setup", "Section",ExpressionUUID->"583c8cbc-c485-48ec-b6d8-59a1b5bbf88e"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7337c86d-8e36-4e3e-815f-2fe3873c6052"],

Cell["Total space, projection and fibers", "Section",ExpressionUUID->"9ff9a418-2a16-412f-a88a-e1183873153e"],

Cell[TextData[{
 "A ",
 StyleBox["fibered graph",
  FontSlant->Italic],
 " consists of a finite simple undirected unweighted untagged graph ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ecfed4fd-2ed9-45f2-824a-78347ff41f96"],
 " and a map ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4af73e7d-daf1-4e2a-b12c-25962743567a"],
 " on its vertices. The ",
 StyleBox["base graph",
  FontSlant->Italic],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e04c13b-f2e2-443f-90b0-dfb36aa0616b"],
 " has vertex set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", "("}], 
    RowBox[{
     StyleBox["V", "TI"], "(", 
     StyleBox["E", "TI"], ")"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"997a9a56-3f68-456e-978f-198c684cddd2"],
 ". Two distinct base vertices are adjacent when a total edge joins their \
preimages. The ",
 StyleBox["fiber",
  FontSlant->Italic],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4e5a219c-99a4-4477-9c1c-66d79b9cb4a1"],
 " is the induced graph on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Pi]", 
     RowBox[{"-", "1"}]], "(", 
    StyleBox["p", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"22deac32-3c02-4779-858c-5efd2fdc47e4"],
 ". Edges within a fiber are ",
 StyleBox["vertical",
  FontSlant->Italic],
 "; edges between fibers are ",
 StyleBox["transverse",
  FontSlant->Italic],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"981329fa-0837-4262-a0f9-c3d4272b5c82"],

Cell[TextData[{
 ButtonBox["InfraFiberedGraph",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph"], None},
  
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph"],
 " stores the total graph and projection. ",
 ButtonBox["InfraTotalSpace",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace"],
 ", ",
 ButtonBox["InfraBaseSpace",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace"],
 " and ",
 ButtonBox["InfraProjection",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraProjection"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraProjection"],
 " recover these data, and ",
 ButtonBox["InfraFiber",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraFiber"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraFiber"],
 " selects a fiber. The projection can be a function or an association."
}], "Text",
 CellDingbat->None,ExpressionUUID->"fa914bc2-4024-4821-ad83-841ad607f9bc"],

Cell["\<\
The rows compare a square grid, a triangular tiling and an irregular square \
mesh. Every base point carries the same four-cycle of internal states. Each \
row shows the total graph with upright fibers on the left and its base on the \
right. The marked fiber projects to an intrinsically chosen graph centre. \
Here the product construction supplies the bundle. Each substrate uses the \
same four-cycle fiber and transports each internal state to the identically \
labeled state above every neighbour.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"e659e4f5-a4ce-4623-978a-b4ee9c15ef5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Map", "[", " ", 
    RowBox[{
     RowBox[{"name", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"base", " ", "=", " ", 
          RowBox[{"BlockRandom", "[", " ", 
           RowBox[{
            RowBox[{"InfraSubstrate", "[", " ", 
             RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
              RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
             " ", "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
         " ", "}"}], ",", "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"fib", " ", "=", " ", 
           RowBox[{"InfraFiberedGraph", "[", " ", 
            RowBox[{
             RowBox[{"GraphProduct", "[", " ", 
              RowBox[{"base", ",", " ", 
               RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", 
               " ", "\"\<Cartesian\>\""}], " ", "]"}], ",", " ", "First"}], 
            " ", "]"}]}], ",", "\n", "    ", 
          RowBox[{"point", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "base", " ", "]"}]}]}]}], " ", 
         "}"}], ",", "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"Show", "[", " ", 
           RowBox[{
            RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
             RowBox[{"fib", ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{"InfraFiber", "[", " ", 
                RowBox[{"fib", ",", " ", "point"}], " ", "]"}], " ", "}"}], ",",
               " ", 
              RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}], ",", " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], " ", ",", 
              "\n", "    ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             " ", 
            RowBox[{"BoxRatios", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1", ",", " ", "1", ",", " ", ".02"}], " ", "}"}]}]}], 
           " ", "]"}], ",", "\n", "    ", 
          RowBox[{"InfraSubstrateHighlight", "[", " ", 
           RowBox[{"base", ",", " ", 
            RowBox[{"{", " ", "point", " ", "}"}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "None"}], " ", ",", "\n", 
            "      ", 
            RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], 
         " ", "}"}]}], " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<TriangularTilingGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], " ", "}"}]}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1100"}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cb65dbe5-d00e-4c78-a14c-03b90efc9f7e"],

