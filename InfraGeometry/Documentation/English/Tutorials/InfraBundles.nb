Cell["\<\
The obstruction concerns a set of states, not any single state: distinct \
partners for a set require at least as many neighbours as there are states in \
the set. Here two states have only one neighbour.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"bf7b4357-cb1b-413e-980d-4b9b660ff494"],

Cell[TextData[{
 "A ",
 StyleBox["section",
  FontSlant->Italic],
 " chooses one total vertex above each base vertex in its domain. It is \
continuous when adjacent base vertices receive adjacent choices. ",
 ButtonBox["RandomInfraSection",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection"], None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection"],
 " samples or extends sections; use ",
 Cell["Properties -> { \"Continuous\" }", "InlineCode",ExpressionUUID->
  "a88c6c0b-85a1-4146-93d6-a56e24aaa44f"],
 " to require this condition. ",
 ButtonBox["RandomInfraConnection",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConnection"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConnection"],
 " samples complete connections."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a83c5dfa-dfc4-4e5e-811e-21716828c261"],

Cell["\<\
The same three substrates distinguish selecting a state from transporting \
states. On the left, a continuous section selects one sheet of the product. \
On the right, the connection transports all four internal states along the \
base edges. The product labels make both constructions possible on the \
irregular mesh as well as on the regular grids.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"0ae221d7-0a09-46bf-8b90-ad33b394851b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Map", "[", " ", 
    RowBox[{
     RowBox[{"name", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"base", " ", "=", " ", 
          RowBox[{"BlockRandom", "[", " ", 
           RowBox[{
            RowBox[{"InfraSubstrate", "[", " ", 
             RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
              RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
             " ", "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
         " ", "}"}], ",", "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{"fib", " ", "=", " ", 
          RowBox[{"InfraFiberedGraph", "[", " ", 
           RowBox[{
            RowBox[{"GraphProduct", "[", " ", 
             RowBox[{"base", ",", " ", 
              RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", 
              " ", "\"\<Cartesian\>\""}], " ", "]"}], ",", " ", "First"}], 
           " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"section", " ", "=", " ", 
           RowBox[{"InfraSection", "[", " ", 
            RowBox[{"AssociationMap", "[", " ", 
             RowBox[{
              RowBox[{"point", " ", "|->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"point", ",", " ", "1"}], " ", "}"}]}], ",", " ", 
              RowBox[{"VertexList", "[", " ", "base", " ", "]"}]}], " ", 
             "]"}], " ", "]"}]}], ",", "\n", "    ", 
          RowBox[{"connection", " ", "=", " ", 
           RowBox[{"InfraConnection", "[", " ", 
            RowBox[{"Select", "[", " ", 
             RowBox[{
              RowBox[{"EdgeList", "[", " ", 
               RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], " ", 
               "]"}], ",", "\n", "      ", 
              RowBox[{"edge", " ", "|->", " ", 
               RowBox[{
                RowBox[{"First", "[", " ", 
                 RowBox[{"First", "[", " ", "edge", " ", "]"}], " ", "]"}], 
                " ", "=!=", " ", 
                RowBox[{"First", "[", " ", 
                 RowBox[{"Last", "[", " ", "edge", " ", "]"}], " ", 
                 "]"}]}]}]}], " ", "]"}], " ", "]"}]}]}], " ", "}"}], ",", 
        "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"Show", "[", " ", 
           RowBox[{
            RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
             RowBox[{"fib", ",", " ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{"section", ",", " ", "StandardBlue", ",", " ", 
                RowBox[{"AbsoluteThickness", "[", " ", "2.5", " ", "]"}]}], 
               " ", "]"}], ",", "\n", "      ", 
              RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}], ",", " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
              RowBox[{"EdgeStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], " ", ",", 
              "\n", "    ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             " ", 
            RowBox[{"BoxRatios", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1", ",", " ", "1", ",", " ", ".02"}], " ", "}"}]}]}], 
           " ", "]"}], ",", "\n", "    ", 
          RowBox[{"Show", "[", " ", 
           RowBox[{
            RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
             RowBox[{"fib", ",", " ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{"connection", ",", " ", "StandardOrange"}], " ", "]"}],
               ",", "\n", "      ", 
              RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}], ",", " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
              RowBox[{"EdgeStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], " ", ",", 
              "\n", "      ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             " ", 
            RowBox[{"BoxRatios", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1", ",", " ", "1", ",", " ", ".02"}], " ", "}"}]}]}], 
           " ", "]"}]}], " ", "}"}]}], " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<TriangularTilingGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], " ", "}"}]}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1100"}]}], " ", "]"}]], "Input",
