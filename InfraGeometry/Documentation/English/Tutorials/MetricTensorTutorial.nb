Cell["An exact comparison across scales", "Section",ExpressionUUID->"4d13ca83-dac9-44a5-96f0-2b7c605a16a9"],

Cell[TextData[{
 "On the square grid, graph distance is the sum of the absolute coordinate \
differences. The interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["w", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bdd854b3-d531-46dd-94d2-b511fe3bec8d"],
 " is a coordinate rectangle. Its closest vertex to ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40cc6115-cf94-4a65-87d4-c47c5ecb04d2"],
 " is obtained by clamping each coordinate of ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e0dc745d-0238-407e-a11b-c3e6adc01706"],
 " to that rectangle. After translating ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6ed9a5c0-0edd-44dd-88ac-d648a28738fd"],
 " to the origin, write ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "51ddfa8c-6aaa-461e-8595-9550b7a40fdd"],
 " for the clamp of a coordinate ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4255468e-1e8a-4bd8-97d0-478aed69e4f7"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0d083e92-dbd8-4f37-81ac-ecf3b75b2e8c"],
 " to the interval between ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2d00496d-3ace-4a5c-a41d-2b8771f65b6e"],
 " and the corresponding coordinate ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8e804b02-aa89-4699-bf38-f4a21c0b70bc"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d958a59d-632f-41ac-af58-9e6b678b8ece"],
 ". If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], 
    StyleBox["b", "TI"], 
    RowBox[{"\[LessEqual]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff33a80a-1dbb-48da-8a3c-4d4b1ae06b06"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["z", "TI"], 
    RowBox[{"\[LongEqual]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4d4a2b40-2138-4fc9-9110-70062a103f72"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["u", "TI"], "-", 
       StyleBox["b", "TI"], "|\[LongEqual]|", 
       StyleBox["u", "TI"], "|+|", 
       StyleBox["b", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfc66ff1-b712-4d4f-bb3c-d9390b98b80b"],
 ". If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], 
    StyleBox["b", "TI"], 
    RowBox[{"\[GreaterEqual]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"73989038-11c5-462d-8e36-96a696f8965c"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{
     StyleBox["z", "TI"], 
     RowBox[{"|", 
      RowBox[{"\[LongEqual]", "min"}]}], 
     RowBox[{"(", 
      TemplateBox[{
        RowBox[{
          StyleBox["u", "TI"], "|,|", 
          StyleBox["b", "TI"]}]},
       "Abs"], ")"}]}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5b80eb0-4468-4c98-9dcd-036188cc1d1a"],
 ". In both cases, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "|"}], 
    StyleBox["z", "TI"], 
    RowBox[{"|", 
     RowBox[{"\[LongEqual]", "|"}]}], 
    StyleBox["u", "TI"], 
    RowBox[{"|", 
     RowBox[{"+", "|"}]}], 
    StyleBox["b", "TI"], 
    RowBox[{"|", 
     RowBox[{"-", "|"}]}], 
    StyleBox["u", "TI"], "-", 
    StyleBox["b", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c3b1311f-3476-4c66-93ea-60d0a7b34c46"],
 ". Summing over the two coordinates gives"
}], "Text",
 CellDingbat->None,ExpressionUUID->"0274df1c-2af9-4515-bd38-89ab030893cc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["F", "TI"], 
        RowBox[{"(", 
         RowBox[{
          StyleBox["v", "TI"], ",", 
          StyleBox["w", "TI"]}], ")"}]}], ")"}]}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       StyleBox["d", "TI"], 
       RowBox[{"(", 
        RowBox[{
         StyleBox["p", "TI"], ",", 
         StyleBox["v", "TI"]}], ")"}], "+", 
       StyleBox["d", "TI"], 
       RowBox[{"(", 
        RowBox[{
         StyleBox["p", "TI"], ",", 
         StyleBox["w", "TI"]}], ")"}], "-", 
       StyleBox["d", "TI"], 
       RowBox[{"(", 
        RowBox[{
         StyleBox["v", "TI"], ",", 
         StyleBox["w", "TI"]}], ")"}]}], "2"]}], ",", "    ", 
    RowBox[{
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["r", "TI"]], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["v", "TI"], ",", 
       StyleBox["w", "TI"]}], ")"}], 
     RowBox[{"\[LongEqual]", 
      RowBox[{"1", "-"}]}], 
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["d", "TI"], "(", 
        RowBox[{
         StyleBox["v", "TI"], ",", 
         StyleBox["w", "TI"]}], ")"}], 
       RowBox[{"2", 
        StyleBox["r", "TI"]}]], "."}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8561bb84-bf23-443f-9e32-91e3f320c987"],
 "  "
}], "DisplayFormula",ExpressionUUID->"74482ae5-8a99-42dd-9a51-2c687104933d"],

Cell[TextData[{
 "Here the foot is unique. The next panels show the same configuration at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{
     RowBox[{"\[LongEqual]", "6"}], ",", "12", ",", "24"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4fef0bc8-696a-43ea-8769-1c606de95eed"],
 ", with coordinates divided by ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6eaa45f1-202e-4661-889a-00ac09b94304"],
 ". The graph shell stays a diamond inside the dashed Euclidean unit circle. \
The red interval and orange projection keep their shape while the graph \
becomes finer."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a1cc583c-0f36-4b68-9b38-811db932fbd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"coordinates", " ", "=", " ", 
         RowBox[{"Tuples", "[", " ", 
          RowBox[{
           RowBox[{"Range", "[", " ", 
            RowBox[{
             RowBox[{"-", "r"}], ",", " ", "r"}], " ", "]"}], ",", " ", "2"}],
           " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"g", " ", "=", " ", 
          RowBox[{"GridGraph", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
              RowBox[{
               RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}]}], " ", "}"}], ",",
             " ", 
            RowBox[{"VertexCoordinates", " ", "->", " ", 
             RowBox[{"coordinates", " ", "/", " ", "r"}]}], ",", "\n", 
            "          ", 
            RowBox[{"Sequence", " ", "@@", " ", 
             RowBox[{
             "InfraSubstrateStyle", "[", " ", "\"\<Large\>\"", " ", "]"}]}]}],
            " ", "]"}]}], ",", "\n", "        ", 
         RowBox[{"positions", " ", "=", " ", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{"point", " ", "|->", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FirstPosition", "[", " ", 
               RowBox[{"coordinates", ",", " ", "point"}], " ", "]"}]}]}], ",",
             "\n", "          ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{"0", ",", " ", "0"}], " ", "}"}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{"r", ",", " ", "0"}], " ", "}"}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"r", " ", "/", " ", "2"}], ",", " ", 
                RowBox[{"r", " ", "/", " ", "2"}]}], " ", "}"}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"r", " ", "/", " ", "2"}], ",", " ", "0"}], " ", 
               "}"}]}], " ", "}"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
       "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", " ", "1", " ", "]"}], "]"}]}], ",", " ", 
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], ",", " ", 
         RowBox[{"probe", " ", "=", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", " ", "3", " ", "]"}], "]"}]}], ",", " ", 
         RowBox[{"foot", " ", "=", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", " ", "4", " ", "]"}], "]"}]}]}], " ", "}"}], ",", 
       "\n", "      ", 
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"InfraShell", "[", " ", 
               RowBox[{"p", ",", " ", "r"}], " ", "]"}], " ", "->", " ", 
              "StandardGray"}], ",", " ", 
             RowBox[{
              RowBox[{"InfraSegment", "[", " ", 
               RowBox[{"p", ",", " ", "w"}], " ", "]"}], " ", "->", " ", 
              "StandardRed"}], ",", "\n", "        ", 
             RowBox[{
              RowBox[{"InfraSegment", "[", " ", 
               RowBox[{"probe", ",", " ", "foot"}], " ", "]"}], " ", "->", 
