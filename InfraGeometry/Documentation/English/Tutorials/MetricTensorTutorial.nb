Cell[TextData[{
 "In the Euclidean plane, put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", 
    StyleBox["r", "TI"], 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d627595d-4768-4a33-8758-3f2246a7ab44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["w", "TI"], "\[LongEqual]", 
    StyleBox["r", "TI"], 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b5cb23da-37dd-4733-85c5-8e141e35406d"],
 " for unit vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2cb3e567-f7cf-4447-bb17-cb1c3a612eb9"],
 ". A point of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"0", ","}], 
     StyleBox["w", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd82d50c-610d-4530-924c-090769ad0373"],
 " has the form ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "b"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f6c12b9e-6d03-4ae2-b228-fa358d96b117"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "\[LessEqual]"}], 
    StyleBox["t", "TI"], "\[LessEqual]", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da05e95d-6bff-4b53-9d2f-c3020a6a125a"],
 ", and"
}], "Text",
 CellDingbat->None,ExpressionUUID->"bc7e9799-3a05-4951-93de-9b5911137e95"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    StyleBox["r", "TI"], 
    StyleBox["a", "TI"], "-", 
    StyleBox["t", "TI"], 
    StyleBox["b", "TI"], 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], "+", 
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], 
    RowBox[{"-", "2"}], 
    StyleBox["r", "TI"], 
    StyleBox["t", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], "\[CenterDot]", 
      StyleBox["b", "TI"]}], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ffb8b002-e743-4484-bfed-029ca69bf7a9"],
 "  "
}], "DisplayFormula",ExpressionUUID->"d9a0f6f6-374a-4ebe-a60a-47f80713eec5"],

Cell[TextData[{
 "The minimizing parameter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    StyleBox["r", "TI"], "max", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], "\[CenterDot]", 
      StyleBox["b", "TI"], 
      RowBox[{",", "0"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"553261ad-c624-42a2-b347-6df1cba44b0c"],
 ", so the reference value is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"max", 
    RowBox[{"(", 
     RowBox[{"cos\[Theta]", ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e57fde87-682b-46b2-b7b7-717b666f00df"],
 ". This is only the positive projection part of the Euclidean inner product. \
At finite graph scale, symmetry and bilinearity are not automatic, and the \
pencil has no specified vector-space operations."
}], "Text",
 CellDingbat->None,ExpressionUUID->"240dbc51-d86c-4a8b-bcd0-f0e69d87063c"],

Cell["One germ against the pencil", "Section",ExpressionUUID->"c3ada151-b9d7-4af2-8e66-e7ce478393bd"],

Cell[TextData[{
 "The color runs along one germ from blue at the base, through yellow, to red \
at its endpoint. Each shell vertex takes the color of the parameter where the \
germ comes closest to it, averaged over ties and divided by ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3a46f33f-8c3d-46e1-bcd8-4e29d91f7b78"],
 ". This picture uses projection onto the displayed path; the metric tables \
use projection onto the whole interval. The columns are square and triangular \
tilings and an irregular mesh; the rows are medium and large substrates."
}], "Text",
 CellDingbat->None,ExpressionUUID->"72ecefe4-0a73-4431-ac48-415af1c259ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"BlockRandom", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrate", "[", " ", 
            RowBox[{"name", ",", " ", "size"}], " ", "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", " ", 
         RowBox[{"distances", " ", "=", " ", 
          RowBox[{"GraphDistanceMatrix", "[", " ", "g", " ", "]"}]}]}], " ", 
        "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"Floor", "[", " ", 
          RowBox[{
           RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", " ", 
           "2"}], " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"shell", " ", "=", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", " ", 
             RowBox[{"p", ",", " ", "r"}], " ", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",", 
       "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"germ", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"RandomInfraSegment", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", " ", 
             RowBox[{"p", ",", " ", 
              RowBox[{"First", "[", " ", "shell", " ", "]"}]}], " ", "]"}], ",",
             " ", "1", ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"indices", " ", "=", " ", 
         RowBox[{"Map", "[", " ", 
          RowBox[{
           RowBox[{"vertex", " ", "|->", " ", 
            RowBox[{"VertexIndex", "[", " ", 
             RowBox[{"g", ",", " ", "vertex"}], " ", "]"}]}], ",", " ", 
           "germ"}], " ", "]"}]}], " ", "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"parameters", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", " ", 
          RowBox[{"shell", ",", "\n", "          ", 
           RowBox[{
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"endpoint", " ", "|->", " ", 
               RowBox[{"With", "[", "\n", "            ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"alongGerm", " ", "=", " ", 
                   RowBox[{"distances", "[", 
                    RowBox[{"[", " ", 
                    RowBox[{
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"g", ",", " ", "endpoint"}], " ", "]"}], ",", " ",
                     "indices"}], " ", "]"}], "]"}]}], " ", "}"}], ",", "\n", 
                 "            ", 
                 RowBox[{"Mean", " ", "@", " ", 
                  RowBox[{"Pick", "[", " ", 
                   RowBox[{
                    RowBox[{"Range", "[", " ", 
                    RowBox[{"0", ",", " ", "r"}], " ", "]"}], ",", " ", 
                    "alongGerm", ",", " ", 
                    RowBox[{"Min", "[", " ", "alongGerm", " ", "]"}]}], " ", 
                   "]"}]}]}], " ", "]"}]}], ",", " ", "shell"}], " ", "]"}], 
            " ", "/", " ", 
            RowBox[{"N", "[", " ", "r", " ", "]"}]}]}], " ", "]"}]}], " ", 
        "}"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"color", " ", "=", " ", 
         RowBox[{"t", " ", "|->", " ", 
          RowBox[{"Blend", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{
             "StandardBlue", ",", " ", "StandardYellow", ",", " ", 
              "StandardRed"}], " ", "}"}], ",", " ", "t"}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "      ", 
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Join", "[", "\n", "        ", 
            RowBox[{
             RowBox[{"Table", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"InfraWalk", "[", " ", 
                 RowBox[{"germ", "[", 
                  RowBox[{"[", " ", 
                   RowBox[{"k", " ", ";;", " ", 
                    RowBox[{"k", " ", "+", " ", "1"}]}], " ", "]"}], "]"}], 
                 " ", "]"}], " ", "->", " ", 
                RowBox[{"color", "[", " ", 
                 RowBox[{"k", " ", "/", " ", "r"}], " ", "]"}]}], ",", " ", 
               RowBox[{"{", " ", 
                RowBox[{"k", ",", " ", "r"}], " ", "}"}]}], " ", "]"}], ",", 
             "\n", "        ", 
             RowBox[{"Map", "[", " ", 
              RowBox[{
               RowBox[{"edge", " ", "|->", " ", 
                RowBox[{
                 RowBox[{"InfraWalk", "[", " ", 
                  RowBox[{"List", " ", "@@", " ", "edge"}], " ", "]"}], " ", "->",
                  " ", 
                 RowBox[{"color", "[", " ", 
                  RowBox[{"Mean", "[", " ", 
                   RowBox[{"parameters", " ", "/@", " ", 
                    RowBox[{"(", " ", 
                    RowBox[{"List", " ", "@@", " ", "edge"}], " ", ")"}]}], 
                   " ", "]"}], " ", "]"}]}]}], ",", "\n", "          ", 
               RowBox[{"Select", "[", " ", 
                RowBox[{
                 RowBox[{"EdgeList", "[", " ", "g", " ", "]"}], ",", " ", 
                 RowBox[{"edge", " ", "|->", " ", 
                  RowBox[{"SubsetQ", "[", " ", 
                   RowBox[{"shell", ",", " ", 
                    RowBox[{"List", " ", "@@", " ", "edge"}]}], " ", 
                   "]"}]}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "        ", 
             RowBox[{"KeyValueMap", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{"t", ",", " ", "vertices"}], " ", "}"}], " ", "|->", 
                " ", 
                RowBox[{"vertices", " ", "->", " ", 
                 RowBox[{"color", "[", " ", "t", " ", "]"}]}]}], ",", " ", 
               RowBox[{"GroupBy", "[", " ", 
                RowBox[{"shell", ",", " ", "parameters"}], " ", "]"}]}], " ", 
              "]"}], ",", "\n", "        ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"{", " ", "p", " ", "}"}], " ", "->", " ", 
               RowBox[{"color", "[", " ", "0", " ", "]"}]}], " ", "}"}]}], 
            " ", "]"}], " ", ",", "\n", "        ", 
           RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
          "\n", "        ", 
         RowBox[{"Row", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"StringReplace", "[", " ", 
             RowBox[{"name", ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                
                RowBox[{"\"\<TilingGraph\>\"", " ", "->", 
