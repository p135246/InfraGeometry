Cell[TextData[{
 "Multiplying lattice coordinates and ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13fb08c8-20ff-43b4-be27-a2a668c74330"],
 " by the same positive integer leaves the corresponding tensor entries \
unchanged. This is an exact scale consistency after measuring lengths in \
units of ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "50ad4b64-deb2-4dd4-876a-ffd10e09ecf0"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a3e6dad4-9944-4282-b6a8-fcc225057b0f"],

Cell[TextData[{
 "It does not make the grid Euclidean. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{"0", ",", "0"}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3d77aab1-3d6e-4c93-843a-55fe4c96839f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["w", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], 
      RowBox[{",", "0"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5a70e1f9-a9da-4cf2-be1d-7d0f8bedf538"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], 
      RowBox[{
       RowBox[{"/", "2"}], ","}], 
      StyleBox["r", "TI"], 
      RowBox[{"/", "2"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"df5f0c80-ea4f-4e37-9afd-aa3eecc42706"],
 " with even ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bcf2485-996a-4db4-9ce0-92a1f9ef703c"],
 ", the entry is always ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "31c0ab84-0671-44a7-b407-0dc88f3a57f0"],
 ". The Euclidean angle between these directions is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "4"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"36fde46d-1c78-4f90-95f4-fc5489b3a43d"],
 ", whose cosine is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/"}], 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "29b0ba88-2ab3-4e7b-b579-9beaed443675"],
 ". The discrepancy persists at every such scale because the rescaled graph \
metric remains the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"79947142-96ff-433c-8731-8e805ef52456"],
 " metric."
}], "Text",
 CellDingbat->None,ExpressionUUID->"dd65649f-e641-41a5-a21f-9563788f764e"],

Cell["Seeing the projection table", "Section",ExpressionUUID->"3ec394d6-380a-4835-954b-cb0783666caa"],

Cell[TextData[{
 "The columns below are the large square tiling, triangular tiling and \
irregular mesh. The first row shows ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["r", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3f536255-6c31-49d4-a420-941b083fb4c5"],
 "; the second shows the clipped cosine between the same embedded directions. \
The third row subtracts the second from the first, using the same color scale \
in every panel: blue is negative, gray is zero and red is positive. This \
comparison retains the pairing of directions, which a distribution of table \
entries would discard. The embedding only orders directions and supplies the \
Euclidean comparison. Each shell is read at half the graph radius."
}], "Text",
 CellDingbat->None,ExpressionUUID->"b373e9d8-2fa3-475a-b08d-63706231c681"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Transpose", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"g", " ", "=", " ", 
          RowBox[{"BlockRandom", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"InfraSubstrate", "[", " ", 
             RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
              RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
             " ", "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
         " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"p", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", " ", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"AssociationThread", "[", " ", 
            RowBox[{
             RowBox[{"VertexList", "[", " ", "g", " ", "]"}], ",", " ", 
             RowBox[{"GraphEmbedding", "[", " ", "g", " ", "]"}]}], " ", 
            "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Floor", "[", " ", 
           RowBox[{
            RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", " ", 
            "2"}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"shell", " ", "=", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", " ", 
               RowBox[{"p", ",", " ", "r"}], " ", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
         "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"directions", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"v", " ", "|->", " ", 
              RowBox[{"Normalize", "[", " ", 
               RowBox[{
                RowBox[{"coordinates", "[", " ", "v", " ", "]"}], " ", "-", 
                " ", 
                RowBox[{"coordinates", "[", " ", "p", " ", "]"}]}], " ", 
               "]"}]}], ",", " ", "shell"}], " ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"order", " ", "=", " ", 
           RowBox[{"Ordering", "[", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"v", " ", "|->", " ", 
               RowBox[{"Mod", "[", " ", 
                RowBox[{
                 RowBox[{"ArcTan", " ", "@@", " ", 
                  RowBox[{"(", " ", 
                   RowBox[{
                    RowBox[{"coordinates", "[", " ", "v", " ", "]"}], " ", "-",
                     " ", 
                    RowBox[{"coordinates", "[", " ", "p", " ", "]"}]}], " ", 
                   ")"}]}], ",", " ", 
                 RowBox[{"2", " ", "Pi"}]}], " ", "]"}]}], ",", " ", 
              "shell"}], " ", "]"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
        "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"tensor", " ", "=", " ", 
           RowBox[{"InfraMetricTensor", "[", " ", 
            RowBox[{"g", ",", " ", "p", ",", " ", "r", ",", " ", 
             RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "Mean"}]}], 
            " ", "]"}]}], ",", "\n", "      ", 
          RowBox[{"reference", " ", "=", " ", 
           RowBox[{"Clip", "[", " ", 
            RowBox[{
             RowBox[{"Outer", "[", " ", 
              RowBox[{
              "Dot", ",", " ", "directions", ",", " ", "directions", ",", " ",
                "1"}], " ", "]"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"0", ",", " ", "1"}], " ", "}"}]}], " ", "]"}]}]}], " ",
          "}"}], ",", "\n", "    ", 
        RowBox[{"Join", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"MapThread", "[", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"matrix", ",", " ", "title"}], " ", "}"}], " ", "|->", 
             " ", 
             RowBox[{"MatrixPlot", "[", " ", 
              RowBox[{
               RowBox[{"matrix", "[", 
                RowBox[{"[", " ", 
                 RowBox[{"order", ",", " ", "order"}], " ", "]"}], "]"}], ",",
                " ", 
               RowBox[{"PlotRange", " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"0", ",", " ", "1"}], " ", "}"}]}], ",", " ", 
               RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", 
               "          ", 
               RowBox[{"PlotLabel", " ", "->", " ", 
                RowBox[{"Row", "[", " ", 
                 RowBox[{"{", "\n", "            ", 
                  RowBox[{
                   RowBox[{"StringReplace", "[", " ", 
                    RowBox[{"name", ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{
                    
                    RowBox[{"\"\<TilingGraph\>\"", " ", "->", 
                    " ", "\"\< tiling\>\""}], ",", " ", 
                    
                    RowBox[{"\"\<MeshGraph\>\"", " ", "->", 
                    " ", "\"\< mesh\>\""}]}], " ", "}"}]}], " ", "]"}], ",", 
                   " ", "\"\<: \>\"", ",", " ", "title"}], " ", "}"}], " ", 
                 "]"}]}]}], " ", "]"}]}], ",", "\n", "        ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{"tensor", ",", " ", "reference"}], " ", "}"}], ",", 
              " ", 
              RowBox[{"{", " ", 
               
               RowBox[{"\"\<projection\>\"", ",", 
                " ", "\"\<clipped cosine\>\""}], " ", "}"}]}], " ", "}"}]}], 
           " ", "]"}], ",", "\n", "      ", 
          RowBox[{"{", " ", 
           RowBox[{"MatrixPlot", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", " ", 
               RowBox[{"tensor", " ", "-", " ", "reference"}], " ", ")"}], "[", 
              RowBox[{"[", " ", 
               RowBox[{"order", ",", " ", "order"}], " ", "]"}], "]"}], ",", 
             " ", 
             RowBox[{"PlotRange", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], " ", "}"}]}], ",", " ", 
             RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", 
             "          ", 
             RowBox[{"ColorFunction", " ", "->", " ", 
              RowBox[{"(", " ", 
               RowBox[{"t", " ", "|->", " ", 
                RowBox[{"Blend", "[", " ", 
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{
                   "StandardBlue", ",", " ", "StandardGray", ",", " ", 
                    "StandardRed"}], " ", "}"}], ",", " ", 
                  RowBox[{
                   RowBox[{"(", " ", 
                    RowBox[{"t", " ", "+", " ", "1"}], " ", ")"}], " ", "/", 
                   " ", "2"}]}], " ", "]"}]}], " ", ")"}]}], ",", "\n", 
             "          ", 
             RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", 
             " ", 
             RowBox[{
             "PlotLabel", " ", "->", 
              " ", "\"\<projection minus clipped cosine\>\""}]}], " ", "]"}], 
           " ", "}"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "  ", 
      RowBox[{"{", " ", 
       RowBox[{"name", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
          " ", "\"\<TriangularTilingGraph\>\"", ",", 
          " ", "\"\<SquareMeshGraph\>\""}], " ", "}"}]}], " ", "}"}]}], " ", 
     "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"79807ec3-5c39-4c9f-bd69-33e63ddf0cfb"],

