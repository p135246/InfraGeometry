Notebook[{

Cell[CellGroupData[{
Cell["The Metric Tensor", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Can graph distances recover the angular information of a metric tensor? We \
construct a dimensionless projection observable and compare it across scales. \
The square grid gives an exact example of scale consistency, though its \
limiting geometry retains the grid's preferred directions.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"24a70b19-da92-46da-b915-e23f2246578c"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"456f038d-a478-4201-875a-fe23cd87bf5a"],

Cell["Projection from graph distances", "Section",ExpressionUUID->"a88fd327-9846-442b-842f-57c25fc73ae1"],

Cell[TextData[{
 "Fix a vertex ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a682288f-30a3-4e77-a19f-67104841e973"],
 " in a connected unweighted graph and an integer radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{">", "0"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "376a3d18-103c-4d9c-bcb0-0be5d6580565"],
 ". Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
      StyleBox["r", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6a4a6934-5bba-4770-94b2-90eda531fa82"],
 " for its shell and"
}], "Text",
 CellDingbat->None,ExpressionUUID->"0e433c9d-7c8d-4d4a-86b5-e4cda4a158f2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["x", "TI"]}], ")"}], "+", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["w", "TI"]}], ")"}], "\[LongEqual]", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["w", "TI"]}], ")"}]}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c32d1904-9348-40ec-98d0-3e4ab47b73f1"],
 "  "
}], "DisplayFormula",ExpressionUUID->"8ff27511-44f5-447f-8133-ba2ad93b959f"],

Cell[TextData[{
 "for the vertices on shortest paths from ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b9dfde07-50f5-4b6e-8885-c03eb981f42d"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3bf4a7e6-e482-423f-9a0f-e70bfebc614d"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], ",", 
    StyleBox["w", "TI"], "\[Element]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["p", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d4e61438-3fed-4125-9aee-5cada1c029da"],
 ", let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["F", "TI"], "(", 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox["w", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c9ed9402-5f37-409d-9a4a-ad7fd18fc316"],
 " be the vertices of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["w", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d6879f07-df70-4637-9090-d30744f752c3"],
 " closest to ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a9a8a59-5233-495e-82fd-dcf24b077516"],
 ". We use the mean distance of these feet from the base:"
}], "Text",
 CellDingbat->None,ExpressionUUID->"6163a01e-ed21-4f23-93ff-110ecf46acc0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["r", "TI"]], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["v", "TI"], ",", 
       StyleBox["w", "TI"]}], ")"}]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       StyleBox["r", "TI"], " ", "|", 
       RowBox[{
        StyleBox["F", "TI"], 
        RowBox[{"(", 
         RowBox[{
          StyleBox["v", "TI"], ",", 
          StyleBox["w", "TI"]}], ")"}]}], "|"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["x", "TI"], "\[Element]", 
        StyleBox["F", "TI"], 
        RowBox[{"(", 
         RowBox[{
          StyleBox["v", "TI"], ",", 
          StyleBox["w", "TI"]}], ")"}]}],
       LimitsPositioning->True], 
      RowBox[{
       StyleBox["d", "TI"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["x", "TI"]}], ")"}], "."}]}]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"af2768d8-31ff-4de0-91b7-106c0849652d"],
 "  "
}], "DisplayFormula",ExpressionUUID->"a9140000-9724-4aaf-9770-97556eb41ff1"],

Cell[TextData[{
 "Thus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "\[LessEqual]"}], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["v", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], 
    RowBox[{"\[LessEqual]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"382dd9d8-f591-4e8b-9902-16988b4d41c7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["v", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], 
    RowBox[{"\[LongEqual]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e40ce014-5ed8-4a74-beec-53934a0673a3"],
 ". ",
 ButtonBox["InfraMetricTensor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraMetricTensor"], None},
  
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraMetricTensor"],
 " computes this table with ",
 Cell["\"SelectCoordinate\" -> Mean", "InlineCode",ExpressionUUID->
  "1c06ace9-b16b-4554-8521-db34c2a94719"],
 ". Its default selector is ",
 Cell["Min", "InlineCode",ExpressionUUID->
  "9c84eaf1-cd53-4db6-b3db-eefdd3f242be"],
 "; ",
 Cell["Max", "InlineCode",ExpressionUUID->
  "f1a2eb0d-7d0a-431c-86b2-6b015c4bbc18"],
 " gives the other extreme when feet are tied. Rows and columns follow the \
sorted shell vertices."
}], "Text",
 CellDingbat->None,ExpressionUUID->"4364e300-a99a-434e-8e92-35897fd1d301"],

Cell[TextData[{
 "A ",
 StyleBox["germ",
  FontWeight->Bold],
 " is one shortest path of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a84f4e75-3ae3-4a2b-9745-f420340dc6c7"],
 " starting at ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "76ef1055-ce98-4ebe-8fac-fd449c0f3444"],
 ". The collection of germs is the ",
 StyleBox["pencil",
  FontWeight->Bold],
 " at that scale. Projecting onto one germ gives a path-dependent observable; \
projecting onto ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["w", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b16182c-65de-4c03-813a-be3ae02321a2"],
 " uses all shortest paths with endpoint ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75671c30-4e10-4a73-801c-d05dcc3a7eaa"],
 ". The metric tables below use the interval definition above."
}], "Text",
 CellDingbat->None,ExpressionUUID->"8087260e-34d1-4ebc-ae13-35be1151ab7f"],

Cell[TextData[{
 "The next grid compares a square lattice, square mesh and cube mesh above, \
and a sphere mesh, square torus and Sierpinski triangle below. The shell is \
gray, the interval from the centre red, and the probe blue. Orange marks its \
closest feet and one shortest path to a foot. The endpoint is the first shell \
vertex; the probe is another shell vertex whose distance from it is closest \
to ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9375e935-d43b-4c57-aadd-9dc268aad2ec"],
 ". These choices use graph distances alone, so the same construction applies \
to every substrate."
}], "Text",
 CellDingbat->None,ExpressionUUID->"6ab62fcb-b047-485a-a987-51463ce7fd64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Partition", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"BlockRandom", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrate", "[", " ", 
              RowBox[{
               RowBox[{"specification", "[", 
                RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", 
               " ", "\"\<Large\>\""}], " ", "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"p", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", " ", 
           RowBox[{"distances", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", "[", " ", "g", " ", "]"}]}]}], " ",
           "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"Floor", "[", " ", 
            RowBox[{
             RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", " ", 
             "2"}], " ", "]"}]}], " ", "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"shell", " ", "=", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", " ", 
               RowBox[{"p", ",", " ", "r"}], " ", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",",
          "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"First", "[", " ", "shell", " ", "]"}]}], " ", "}"}], ",", 
         "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"probe", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"MinimalBy", "[", " ", 
              RowBox[{
               RowBox[{"Select", "[", " ", 
                RowBox[{"shell", ",", " ", 
                 RowBox[{"vertex", " ", "|->", " ", 
                  RowBox[{"vertex", " ", "=!=", " ", "w"}]}]}], " ", "]"}], ",",
                "\n", "            ", 
               RowBox[{"vertex", " ", "|->", " ", 
                RowBox[{"Abs", "[", " ", 
                 RowBox[{
                  RowBox[{"distances", "[", 
                   RowBox[{"[", " ", 
                    RowBox[{
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"g", ",", " ", "w"}], " ", "]"}], ",", " ", 
                    RowBox[{"VertexIndex", "[", " ", 
                    RowBox[{"g", ",", " ", "vertex"}], " ", "]"}]}], " ", 
                    "]"}], "]"}], " ", "-", " ", "r"}], " ", "]"}]}]}], " ", 
              "]"}]}]}], ",", "\n", "          ", 
           RowBox[{"interval", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", " ", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", " ", 
                RowBox[{"p", ",", " ", "w"}], " ", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
          "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"feet", " ", "=", " ", 
           RowBox[{"MinimalBy", "[", " ", 
            RowBox[{"interval", ",", "\n", "            ", 
             RowBox[{"vertex", " ", "|->", " ", 
              RowBox[{"distances", "[", 
               RowBox[{"[", " ", 
                RowBox[{
                 RowBox[{"VertexIndex", "[", " ", 
                  RowBox[{"g", ",", " ", "vertex"}], " ", "]"}], ",", " ", 
                 RowBox[{"VertexIndex", "[", " ", 
                  RowBox[{"g", ",", " ", "probe"}], " ", "]"}]}], " ", "]"}], 
               "]"}]}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"connector", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"RandomInfraSegment", "[", " ", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", " ", 
               RowBox[{"probe", ",", " ", 
                RowBox[{"First", "[", " ", "feet", " ", "]"}]}], " ", "]"}], ",",
               " ", "1", ",", " ", 
              RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", 
             "]"}]}]}], " ", "}"}], ",", "\n", "        ", 
         RowBox[{"Labeled", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", "\n", "            ", 
              RowBox[{
               RowBox[{"shell", " ", "->", " ", "StandardGray"}], ",", " ", 
               RowBox[{
                RowBox[{"InfraSegment", "[", " ", 
                 RowBox[{"p", ",", " ", "w"}], " ", "]"}], " ", "->", " ", 
                "StandardRed"}], ",", "\n", "            ", 
               RowBox[{
                RowBox[{"InfraWalk", "[", " ", "connector", " ", "]"}], " ", "->",
                 " ", "StandardOrange"}], ",", " ", 
               RowBox[{"feet", " ", "->", " ", "StandardOrange"}], ",", " ", 
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{"p", ",", " ", "w", ",", " ", "probe"}], " ", "}"}], 
                " ", "->", " ", "StandardBlue"}]}], " ", "}"}], " ", ",", 
             "\n", "            ", 
             RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
            "\n", "          ", 
           RowBox[{"specification", "[", 
            RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "]"}]}], " ", 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"specification", ",", " ", 
         RowBox[{"{", "\n", "          ", 
          RowBox[{
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
             " ", "\"\<square lattice\>\""}], " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
             " ", "\"\<square mesh\>\""}], " ", "}"}], ",", "\n", 
           "          ", 
           RowBox[{"{", " ", 
            RowBox[{"\"\<CubeMeshGraph\>\"", ",", " ", "\"\<cube mesh\>\""}], 
            " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SphereMeshGraph\>\"", ",", 
             " ", "\"\<sphere mesh\>\""}], " ", "}"}], ",", "\n", 
           "          ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SquareTorusGraph\>\"", ",", 
             " ", "\"\<square torus\>\""}], " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", 
             " ", "\"\<Sierpinski triangle\>\""}], " ", "}"}]}], " ", "}"}]}],
         " ", "}"}]}], " ", "]"}], ",", "\n", "    ", "3"}], " ", "]"}], ",", 
   "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"eae650ab-e39c-4c20-b3f4-ff932658ed0e"],

