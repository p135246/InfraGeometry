Cell["Comparing distributions", "Section",ExpressionUUID->"ac6e54e9-9cb5-4de7-8b86-a419f6bfdd5a"],

Cell[TextData[{
 "For a comparison that needs no embedding, give every ordered pair of shell \
vertices equal weight. Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["r", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b48d0335-471e-46c8-99b5-1ba0a9a46156"],
 " be the distribution function of the resulting entries. Uniform directions \
in the Euclidean plane give the reference distribution"
}], "Text",
 CellDingbat->None,ExpressionUUID->"d9482044-a268-4e87-8be2-20bae10c19e5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["F", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"1", "-"}]}], 
    FractionBox[
     RowBox[{"arccos", 
      StyleBox["t", "TI"]}], "\[Pi]"], 
    RowBox[{",", "    ", 
     RowBox[{"0", "\[LessEqual]"}]}], 
    StyleBox["t", "TI"], 
    RowBox[{
     RowBox[{"\[LessEqual]", "1"}], ","}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1f749b1d-b218-4408-bbba-76f5e388d550"],
 "  "
}], "DisplayFormula",ExpressionUUID->"da97dff1-6d8c-4251-ae33-808adcd198c7"],

Cell[TextData[{
 "including an atom of mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0b70f4e-3c36-48c2-a8fa-cd6ae30a77cc"],
 " at zero. We measure the discrepancy by"
}], "Text",
 CellDingbat->None,ExpressionUUID->"c8ba83d0-8df8-4dc3-b927-4efa790448cb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["r", "TI"]], "\[LongEqual]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], "|", 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "-", 
    StyleBox["F", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], 
    RowBox[{"|", "\[DifferentialD]"}], 
    StyleBox["t", "TI"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f27fb6ce-1c55-4f75-8c66-c7f502428e06"],
 "  "
}], "DisplayFormula",ExpressionUUID->"28bc9826-9e8d-4025-93f9-0008f97e44f6"],

Cell[TextData[{
 "The helper uses a midpoint approximation with step ",
 Cell[BoxData[
  FormBox["0.001", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad9c73ea-c4cc-4414-837c-7332741058b4"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"df9845b9-9759-4a68-a78d-c4340f67e3ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectionGap", "[", " ", "values_", " ", "]"}], " ", ":=", "\n", 
  "  ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"distribution", " ", "=", " ", 
       RowBox[{"EmpiricalDistribution", "[", " ", 
        RowBox[{"Flatten", "[", " ", "values", " ", "]"}], " ", "]"}]}], ",", 
      " ", 
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"Range", "[", " ", 
        RowBox[{"0.0005", ",", " ", "0.9995", ",", " ", "0.001"}], " ", 
        "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
    RowBox[{"Mean", " ", "@", " ", 
     RowBox[{"Abs", " ", "@", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{
          RowBox[{"CDF", "[", " ", 
           RowBox[{"distribution", ",", " ", "t"}], " ", "]"}], " ", "-", " ", 
          RowBox[{"(", " ", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{
             RowBox[{"ArcCos", "[", " ", "t", " ", "]"}], " ", "/", " ", 
             "Pi"}]}], " ", ")"}]}]}], ",", " ", "grid"}], " ", "]"}]}]}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"3f31afc3-3ba1-45d4-87c8-74f0fb1bcc90"],

Cell[TextData[{
 "For each tiling, increase ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "295f3816-77ee-4f58-85ba-733160ce867e"],
 " inside one large patch. For the mesh, refine the graph and read the shell \
at half its graph radius. The two procedures share the normalization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20ab77f7-6925-4416-9d79-d74631899fd8"],
 ", though they change the substrate in different ways."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a1b65492-579c-43e5-9225-04b54195c10a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Join", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", " ", 
            RowBox[{"name", ",", " ", "\"\<Large\>\""}], " ", "]"}]}], " ", 
          "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"p", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], " ", "}"}], 
         ",", "\n", "        ", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"{", " ", 
            RowBox[{"r", ",", " ", 
             RowBox[{"projectionGap", "[", " ", 
              RowBox[{"InfraMetricTensor", "[", " ", 
               RowBox[{"g", ",", " ", "p", ",", " ", "r", ",", " ", 
                
                RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", 
                 "Mean"}]}], " ", "]"}], " ", "]"}]}], " ", "}"}], ",", "\n", 
           "          ", 
           RowBox[{"{", " ", 
            RowBox[{"r", ",", " ", "2", ",", " ", 
             RowBox[{"Floor", "[", " ", 
              RowBox[{
               RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", 
               " ", "2"}], " ", "]"}]}], " ", "}"}]}], " ", "]"}]}], " ", 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", " ", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\""}], " ", "}"}]}], " ", "}"}]}], 
      " ", "]"}], ",", "\n", "    ", 
     RowBox[{"{", " ", 
      RowBox[{"Table", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"With", "[", "\n", "          ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"BlockRandom", "[", " ", 
             RowBox[{
              RowBox[{"InfraSubstrate", "[", " ", 
               RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "size"}], " ", 
               "]"}], ",", " ", 
              RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
           " ", "}"}], ",", "\n", "          ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "=", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", " ", 
            
            RowBox[{"r", " ", "=", " ", 
             RowBox[{"Floor", "[", " ", 
              RowBox[{
               RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", 
               " ", "2"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
          "          ", 
          RowBox[{"{", " ", 
           RowBox[{"r", ",", " ", 
            RowBox[{"projectionGap", "[", " ", 
             RowBox[{"InfraMetricTensor", "[", " ", 
              RowBox[{"g", ",", " ", "p", ",", " ", "r", ",", " ", 
               RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "Mean"}]}],
               " ", "]"}], " ", "]"}]}], " ", "}"}]}], " ", "]"}], ",", "\n", 
        "        ", 
        RowBox[{"{", " ", 
         RowBox[{"size", ",", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
            " ", "\"\<Large\>\""}], " ", "}"}]}], " ", "}"}]}], " ", "]"}], 
      " ", "}"}]}], " ", "]"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", " ", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<projection gap\>\""}], " ", "}"}]}], 
   ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", " ", 
     RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
      " ", "\"\<hexagonal\>\"", ",", " ", "\"\<mesh\>\""}], " ", "}"}]}]}], 
  " ", "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"7a847edb-4db6-4934-8a12-bed1fa5d2393"],

