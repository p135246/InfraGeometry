Cell["\<\
Each fiber contains a clockwise and an anticlockwise ray. At length 1, rays \
of opposite directions can still be adjacent above neighbouring base \
vertices. At length 2, their second steps separate them. The total graph \
becomes two disjoint cycles, one for each direction.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"ffda807e-9feb-4b6e-bf4f-4ed50c0c300c"],

Cell["See the local change", "Section",ExpressionUUID->"7fd36b97-11ea-434f-bc4d-56de3a788575"],

Cell["\<\
A close view of seven successive fibers explains this separation. Each \
vertical pair is one fiber; the two horizontal rows track its directional \
states. At ray length 1, gray diagonal edges allow direction change. At \
length 2, only the horizontal matchings remain.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"cc00b783-c4c0-4a37-92c4-f58fc7de6e8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "64", " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"radius", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"total", " ", "=", " ", 
            RowBox[{"InfraTotalSpace", "[", " ", 
             RowBox[{"InfraTangentBundle", "[", " ", 
              RowBox[{"graph", ",", " ", "radius"}], " ", "]"}], " ", "]"}]}],
            " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"local", " ", "=", " ", 
            RowBox[{"Subgraph", "[", " ", 
             RowBox[{"total", ",", " ", 
              RowBox[{"Select", "[", " ", 
               RowBox[{
                RowBox[{"VertexList", "[", " ", "total", " ", "]"}], ",", " ", 
                RowBox[{"ray", " ", "|->", " ", 
                 RowBox[{"29", " ", "<=", " ", 
                  RowBox[{"First", "[", " ", "ray", " ", "]"}], " ", "<=", 
                  " ", "35"}]}]}], " ", "]"}]}], " ", "]"}]}], " ", "}"}], ",",
           "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"rays", " ", "=", " ", 
            RowBox[{"VertexList", "[", " ", "local", " ", "]"}]}], " ", "}"}],
           ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"clockwise", " ", "=", " ", 
            RowBox[{"Select", "[", " ", 
             RowBox[{"rays", ",", " ", 
              RowBox[{"ray", " ", "|->", " ", 
               RowBox[{
                RowBox[{"Mod", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ray", "[", 
                    RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"First", "[", " ", "ray", " ", "]"}]}], ",", " ", 
                  "64"}], " ", "]"}], " ", "==", " ", "1"}]}]}], " ", "]"}]}],
            " ", "}"}], ",", "\n", "    ", 
          RowBox[{"InfraSubstrateHighlight", "[", " ", 
           RowBox[{
            RowBox[{"Graph", "[", " ", 
             RowBox[{"local", ",", " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
              RowBox[{"EdgeStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], ",", "\n", 
              "      ", 
              RowBox[{"VertexCoordinates", " ", "->", " ", 
               RowBox[{"Map", "[", " ", 
                RowBox[{
                 RowBox[{"ray", " ", "|->", "\n", "        ", 
                  RowBox[{"{", " ", 
                   RowBox[{
                    RowBox[{"First", "[", " ", "ray", " ", "]"}], ",", " ", 
                    RowBox[{"If", "[", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Mod", "[", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ray", "[", 
                    RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"First", "[", " ", "ray", " ", "]"}]}], ",", " ", 
                    "64"}], " ", "]"}], " ", "==", " ", "1"}], ",", " ", "1", 
                    ",", " ", 
                    RowBox[{"-", "1"}]}], " ", "]"}]}], " ", "}"}]}], ",", 
                 " ", "rays"}], " ", "]"}]}], ",", "\n", "      ", 
              RowBox[{"PlotLabel", " ", "->", " ", 
               RowBox[{"Row", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"\"\<ray length \>\"", ",", " ", "radius"}], " ", 
                 "}"}], " ", "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"Style", "[", " ", 
               RowBox[{
                RowBox[{"Subgraph", "[", " ", 
                 RowBox[{"local", ",", " ", "clockwise"}], " ", "]"}], ",", 
                " ", "StandardBlue"}], " ", "]"}], ",", "\n", "        ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{
                RowBox[{"Subgraph", "[", " ", 
                 RowBox[{"local", ",", " ", 
                  RowBox[{"Complement", "[", " ", 
                   RowBox[{"rays", ",", " ", "clockwise"}], " ", "]"}]}], " ",
                  "]"}], ",", " ", "StandardOrange"}], " ", "]"}]}], " ", 
             "}"}], " ", ",", "\n", "      ", 
            RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], 
         " ", "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2"}], " ", "}"}]}], " ", "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3b2b6685-cc17-41a4-9721-4f8edff35338"],

