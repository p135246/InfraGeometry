Cell["\<\
Truncation and extension preserve the initial vertex and the direction. By \
the preceding description of adjacency, they are inverse graph-bundle \
isomorphisms. Thus ray consistency produces two persistent directional states \
after the two-step threshold. The fibers are two-point sets; no vector-space \
structure is constructed.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"f21bf639-b119-4f0e-b74f-8a3beeeacc37"],

Cell["What should a coarser observation preserve?", "Section",ExpressionUUID->"642ef678-dbea-4557-9d09-fa084b48b11e"],

Cell[TextData[{
 "Changing ray length, grouping vertices and adding reachability edges are \
distinct operations. The double-cover example in ",
 ButtonBox["Infra Bundles",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"], None},
  
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"],
 " gives an exact blocking rule that preserves fibers and monodromy. For a \
general projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", ":"}], 
    StyleBox["E", "TI"], "\[Rule]", 
    StyleBox["B", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a5562b6e-92e1-4124-b260-10d97c7b36d7"],
 ", observation maps ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f60754c2-2867-445c-8213-5c732dade4ea"],
 " on total vertices and ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5aaccfd0-18bf-480b-b27a-bb34d040ee1e"],
 " on base vertices admit a reduced projection exactly when"
}], "Text",
 CellDingbat->None,ExpressionUUID->"8bce9fad-5cb4-486d-939b-3af59ea0ba85"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", 
    RowBox[{"(", 
     StyleBox["x", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", "\[Alpha]"}], 
    RowBox[{"(", 
     StyleBox["y", "TI"], ")"}], "  ", 
    RowBox[{"\[DoubleLongRightArrow]", "  ", "\[Beta]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "("}], 
      StyleBox["x", "TI"], ")"}], ")"}], 
    RowBox[{"\[LongEqual]", "\[Beta]"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Pi]", "("}], 
       StyleBox["y", "TI"], ")"}], ")"}], "."}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"251cfbc4-9489-4b9d-a554-bb212854cd40"],
 "  "
}], "DisplayFormula",ExpressionUUID->"5b379160-141f-4b2b-98ed-47f3d1f8cf7d"],

Cell[TextData[{
 "Define the reduced projection by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Pi]", "_"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Alpha]", "("}], 
      StyleBox["x", "TI"], ")"}], ")"}], 
    RowBox[{"\[LongEqual]", "\[Beta]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "("}], 
      StyleBox["x", "TI"], ")"}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87c772a7-b7f4-4caf-aa59-3f2ed0eef75e"],
 ". The condition makes this independent of the representative, and it is \
necessary for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Pi]", "_"], 
    RowBox[{
    "\[EmptySmallCircle]\[Alpha]", "\[LongEqual]", 
     "\[Beta]\[EmptySmallCircle]\[Pi]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ac77f193-ea04-4bc8-af6f-72edbe4e5e07"],
 ". Reconstructing quotient adjacency gives a graph map, but lifting must \
still be checked."
}], "Text",
 CellDingbat->None,ExpressionUUID->"fefce53d-aca0-4ef6-8027-6c79ecc66acd"],

Cell[TextData[{
 "For a fixed base, a selected transport ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], ":", 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["p", "TI"]], "\[Rule]", 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["q", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3e919855-576d-4fb1-aceb-93f23c4b8222"],
 " descends through fiber equivalence relations exactly when"
}], "Text",
 CellDingbat->None,ExpressionUUID->"162e243f-09b9-488f-94e4-2c5224e80b35"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], 
    SubscriptBox["\[Tilde]", 
     StyleBox["p", "TI"]], 
    StyleBox["y", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox["\[Tilde]", 
     StyleBox["q", "TI"]], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"75c1c334-6613-4533-\
b0d7-8266f4075d65"],

Cell[TextData[{
 "This is again independence of the representative. Requiring the same \
condition for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"p", "q"}], "TI"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "44662926-d8ef-427c-8ad2-310514ff2c9a"],
 " makes the descended maps inverse bijections. If the original transports \
preserve fiber adjacency, the descended maps preserve the reconstructed \
quotient fiber graphs as well. Merging base vertices requires additional \
compatibility with the base observation."
}], "Text",
 CellDingbat->None,ExpressionUUID->"fda4ab96-6a76-4497-9ccf-ae029f5d7fbd"],

Cell[TextData[{
 "For the fixed base, composing the descended transports also gives a \
well-defined holonomy on the quotient fibers. If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    StyleBox["p", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eafa1e53-b12c-41e0-a566-0d061ffc227e"],
 " is the quotient map on a starting fiber, the original and descended \
holonomies satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     StyleBox["p", "TI"]], 
    StyleBox["H", "TI"], "\[LongEqual]", 
    OverscriptBox[
     StyleBox["H", "TI"], "_"], 
    SubscriptBox["\[Rho]", 
     StyleBox["p", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3628f8f7-e64c-445b-8ac4-68e63c2b3322"],
 ". This need not retain the original twist: identifying the two states in \
every fiber of a double cover turns its exchange into the identity on a \
one-point fiber."
}], "Text",
 CellDingbat->None,ExpressionUUID->"2748fb22-157f-4c1b-84d2-eb22fbc0ea1d"],

Cell[TextData[{
 "Reachability alone can change bundle structure. Take the double cover ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], "32"], "\[Rule]", 
    SubscriptBox[
     StyleBox["C", "TI"], "16"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad321e26-320e-423e-aae2-484f507af640"],
 " and join total vertices at distance at most ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e26c61f3-7033-4a56-b790-b489b5b1db62"],
 " using a graph power, while retaining the projection. The pictures use \
reachability radii 1, 4 and 8. Blue marks the possible steps from one total \
vertex, and orange marks the fiber over the opposite base vertex. At radius \
8, both orange states become possible lifts of the same base step."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5e82e556-4d04-4a13-84ff-952d467cd2c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", " ", 
  RowBox[{
   RowBox[{"Map", "[", " ", 
    RowBox[{
     RowBox[{"radius", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"total", " ", "=", " ", 
          RowBox[{"GraphPower", "[", " ", 
           RowBox[{
            RowBox[{"CycleGraph", "[", " ", "32", " ", "]"}], ",", " ", 
            "radius"}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"fib", " ", "=", " ", 
           RowBox[{"InfraFiberedGraph", "[", " ", 
            RowBox[{"total", ",", " ", 
             RowBox[{"vertex", " ", "|->", " ", 
              RowBox[{"Mod", "[", " ", 
               RowBox[{"vertex", ",", " ", "16", ",", " ", "1"}], " ", 
               "]"}]}]}], " ", "]"}]}], ",", "\n", "    ", 
          RowBox[{"neighbors", " ", "=", " ", 
           RowBox[{"AdjacencyList", "[", " ", 
            RowBox[{"total", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], ",",
         "\n", "  ", 
        RowBox[{"{", " ", 
         RowBox[{"star", " ", "=", " ", 
          RowBox[{"Graph", "[", " ", 
           RowBox[{
            RowBox[{"Prepend", "[", " ", 
             RowBox[{"neighbors", ",", " ", "1"}], " ", "]"}], ",", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"vertex", " ", "|->", " ", 
               RowBox[{"UndirectedEdge", "[", " ", 
                RowBox[{"1", ",", " ", "vertex"}], " ", "]"}]}], ",", " ", 
              "neighbors"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}], ",", 
        "\n", "  ", 
        RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
         RowBox[{"fib", ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"Style", "[", " ", 
             RowBox[{"star", ",", " ", "StandardBlue", ",", " ", 
              RowBox[{"AbsoluteThickness", "[", " ", "2.5", " ", "]"}]}], " ",
              "]"}], ",", " ", 
            RowBox[{"Style", "[", " ", 
             RowBox[{
              RowBox[{"InfraFiber", "[", " ", 
               RowBox[{"fib", ",", " ", "9"}], " ", "]"}], ",", " ", 
              "StandardOrange"}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          
          RowBox[{"\"\<BaseGraphLayout\>\"", " ", "->", 
           " ", "\"\<CircularEmbedding\>\""}], ",", " ", 
          RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
          RowBox[{"EdgeStyle", " ", "->", " ", 
           RowBox[{"GrayLevel", "[", " ", ".82", " ", "]"}]}], ",", "\n", 
          "    ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Row", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{"\"\<reachability radius \>\"", ",", " ", "radius"}], 
             " ", "}"}], " ", "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], 
       " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"1", ",", " ", "4", ",", " ", "8"}], " ", "}"}]}], " ", "]"}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"40739cde-3406-4dbd-beb5-16f9a8f68dd5"],

