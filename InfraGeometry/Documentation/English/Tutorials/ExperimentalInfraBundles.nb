Notebook[{

Cell[CellGroupData[{
Cell["Experimental Infra Bundles", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "We construct direction fibers from geodesic rays and compare them at \
different observation scales. On a cycle, one-step observations mix the two \
directions; longer rays separate them into a stable graph bundle. We then \
identify the compatibility conditions needed to retain bundle geometry under \
coarser observation. The ray constructions are experimental; the general \
graph, connection and holonomy definitions are in ",
 ButtonBox["Infra Bundles",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"], None},
  
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"3ed90434-92c1-48f0-a463-50b56001b6d6"],

Cell["Setup", "Section",ExpressionUUID->"fd66ba15-7c7b-463d-abbd-0c0c321368d0"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"adccd552-d0a2-4382-af04-929720f39618"],

Cell["Directions from finite rays", "Section",ExpressionUUID->"a2e31734-f5d4-4cbf-9123-dd7845fb1971"],

Cell[TextData[{
 "A geodesic ray of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5df90e4-ff3c-4e78-8e3c-38f9c5134215"],
 " is a path ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], "0"], 
     RowBox[{",", "\[Ellipsis]", ","}], 
     SubscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["r", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c5c373c7-f2b2-458c-8fbe-107009f6cc6a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "0"], ",", 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["r", "TI"]]}], ")"}], "\[LongEqual]", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8efe4d44-4a89-4015-bac3-499da2d74c86"],
 ". ",
 ButtonBox["InfraTangentBundle",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle"], None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle"],
 " takes these rays as total vertices and projects each ray to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "0"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e9efffcf-5157-49e2-b7cd-16f2f1d943a7"],
 ". Two distinct rays are adjacent when their entries at every position match \
or are adjacent in the substrate graph. Thus both the fiber graph and the \
relations between fibers come from the substrate."
}], "Text",
 CellDingbat->None,ExpressionUUID->"9f884be7-2f1f-4b17-be50-1ba813870188"],

Cell[TextData[{
 "For comparison, ",
 ButtonBox["InfraDisplacementBundle",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle"],
 " keeps only endpoint pairs at distance ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e76364d9-6c7b-48db-a06a-4634867fd82f"],
 ". ",
 ButtonBox["InfraCotangentBundle",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle"],
 " reverses the rays and projects to their terminal vertices. These names \
specify constructions; ",
 ButtonBox["InfraFiberBundleQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ"], None},
  
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ"],
 " tests whether the resulting finite object is a graph bundle."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5b9c1cc8-3160-485f-9d4c-bf2d5652116e"],

Cell[TextData[{
 "The pictures show the tangent construction on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], "64"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3101d15c-251c-4544-a25c-d5c5dabad501"],
 " at ray lengths 1, 2 and 8. Blue and orange mark the two ray orientations, \
arranged on concentric circles. Gray links show adjacency between rays of \
opposite orientation."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5596e9a3-0386-42fe-a465-4cd39ce47d7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "64", " ", "]"}]}], ",", " ", 
     RowBox[{"points", " ", "=", " ", 
      RowBox[{"CirclePoints", "[", " ", "64", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"radius", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"total", " ", "=", " ", 
            RowBox[{"InfraTotalSpace", "[", " ", 
             RowBox[{"InfraTangentBundle", "[", " ", 
              RowBox[{"graph", ",", " ", "radius"}], " ", "]"}], " ", "]"}]}],
            " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"rays", " ", "=", " ", 
            RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}], " ", "}"}],
           ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"clockwise", " ", "=", " ", 
            RowBox[{"Select", "[", " ", 
             RowBox[{"rays", ",", " ", 
              RowBox[{"ray", " ", "|->", " ", 
               RowBox[{
                RowBox[{"Mod", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ray", "[", 
                    RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"First", "[", " ", "ray", " ", "]"}]}], ",", " ", 
                  "64"}], " ", "]"}], " ", "==", " ", "1"}]}]}], " ", "]"}]}],
            " ", "}"}], ",", "\n", "    ", 
          RowBox[{"InfraSubstrateHighlight", "[", " ", 
           RowBox[{
            RowBox[{"Graph", "[", " ", 
             RowBox[{"total", ",", " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", " ", 
              RowBox[{"EdgeStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], ",", "\n", 
              "      ", 
              RowBox[{"VertexCoordinates", " ", "->", " ", 
               RowBox[{"Map", "[", " ", 
                RowBox[{
                 RowBox[{"ray", " ", "|->", "\n", "        ", 
                  RowBox[{
                   RowBox[{"If", "[", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Mod", "[", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ray", "[", 
                    RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"First", "[", " ", "ray", " ", "]"}]}], ",", " ", 
                    "64"}], " ", "]"}], " ", "==", " ", "1"}], ",", " ", "1", 
                    ",", " ", ".72"}], " ", "]"}], " ", 
                   RowBox[{"points", "[", 
                    RowBox[{"[", " ", 
                    RowBox[{"First", "[", " ", "ray", " ", "]"}], " ", "]"}], 
                    "]"}]}]}], ",", " ", "rays"}], " ", "]"}]}], ",", "\n", 
              "      ", 
              RowBox[{"PlotLabel", " ", "->", " ", 
               RowBox[{"Row", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"\"\<ray length \>\"", ",", " ", "radius"}], " ", 
                 "}"}], " ", "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"Style", "[", " ", 
               RowBox[{
                RowBox[{"Subgraph", "[", " ", 
                 RowBox[{"total", ",", " ", "clockwise"}], " ", "]"}], ",", 
                " ", "StandardBlue"}], " ", "]"}], ",", "\n", "        ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{
                RowBox[{"Subgraph", "[", " ", 
                 RowBox[{"total", ",", " ", 
                  RowBox[{"Complement", "[", " ", 
                   RowBox[{"rays", ",", " ", "clockwise"}], " ", "]"}]}], " ",
                  "]"}], ",", " ", "StandardOrange"}], " ", "]"}]}], " ", 
             "}"}], " ", ",", "\n", "      ", 
            RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], 
         " ", "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2", ",", " ", "8"}], " ", "}"}]}], " ", "]"}],
      ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f9258d77-4d9d-413a-859c-203cffed2916"],

