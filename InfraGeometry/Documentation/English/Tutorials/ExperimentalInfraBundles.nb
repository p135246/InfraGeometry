Cell[TextData[{
 "The fibers have the same size in both pictures. The graph-bundle property \
emerges when the extra transverse edges disappear. For this cycle, the result \
also has a direct proof. Write vertex labels modulo 64. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "\[LessEqual]"}], 
    StyleBox["r", "TI"], 
    RowBox[{"\[LessEqual]", "31"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b47aa102-a184-4ec7-8754-ff9066339fb7"],
 ", the two rays from ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "817b920d-6dc2-400f-bfab-285eacb89b70"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["p", "TI"], 
     RowBox[{
      RowBox[{"+", "1"}], ",", "\[Ellipsis]", ","}], 
     StyleBox["p", "TI"], "+", 
     StyleBox["r", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"170d78fa-0cfd-4db1-9e59-e5bdbab61723"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["p", "TI"], 
     RowBox[{
      RowBox[{"-", "1"}], ",", "\[Ellipsis]", ","}], 
     StyleBox["p", "TI"], "-", 
     StyleBox["r", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"725b98e1-1c58-4fc7-ba39-0c4e73e75707"],
 ". Rays of the same direction above neighbouring vertices are adjacent at \
every position. For opposite directions above ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c448dd4e-90f1-4140-8b24-d201ccde948c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "487025f3-137f-4eb5-8a62-694b88e2db92"],
 ", one pairing fails adjacency at step one and the other at step two: in \
each case the entries have distance 3. The same argument applies above ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b5c19aa8-4205-4fb3-8e87-24dc9c1995dd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e046357d-6ef3-40da-8798-5ad964e9d6d3"],
 ". The two rays in a single fiber are not adjacent, since their step-one \
entries have distance 2. Therefore, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "\[LessEqual]"}], 
    StyleBox["r", "TI"], 
    RowBox[{"\[LessEqual]", "31"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2ee8a67a-497b-49f7-ae13-3ac8fc8cd420"],
 " the total graph is the Cartesian product of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], "64"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0dc18d40-eb52-48e5-bdba-aa7eb02f7d86"],
 " with the discrete two-point set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"+", 
     RowBox[{",", "-"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5afc7431-a9f5-4bdc-b637-679361a171f8"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5bfd33ad-28ac-40f2-a8f3-a5769299adfb"],

Cell["Compare the bundles themselves", "Section",ExpressionUUID->"9b0d7a3f-2941-42ba-9948-783fd2adb756"],

Cell[TextData[{
 ButtonBox["InfraBundleMorphism",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphism"], 
    None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphism"],
 " supplies an explicit comparison: truncate a longer ray to its first three \
vertices. Each length-two ray on this cycle has a unique extension to every \
length up to 31. The pictures draw the two rays above one base point at \
lengths 2, 8 and 16. Their common two-step prefixes are drawn in stronger \
colors."
}], "Text",
 CellDingbat->None,ExpressionUUID->"2a017f9a-722e-4c0b-b324-ba2902c756ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "64", " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"radius", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"rays", " ", "=", " ", 
             RowBox[{"SortBy", "[", " ", 
              RowBox[{
               RowBox[{"InfraRays", "[", " ", 
                RowBox[{"graph", ",", " ", "1", ",", " ", "radius"}], " ", 
                "]"}], ",", " ", 
               RowBox[{"ray", " ", "|->", " ", 
                RowBox[{"Mod", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ray", "[", 
                    RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"First", "[", " ", "ray", " ", "]"}]}], ",", " ", 
                  "64"}], " ", "]"}]}]}], " ", "]"}]}], ",", "\n", "      ", 
            RowBox[{"truncate", " ", "=", " ", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{"radius", " ", "==", " ", "2"}], ",", " ", "Identity", 
               ",", "\n", "        ", 
               RowBox[{"InfraBundleMorphism", "[", " ", 
                RowBox[{
                 RowBox[{"InfraTangentBundle", "[", " ", 
                  RowBox[{"graph", ",", " ", "radius"}], " ", "]"}], ",", " ", 
                 RowBox[{"InfraTangentBundle", "[", " ", 
                  RowBox[{"graph", ",", " ", "2"}], " ", "]"}]}], " ", 
                "]"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"InfraSubstrateHighlight", "[", " ", 
           RowBox[{
            RowBox[{"Graph", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{
              "GraphLayout", " ", "->", " ", "\"\<CircularEmbedding\>\""}], ",",
               " ", 
              RowBox[{"VertexLabels", " ", "->", " ", "None"}], ",", "\n", 
              "      ", 
              RowBox[{"VertexStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], ",", " ", 
              RowBox[{"EdgeStyle", " ", "->", " ", 
               RowBox[{"GrayLevel", "[", " ", ".7", " ", "]"}]}], ",", "\n", 
              "      ", 
              RowBox[{"PlotLabel", " ", "->", " ", 
               RowBox[{"Row", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"\"\<ray length \>\"", ",", " ", "radius"}], " ", 
                 "}"}], " ", "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
            RowBox[{"Join", "[", "\n", "        ", 
             RowBox[{
              RowBox[{"MapThread", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"ray", ",", " ", "color"}], " ", "}"}], " ", "|->", 
                 " ", 
                 RowBox[{"Style", "[", " ", 
                  RowBox[{
