Cell[TextData[{
 "The threshold is exactly 8. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "\[LessEqual]"}], 
    StyleBox["r", "TI"], 
    RowBox[{"\[LessEqual]", "7"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5a35a02e-01a0-431b-b2a5-53c2eae47f9f"],
 ", the neighbours of a total vertex have offsets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["r", "TI"], 
    RowBox[{",", "\[Ellipsis]", ",", 
     RowBox[{"-", "1"}], ",", "1", ",", "\[Ellipsis]", ","}], 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b63a725e-881d-48a7-865f-4320432c1e2e"],
 " along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], "32"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a3fe51c9-1bbe-48bf-885e-dec6e25dbc43"],
 ". These offsets are distinct modulo 16, so each neighbouring base vertex \
has exactly one lift from each total vertex. At radius 8, offsets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "8"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "198bd927-80ff-49f9-9497-89e3cb4f5bed"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "8"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf0d7037-b2a7-47e0-811c-74310a4b91a8"],
 " first coincide modulo 16. In particular, vertices 9 and 25 both lie eight \
steps from vertex 1 and project to base vertex 9. Their two blue edges \
therefore compete to lift the same base edge. The fibers stay discrete at \
these radii; it is uniqueness of transverse lifting that fails. Preservation \
depends on the observation rule, even when the original projection is \
unchanged."
}], "Text",
 CellDingbat->None,ExpressionUUID->"d6ee2004-9575-4324-88cd-305d0dbe243f"],

Cell["A metric identity that does hold at every radius", "Section",ExpressionUUID->"560ff2ca-4566-411b-8000-fb179ec554e0"],

Cell[TextData[{
 "Weak edge lifting has an exact consequence for distance balls. Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], "(", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7579c9b3-5c1b-4588-a8da-61d7ff627cdf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["B", "TI"]], "(", 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["r", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4deb2822-7799-42c4-b856-195c9e0ac722"],
 " be closed graph-distance balls of integer radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[GreaterEqual]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf1dd887-cc71-4855-98c5-1046a1367136"],
 ". Then ",
 ButtonBox["InfraFibrationQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ"],
 " holds exactly when"
}], "Text",
 CellDingbat->None,ExpressionUUID->"f962f5a1-1faf-4321-a5d3-8212c42ca3cb"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3a031255-61b1-40f6-\
ac24-915930c08b51"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef6d3047-ff6e-49d9-a8ae-6a214af1cc3f"],
 " and every such radius. Every total walk projects to a base walk after \
consecutive repetitions are removed, without increasing length, giving the \
forward inclusion. For the reverse inclusion, lift a shortest base walk step \
by step from ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "79978930-302c-455f-ad55-aca737402456"],
 ". Weak edge lifting supplies every step, and the endpoint lies within total \
distance ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "31397eff-4e6a-4dc3-bac9-c98f1db498d8"],
 ". Conversely, equality at radius one supplies a transverse neighbour above \
every base neighbour. Thus a local lifting condition controls all finite \
distance scales, although it does not guarantee unique transport."
}], "Text",
 CellDingbat->None,ExpressionUUID->"3f5c1981-1bdc-4f19-81b6-4f19e0fe5817"],

Cell["\<\
The rows compare square-grid, triangular-tiling and irregular-mesh product \
bundles. Each orange total ball on the left projects onto the orange base \
ball on the right. All three use the same four-cycle fiber and graph-distance \
radius, with centers chosen by GraphCenter. The projection identity holds \
exactly despite the different base connectivity.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"04dfc940-57f7-4a05-9d15-4fcb12692b3f"],

Cell["\<\
The total ball contains some, but not necessarily all, of the states above \
each point of the base ball. Indeed, in these Cartesian products,\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"1ad361e7-6133-4fe2-8fa1-a9a3db557c56"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["E", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["i", "TI"]}], ")"}], ",", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["q", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}]}], ")"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["B", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      StyleBox["q", "TI"]}], ")"}], "+", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["C", "TI"], "4"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a5ab400e-1c86-4327-b8c9-a2e29751a857"],
 "  "
}], "DisplayFormula",ExpressionUUID->"adbc396f-ad5b-4033-8d0e-5d86ef8f85ef"],

Cell[TextData[{
 "Every path must make the required number of moves in each factor, and \
concatenating shortest factor paths attains their sum. At base distance four, \
only the state with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "67c92dc8-d3c7-4739-bfcb-f159aa211dbc"],
 " lies in the radius-four total ball. Closer to the centre, the remaining \
distance budget admits more internal states. The projection forgets this \
difference and fills the whole base ball."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a924cc73-639d-4482-a621-6c59be3c3ca3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
