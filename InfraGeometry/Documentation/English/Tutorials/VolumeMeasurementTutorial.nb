Cell[TextData[{
 "For every undirected graph and integer ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[GreaterEqual]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bcbf696c-a313-4b0a-849e-50d9058e624e"],
 ","
}], "Text",
 CellDingbat->None,ExpressionUUID->"603b2e61-19aa-4e2b-b146-f4e1f87030fa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], 
      RowBox[{"-", "1"}]}]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "\[SubsetEqual]", 
    StyleBox["Int",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "\[SubsetEqual]", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7a43a3ed-ade0-4027-a417-c4d6acb3d509"],
 "  "
}], "DisplayFormula",ExpressionUUID->"bf967b8f-6ddf-45cd-813c-62aaf771bdfb"],

Cell[TextData[{
 "A vertex at distance at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "139eb61b-e318-47a4-8429-80a296c552b0"],
 " has every neighbour at distance at most ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6b5ca688-9792-4c05-bb94-29be8b088de4"],
 ". An outer-layer vertex also belongs to the interior when it has no \
neighbour at distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "73c6ec1d-8683-4601-a1e3-098e9948ee72"],
 ". Thus the interior equals ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], 
     RowBox[{"-", "1"}]}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d4ae06b7-6791-47b1-95c7-66ed6d72eda1"],
 " only when every outer-layer vertex has an outward neighbour. This holds \
for an untruncated square-lattice ball, but it need not hold on a mesh."
}], "Text",
 CellDingbat->None,ExpressionUUID->"7421d881-2b05-4d75-8c06-f781fb2943a9"],

Cell["Tubes and ellipsoids", "Section",ExpressionUUID->"5212da2e-bc30-4fea-98c4-eeaef0955c0d"],

Cell[TextData[{
 "A volume measurement also depends on the region being measured. Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "(", 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["p", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"260eeefc-e7fe-49b5-8bde-fc16aa87ead1"],
 " be the union of shortest paths from ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0ca077ad-aef2-4a52-bb18-881b2bb9be78"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d750f889-e0f7-4c4a-b6c7-2c3ef7052ca0"],
 ", and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["p", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0c3dc81b-bb11-4f1e-a4a8-14573edf5e99"],
 ". The tube ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["s", "TI"]], 
    RowBox[{"(", 
     StyleBox["I", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["I", "TI"]}], ")"}], "\[LessEqual]", 
      StyleBox["s", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"195372f9-f55e-464c-8de9-72b8bbdd00eb"],
 " is contained in the ellipsoid"
}], "Text",
 CellDingbat->None,ExpressionUUID->"35d9336d-88b8-4d38-92e1-527250cfa3ef"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{"2", 
      StyleBox["s", "TI"]}]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["c", "TI"], ",", 
        StyleBox["x", "TI"]}], ")"}], "+", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["p", "TI"]}], ")"}], "\[LessEqual]", 
      StyleBox["n", "TI"], 
      RowBox[{"+", "2"}], 
      StyleBox["s", "TI"]}], "}"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a7b86d71-9217-423d-99e2-3d3e50bddefe"],
 "  "
}], "DisplayFormula",ExpressionUUID->"b62bb9ee-2f42-4191-98ec-ab8d4c757578"],

Cell[TextData[{
 "Indeed, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[Element]", 
    StyleBox["I", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9db34f39-bbbc-4dc7-b8fd-87c4179e056d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fd872b90-269f-4bdd-a571-74fe13c7ee55"],
 ", the triangle inequalities through ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1201f7a1-4367-41e2-bf61-af2ca56d285b"],
 " give ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["x", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["n", "TI"], 
    RowBox[{"+", "2"}], 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "655424aa-c76d-4301-90b2-6b7f25d6351b"],
 ". The pictures show the tube in green, the excess of the ellipsoid in red, \
and the interval in blue. The same six substrates compare the two regions, \
using only graph distance. The endpoint separation and tube thickness are \
chosen in proportion to the graph radius. Each caption reports whether the \
inclusion is strict for the displayed regions."
}], "Text",
 CellDingbat->None,ExpressionUUID->"52cc30fc-a942-4cc0-9282-16189bb20a14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"BlockRandom", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrate", "[", " ", 
              RowBox[{"name", ",", " ", "\"\<Large\>\""}], " ", "]"}], ",", 
             " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"centre", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", 
           " ", 
           RowBox[{"length", " ", "=", " ", 
            RowBox[{"Floor", "[", " ", 
             RowBox[{
              RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", 
              " ", "3"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"endpoint", " ", "=", " ", 
            RowBox[{"RandomInfraPoint", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"InfraShell", "[", " ", 
               RowBox[{"centre", ",", " ", "length"}], " ", "]"}], ",", " ", 
              RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}], 
           ",", "\n", "      ", 
           RowBox[{"thickness", " ", "=", " ", 
            RowBox[{"Ceiling", "[", " ", 
             RowBox[{"length", " ", "/", " ", "2"}], " ", "]"}]}]}], " ", 
          "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"ellipsoid", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", " ", 
              RowBox[{"graph", ",", "\n", "        ", 
               RowBox[{"InfraQuadric", "[", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"centre", ",", " ", "endpoint"}], " ", "}"}], ",", 
                 " ", 
                 RowBox[{"length", " ", "+", " ", 
                  RowBox[{"2", " ", "thickness"}]}]}], " ", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", "\n", 
           "      ", 
           RowBox[{"tube", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", " ", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"InfraTube", "[", " ", 
                RowBox[{
                 RowBox[{"InfraSegment", "[", " ", 
                  RowBox[{"centre", ",", " ", "endpoint"}], " ", "]"}], ",", 
                 " ", "thickness"}], " ", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], " ", "}"}], ",",
          "\n", "    ", 
         RowBox[{"Labeled", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", "\n", "      ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Complement", "[", " ", 
                 RowBox[{"ellipsoid", ",", " ", "tube"}], " ", "]"}], " ", "->",
                 " ", "StandardRed"}], ",", " ", 
               RowBox[{"tube", " ", "->", " ", "StandardGreen"}], ",", "\n", 
               "        ", 
               RowBox[{
                RowBox[{"InfraSegment", "[", " ", 
                 RowBox[{"centre", ",", " ", "endpoint"}], " ", "]"}], " ", "->",
                 " ", "StandardBlue"}]}], " ", "}"}], " ", ",", "\n", 
             "      ", 
             RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
            "\n", "      ", 
           RowBox[{"Column", "[", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"name", ",", " ", 
               RowBox[{"If", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Complement", "[", " ", 
                   RowBox[{"ellipsoid", ",", " ", "tube"}], " ", "]"}], " ", "===",
                   " ", 
                  RowBox[{"{", " ", "}"}]}], ",", 
                 " ", "\"\<tube = ellipsoid\>\"", ",", 
                 " ", "\"\<tube strictly inside ellipsoid\>\""}], " ", 
                "]"}]}], " ", "}"}], ",", "\n", "        ", 
             RowBox[{"Alignment", " ", "->", " ", "Center"}]}], " ", "]"}]}], 
          " ", "]"}]}], " ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", " ", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", " ", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\"", ",", 
           " ", "\"\<SquareMeshGraph\>\"", ",", "\n", 
           "    ", "\"\<SphereMeshGraph\>\"", ",", 
           " ", "\"\<CubeMeshGraph\>\"", ",", 
           " ", "\"\<SierpinskiTriangleGraph\>\""}], " ", "}"}]}], " ", 
        "}"}]}], " ", "]"}], ",", " ", "3"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"91a1c959-e481-48dc-8581-304c1735151a"],

