      RowBox[{"(", 
       RowBox[{
        StyleBox["c", "TI"], ",", 
        StyleBox["p", "TI"]}], ")"}]}], ")"}], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c3045673-f8ab-463f-a3af-9a63eb5889af"],
 "  "
}], "DisplayFormula",ExpressionUUID->"536558f3-9186-4a19-8963-086cdbbb4224"],

Cell[TextData[{
 "This follows by clamping each coordinate of ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8cd94356-4068-4ad1-b7c0-d2413d4aced5"],
 " to the interval between the corresponding coordinates of the endpoints. \
Thus the ellipsoid and tube coincide there. Where red vertices appear, the \
inclusion is strict. The meshes, sphere and fractal show the dependence on \
the substrate."
}], "Text",
 CellDingbat->None,ExpressionUUID->"de04ff19-396c-4f75-bb54-16fb0f83f1bd"],

Cell["An exact rescaling limit", "Section",ExpressionUUID->"729e47bf-ce83-4245-8424-de2238e9b6ff"],

Cell[TextData[{
 "On the square lattice, the shell at distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], 
    RowBox[{"\[GreaterEqual]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75c93fe0-f0a7-41a1-be03-b1ff077460f5"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad2f63af-c14e-40c2-acd3-b22d73905912"],
 " vertices. Hence the closed ball has"
}], "Text",
 CellDingbat->None,ExpressionUUID->"7498d11b-869e-4317-ad41-72e1441a729d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"1", "+"}]}], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{"\[LongEqual]", "1"}]}], 
     StyleBox["r", "TI"],
     LimitsPositioning->True], "4", 
    StyleBox["k", "TI"], 
    RowBox[{"\[LongEqual]", "2"}], 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    RowBox[{"+", "2"}], 
    StyleBox["r", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cb57f3a0-4613-429a-87ae-e8566d45e6d3"],
 "  "
}], "DisplayFormula",ExpressionUUID->"60ad78c1-634a-4975-b7f6-9abcd2b577a9"],

Cell[TextData[{
 "vertices, and its interior has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r", "TI"], 
      RowBox[{"-", "1"}]}], ")"}], 
    RowBox[{"\[LongEqual]", "2"}], 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], 
    RowBox[{"-", "2"}], 
    StyleBox["r", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b8a5d8a4-f952-4948-908f-6f9f16e65a2f"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], 
    RowBox[{"\[GreaterEqual]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f5305afe-be79-4d95-b483-e36fc6a0e62e"],
 ". Give each edge physical length ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "50b2edec-3664-4e9d-9717-502408e57701"],
 " and each vertex area ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d8759fa7-3a18-47de-b78f-274c889c9775"],
 ". At the physical radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R", "TI"], "\[LongEqual]", 
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef26198e-94d1-4606-b911-7ab3a58f8130"],
 " the two masses are"
}], "Text",
 CellDingbat->None,ExpressionUUID->"7857514d-6f9d-4359-824d-3e89cc1f9747"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[Cell[BoxData[
    FormBox[GridBox[{
       {Cell[TextData[{
         " ",
