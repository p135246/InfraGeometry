Notebook[{

Cell[CellGroupData[{
Cell["Volume Measurement", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
When does counting vertices give geometric volume? We compare the count of a \
graph ball with the count of its interior, first on a lattice and then on \
graphs sampled from a continuum. The scale comparison keeps physical radius \
fixed while the graph spacing decreases.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"50316a4e-7df4-4fee-b4a0-d55d1d5caf6e"],

Cell["Two measures of one ball", "Section",ExpressionUUID->"d93dda68-901f-4af2-9176-9d9ba6b671c4"],

Cell[TextData[{
 "For a vertex set ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8fa39049-b5eb-4c92-8d7c-f4739b8c050d"],
 ", its graph boundary ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "781e43f2-c004-4ea9-8866-10c9933cdb88"],
 " consists of vertices in ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3c1ecba-0fff-4b31-93e0-16468150f928"],
 " with a neighbour outside ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1a6a2ff7-39df-48aa-913f-c35e5fe1db8b"],
 ". Its interior is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Int",
     FontSlant->"Plain"], 
    StyleBox["X", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"], 
    RowBox[{"\\", "\[PartialD]"}], 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c693031-82a3-4a43-a4d4-9c810ef2670a"],
 ". ",
 ButtonBox["InfraMeasurement",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement"],
 " gives the counting measure ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["X", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "11bcfc10-1711-48c5-b4e1-975a20436f7c"],
 " and the Riemannian measure ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["Int", FontSlant -> "Plain"], 
       StyleBox["X", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ffb28b28-b950-44b4-bd92-df69d1da0f84"],
 ". They differ by the boundary count."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a909caa5-73e8-4b59-b059-5df62317de8d"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b62cdadf-44e3-4676-8c0c-bf6bafc61823"],

Cell[TextData[{
 "Here the ball is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["r", "TI"]], 
    RowBox[{"(", 
     StyleBox["c", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], ":", 
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["c", "TI"], ",", 
        StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
      StyleBox["r", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fc8366a4-5f6e-4be3-ba9e-4aa5258243b3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a88807f-7e45-4d0e-93da-d7d1dee5139a"],
 " is graph distance. The gallery compares two tilings, a planar mesh, a \
sphere mesh, a spatial mesh and a Sierpinski graph. Each ball has half the \
graph radius, rounded down. The graph constructions use their default \
layouts; no coordinates enter the measurement. The interior is green and the \
boundary blue. Counting includes both colours; the Riemannian measure \
includes only green."
}], "Text",
 CellDingbat->None,ExpressionUUID->"32aada4b-6343-4e62-8d40-6d3950ff6843"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Partition", "[", " ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"BlockRandom", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrate", "[", " ", 
              RowBox[{"name", ",", " ", "\"\<Large\>\""}], " ", "]"}], ",", 
             " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"centre", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", 
           " ", 
           RowBox[{"radius", " ", "=", " ", 
            RowBox[{"Floor", "[", " ", 
             RowBox[{
              RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", 
              " ", "2"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{"vertices", " ", "=", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"InfraBall", "[", " ", 
               RowBox[{"centre", ",", " ", "radius"}], " ", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",",
          "\n", "    ", 
         RowBox[{"Labeled", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", "\n", "      ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"InfraInterior", "[", " ", 
                 RowBox[{"graph", ",", " ", "vertices"}], " ", "]"}], " ", "->",
                 " ", "StandardGreen"}], ",", " ", 
               RowBox[{
                RowBox[{"InfraBoundary", "[", " ", 
                 RowBox[{"graph", ",", " ", "vertices"}], " ", "]"}], " ", "->",
                 " ", "StandardBlue"}]}], " ", "}"}], " ", ",", "\n", 
             "      ", 
             RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
            " ", "name"}], " ", "]"}]}], " ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", " ", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", " ", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\"", ",", 
           " ", "\"\<SquareMeshGraph\>\"", ",", "\n", 
           "    ", "\"\<SphereMeshGraph\>\"", ",", 
           " ", "\"\<CubeMeshGraph\>\"", ",", 
           " ", "\"\<SierpinskiTriangleGraph\>\""}], " ", "}"}]}], " ", 
        "}"}]}], " ", "]"}], ",", " ", "3"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"965846f7-bfc1-4adc-920c-6950e2d8dc1c"],

