Cell[TextData[{
 "Each vertex is drawn with its nearest-point cell. Green cells belong to \
interior vertices and blue cells to boundary vertices; the red circle is the \
reference disk. The cells show the sampling scale; each vertex still receives \
mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/"}], 
    StyleBox["N", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "009b3e5d-5981-418d-93f9-6e84051aa0eb"],
 ", not the area of its drawn cell. The plot compares the two counts with the \
disk area, so agreement would put both curves on the horizontal line at one."
}], "Text",
 CellDingbat->None,ExpressionUUID->"bcdc92b7-237c-40e9-89a8-961c0315b1e6"],

