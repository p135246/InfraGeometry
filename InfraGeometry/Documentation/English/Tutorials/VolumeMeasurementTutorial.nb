Cell[TextData[{
 "Both converge to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["R", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"46741ae5-ef35-4b28-8877-1ba1392e24d0"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"\[Rule]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"50abab1c-0301-43a9-ab83-09bf8f96bc62"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40204e6f-a7e5-42fe-a9c9-52987a9ec306"],
 " fixed. This is the area of the taxicab ball ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["x", "TI"], 
    RowBox[{"|", 
     RowBox[{"+", "|"}]}], 
    StyleBox["y", "TI"], 
    RowBox[{"|", "\[LessEqual]"}], 
    StyleBox["R", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5de29371-9be4-4176-b1fa-4967e0af49e5"],
 ". Refining ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "45a9fb35-9c14-4676-b19d-e4b802a5898c"],
 " by a factor ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad8c1583-c8c6-48ec-a1f3-552420b0c801"],
 " and multiplying ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ed251f2-bf89-4485-b166-1c978bb0b6b1"],
 " by ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fb560b4b-6de3-45b4-9f94-aa243a576586"],
 " preserves this area; the linear error shrinks by ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b876ef87-a6ee-4ac7-97b7-e0f4bd8f36ad"],
 " and the quadratic error by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["b", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"35c98f99-f38f-4aad-8c66-6f44f73b8db2"],
 ". The limiting geometry retains its diamond-shaped balls."
}], "Text",
 CellDingbat->None,ExpressionUUID->"465c2bb6-5628-4b89-a4c1-5407b3252642"],

Cell[TextData[{
 "The top row keeps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R", "TI"], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"1", "/", "4"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b2606a4f-1d34-4bee-a2b1-cde53eb99443"],
 " fixed while refining the lattice; the red diamond is unchanged. Each \
finite grid includes an extra layer beyond the measured ball. Below each \
graph, the two area profiles are compared with the red continuum curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["R", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fc22741c-5206-4531-82bb-98f91d4a417a"],
 ". The blue and green curves close around it as the lattice refines. The \
dashed gray curve assigns full weight to interior vertices and half weight to \
boundary vertices. It is the mean of the two measured profiles."
}], "Text",
 CellDingbat->None,ExpressionUUID->"123f4a5c-43ed-4ba7-8096-d97bad7fbde2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{
   RowBox[{"Transpose", "[", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"spacing", " ", "=", " ", 
          RowBox[{"1", " ", "/", " ", 
           RowBox[{"(", " ", 
            RowBox[{"4", " ", "radius"}], " ", ")"}]}]}], " ", "}"}], ",", 
        "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"graph", " ", "=", " ", 
          RowBox[{"GridGraph", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"2", " ", "radius"}], " ", "+", " ", "3"}], ",", " ", 
              RowBox[{
               RowBox[{"2", " ", "radius"}], " ", "+", " ", "3"}]}], " ", 
             "}"}], ",", " ", 
            RowBox[{"Sequence", " ", "@@", " ", 
             RowBox[{
             "InfraSubstrateStyle", "[", " ", "\"\<Large\>\"", " ", "]"}]}], ",",
             "\n", "        ", 
            RowBox[{"VertexCoordinates", " ", "->", " ", 
             RowBox[{"spacing", " ", 
              RowBox[{"Tuples", "[", " ", 
               RowBox[{
                RowBox[{"Range", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "radius"}], " ", "-", " ", "1"}], ",", " ", 
                  RowBox[{"radius", " ", "+", " ", "1"}]}], " ", "]"}], ",", 
                " ", "2"}], " ", "]"}]}]}]}], " ", "]"}]}], " ", "}"}], ",", 
        "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{"centre", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"ball", " ", "=", " ", 
           RowBox[{"InfraBall", "[", " ", 
            RowBox[{"centre", ",", " ", "radius"}], " ", "]"}]}], ",", " ", 
          RowBox[{"regions", " ", "=", " ", 
           RowBox[{"Table", "[", " ", 
            RowBox[{
             RowBox[{"InfraBall", "[", " ", 
              RowBox[{"centre", ",", " ", "r"}], " ", "]"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"r", ",", " ", "1", ",", " ", "radius"}], " ", "}"}]}], 
            " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"vertices", " ", "=", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{
             "graph", ",", " ", "ball", ",", " ", "\"\<VertexDensity\>\""}], 
             " ", "]"}]}]}], ",", "\n", "      ", 
          RowBox[{"profiles", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"measure", " ", "|->", " ", 
              RowBox[{
               RowBox[{"spacing", "^", "2"}], " ", 
               RowBox[{"InfraMeasurement", "[", " ", 
                RowBox[{"graph", ",", " ", "regions", ",", " ", "measure"}], 
                " ", "]"}]}]}], ",", "\n", "        ", 
             RowBox[{"{", " ", 
              
              RowBox[{"\"\<CountingMeasure\>\"", ",", 
               " ", "\"\<RiemannianMeasure\>\""}], " ", "}"}]}], " ", 
            "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"Labeled", "[", " ", 
           RowBox[{
            RowBox[{"InfraSubstrateHighlight", "[", " ", 
             RowBox[{"graph", ",", "\n", "        ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"InfraInterior", "[", " ", 
                  RowBox[{"graph", ",", " ", "vertices"}], " ", "]"}], " ", "->",
                  " ", "StandardGreen"}], ",", " ", 
                RowBox[{
                 RowBox[{"InfraBoundary", "[", " ", 
                  RowBox[{"graph", ",", " ", "vertices"}], " ", "]"}], " ", "->",
                  " ", "StandardBlue"}]}], " ", "}"}], ",", "\n", "        ", 
              
              RowBox[{"Epilog", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"StandardRed", ",", " ", 
                 RowBox[{"AbsoluteThickness", "[", " ", "1.5", " ", "]"}], ",",
                  "\n", "          ", 
                 RowBox[{"Line", "[", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{
                    RowBox[{"{", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "4"}], ",", " ", "0"}], " ", "}"}], ",",
                     " ", 
                    RowBox[{"{", " ", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"1", "/", "4"}]}], " ", "}"}], ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "4"}], ",", " ", "0"}], " ", 
                    "}"}], ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "4"}]}], " ", "}"}], ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{
                    RowBox[{"1", "/", "4"}], ",", " ", "0"}], " ", "}"}]}], 
                   " ", "}"}], " ", "]"}]}], " ", "}"}]}], ",", "\n", 
              "        ", 
              RowBox[{"PlotRange", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "3"}], "/", "8"}], ",", " ", 
                   RowBox[{"3", "/", "8"}]}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "3"}], "/", "8"}], ",", " ", 
                   RowBox[{"3", "/", "8"}]}], " ", "}"}]}], " ", "}"}]}], " ",
               ",", "\n", "      ", 
              RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
             " ", 
            RowBox[{"Row", "[", " ", 
             RowBox[{"{", " ", 
              RowBox[{"\"\<r = \>\"", ",", " ", "radius"}], " ", "}"}], " ", 
             "]"}]}], " ", "]"}], ",", "\n", "      ", 
          RowBox[{"Show", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"ListLinePlot", "[", " ", 
             RowBox[{
              RowBox[{"Map", "[", " ", 
               RowBox[{
                RowBox[{"values", " ", "|->", " ", 
                 RowBox[{"Transpose", "[", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{
                    RowBox[{"spacing", " ", 
                    RowBox[{"Range", "[", " ", "radius", " ", "]"}]}], ",", 
                    " ", "values"}], " ", "}"}], " ", "]"}]}], ",", " ", 
                RowBox[{"Append", "[", " ", 
                 RowBox[{"profiles", ",", " ", 
                  RowBox[{"Mean", "[", " ", "profiles", " ", "]"}]}], " ", 
                 "]"}]}], " ", "]"}], ",", "\n", "          ", 
              RowBox[{"PlotStyle", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"StandardBlue", ",", " ", "StandardGreen", ",", " ", 
                 RowBox[{"Directive", "[", " ", 
                  RowBox[{"StandardGray", ",", " ", "Dashed"}], " ", "]"}]}], 
                " ", "}"}]}], ",", " ", 
              RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n",
               "          ", 
              RowBox[{"PlotLegends", " ", "->", " ", 
               RowBox[{"{", " ", 
                
                RowBox[{"\"\<counting\>\"", ",", " ", "\"\<interior\>\"", ",",
                  " ", "\"\<half boundary\>\""}], " ", "}"}]}], ",", " ", 
              RowBox[{"AxesLabel", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{"\"\<R\>\"", ",", " ", "\"\<area\>\""}], " ", "}"}]}],
               ",", "\n", "          ", 
              RowBox[{"PlotRange", " ", "->", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"1", "/", "4"}]}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"1", "/", "5"}]}], " ", "}"}]}], " ", "}"}]}]}], 
             " ", "]"}], ",", "\n", "        ", 
            RowBox[{"Plot", "[", " ", 
             RowBox[{
              RowBox[{"2", " ", 
               RowBox[{"physicalRadius", "^", "2"}]}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{"physicalRadius", ",", " ", "0", ",", " ", 
                RowBox[{"1", "/", "4"}]}], " ", "}"}], ",", " ", 
              RowBox[{"PlotStyle", " ", "->", " ", "StandardRed"}]}], " ", 
             "]"}]}], " ", "]"}]}], " ", "}"}]}], " ", "]"}], ",", "\n", "  ", 
      RowBox[{"{", " ", 
       RowBox[{"radius", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"4", ",", " ", "8", ",", " ", "16"}], " ", "}"}]}], " ", 
       "}"}]}], " ", "]"}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c0f9e78b-1e8a-4d2d-a12d-3de922ec4426"],

