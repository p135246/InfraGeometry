Cell["\<\
The gap between the curves narrows, and both remain below the reference disk \
area. The finite samples illustrate agreement of the two conventions but do \
not establish the volume limit.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"8b6a744f-26f7-49cb-a36b-9a5eb0058e5f"],

Cell["Why both measures can converge", "Section",ExpressionUUID->"f8611f02-b0ca-4323-a4bb-21d2eed8074d"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6064c2a3-3fac-43f9-9ac1-4f85cbab14b8"],
 " be a compact connected Riemannian manifold without boundary, with distance \
",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5e7ad3a8-c6ec-4182-8135-b074f3ebd664"],
 " and normalized volume ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "23ec96bf-f603-4b20-aa76-307b2abc7257"],
 ". Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["N", "TI"]], "\[Subset]", 
    StyleBox["M", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fcadbe2f-dabe-44fe-8558-8795c608756d"],
 " be a sample of ",
 Cell[BoxData[
  FormBox[
   StyleBox["N", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de9179c4-f6ad-4a1c-ae42-d19de89ec461"],
 " vertices, with mesh"
}], "Text",
 CellDingbat->None,ExpressionUUID->"b95963a7-f95e-4fc8-93ed-82d371146bb5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    UnderscriptBox["sup", 
     RowBox[{
      StyleBox["x", "TI"], "\[Element]", 
      StyleBox["M", "TI"]}],
     LimitsPositioning->True], 
    UnderscriptBox["min", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      SubscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["N", "TI"]]}],
     LimitsPositioning->True], 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"88f30a91-67ee-4fa4-98b7-cc0d2fead35e"],
 "  "
}], "DisplayFormula",ExpressionUUID->"e0abafae-6830-4637-a29b-ce91327a0392"],

Cell[TextData[{
 "Join two vertices when their distance is less than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2fc80d30-1ca8-4302-9fce-cb5bc23aff45"],
 ", and write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab7c3e62-a6e6-46b8-bb25-1f1f7aaeae41"],
 " for graph distance. Assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], 
    RowBox[{"\[Rule]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f051b37e-7116-4798-a57e-819d354fbe3c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]], "/", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], 
    RowBox[{"\[Rule]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6ff9300-dc72-418b-8e66-480fd82d552f"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]], "<", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6444b38-eb3c-4ee9-9410-769972f520c1"],
 ","
}], "Text",
 CellDingbat->None,ExpressionUUID->"a5c2f3da-f55b-400d-ae02-878074cdd94b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["N", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    FractionBox[
     SubscriptBox["\[Epsilon]", 
      StyleBox["N", "TI"]], 
     RowBox[{
      SubscriptBox["\[Epsilon]", 
       StyleBox["N", "TI"]], 
      RowBox[{"-", "2"}], 
      SubscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["N", "TI"]]}]], 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "+", 
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f408c02-b726-4a41-b2cb-aaaa3894d250"],
 "  "
}], "DisplayFormula",ExpressionUUID->"55798abc-c251-4867-b761-a106a27b426a"],

Cell[TextData[{
 "The first inequality adds the lengths of the graph edges. For the second, \
divide a minimizing geodesic into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        StyleBox["v", "TI"]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Epsilon]", 
         StyleBox["N", "TI"]], 
        RowBox[{"-", "2"}], 
        SubscriptBox[
         StyleBox["h", "TI"], 
         StyleBox["N", "TI"]]}], ")"}]}], "\[RightFloor]"}], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "542e2eeb-3a47-40d2-a7f1-69150390eeb7"],
 " equal pieces. Each piece is shorter than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], 
    RowBox[{"-", "2"}], 
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"89230fde-5f66-4226-83d4-20b28aca2670"],
 ". Replace each internal subdivision point by a sample point within ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6e02e48a-26c5-4e56-8850-e89be07e8bf7"],
 ", keeping the two endpoints. Delete consecutive repetitions among the \
chosen sample points. Successive remaining points are adjacent. The resulting \
number of edges is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Epsilon]", 
       StyleBox["N", "TI"]], 
      RowBox[{"-", "2"}], 
      SubscriptBox[
       StyleBox["h", "TI"], 
       StyleBox["N", "TI"]]}], ")"}], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e45388ae-82b1-4d21-83f4-5122525757f6"],
 ". The scaled graph distance therefore converges uniformly to ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99daef33-8e23-4021-bf97-6a02bd7b3e8e"],
 " on sampled pairs."
}], "Text",
 CellDingbat->None,ExpressionUUID->"4a0bc007-93c8-44dc-abd1-424d6e0e9b17"],

Cell[TextData[{
 "Distance convergence alone does not identify volume. Also assume that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Nu]", 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["N", "TI"], 
     RowBox[{"-", "1"}]], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      SubscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["N", "TI"]]}],
     LimitsPositioning->True], 
    SubscriptBox["\[Delta]", 
     StyleBox["v", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ae67db03-1f82-4cb8-ae24-a9a336bf8a5a"],
 " converges weakly to ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f161ed6c-aa8f-4fa3-933e-e03c1a1c7118"],
 ". A dense sample concentrated in one region can violate this assumption."
}], "Text",
 CellDingbat->None,ExpressionUUID->"e8f873f4-6536-415a-94ae-6461c770a923"],

Cell[TextData[{
 "Choose centres ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["N", "TI"]], "\[Element]", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["N", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"90c2d33c-eb63-4496-b953-8fa1faad370f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["N", "TI"]], "\[Rule]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b8076778-28e7-4bc7-8978-0925ac0bcc54"],
 " and integers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4dcc3d4e-a8ef-4bfc-9071-dee4c4f3a2d5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", 
     StyleBox["N", "TI"]], 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["N", "TI"]], "\[Rule]", 
    StyleBox["R", "TI"], 
    RowBox[{">", "0"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d1e77805-a162-44d8-9fc8-982d5d86d177"],
 ". Assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{"\[PartialD]", 
      SubscriptBox[
       StyleBox["B", "TI"], 
       StyleBox["R", "TI"]], 
      RowBox[{"(", 
       StyleBox["c", "TI"], ")"}]}], ")"}], 
    RowBox[{"\[LongEqual]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dc1d5546-4cee-4a7e-8907-815be636b503"],
 ". The distance bound places both graph balls ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     SubscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["N", "TI"]]], "(", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["N", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"04573bac-84be-4e82-b795-33361db4596f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["N", "TI"]], 
      RowBox[{"-", "1"}]}]], "(", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["N", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6c2ed238-7463-48c3-9067-89bd7d384280"],
 " between sampled metric balls whose radii tend to ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "92bd6df7-38a6-4aa0-8b99-4cac988f3e46"],
 ". Weak convergence and the zero boundary volume give"
}], "Text",
 CellDingbat->None,ExpressionUUID->"22107b6d-b692-40b7-99df-5d9848b99831"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["B", "TI"], 
           SubscriptBox[
            StyleBox["r", "TI"], 
            StyleBox["N", "TI"]]], 
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["N", "TI"]], ")"}]}]},
       "Abs"], 
      StyleBox["N", "TI"]], 
     RowBox[{"\[LongRightArrow]", "\[Mu]"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["R", "TI"]], "(", 
       StyleBox["c", "TI"], ")"}], ")"}]}], ",", "    ", 
    RowBox[{
     FractionBox[
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["B", "TI"], 
           RowBox[{
             SubscriptBox[
              StyleBox["r", "TI"], 
              StyleBox["N", "TI"]], "-1"}]], 
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["N", "TI"]], ")"}]}]},
       "Abs"], 
      StyleBox["N", "TI"]], 
     RowBox[{"\[LongRightArrow]", "\[Mu]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["B", "TI"], 
         StyleBox["R", "TI"]], "(", 
        StyleBox["c", "TI"], ")"}], ")"}], "."}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6f35f88f-b6aa-44c1-af9a-7c1fbb63e212"],
 "  "
}], "DisplayFormula",ExpressionUUID->"eb833aa8-e1f9-45c9-b113-278fef5d2ede"],

Cell["\<\
The interior lies between these two graph balls, so its normalized count has \
the same limit. This proves agreement under the stated distance and sampling \
assumptions. It does not require the interior to equal the ball one radius \
earlier.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"1cd87604-b1c4-4a5e-994d-a9c6d5f733c0"],

Cell["Consequence for dimension", "Section",ExpressionUUID->"dea89b63-9fed-4a01-b209-bbed641c6277"],

Cell["For positive radii, define", "Text",
 CellDingbat->None,ExpressionUUID->"84cbe07c-d310-46ee-8c42-a454f8540412"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{"log", 
      StyleBox["V", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["r", "TI"], 
        RowBox[{"+", "1"}]}], ")"}], 
      RowBox[{"-", "log"}], 
      StyleBox["V", "TI"], 
      RowBox[{"(", 
       StyleBox["r", "TI"], ")"}]}], 
     RowBox[{"log", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["r", "TI"], 
        RowBox[{"+", "1"}]}], ")"}], 
      RowBox[{"-", "log"}], 
      StyleBox["r", "TI"]}]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cae1a3a2-c920-45f3-9f53-26a00124b322"],
 "  "
}], "DisplayFormula",ExpressionUUID->"2f423bbe-06e7-4302-989f-dba59e56fbd9"],

Cell[TextData[{
 "On the square lattice, substituting the two polynomials gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"2", "-", 
      RowBox[{"1", "/"}]}]}], 
    StyleBox["r", "TI"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["r", "TI"], 
      RowBox[{"-", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6b40eb77-442a-40e0-a7f6-07b997419b01"],
 " for counting and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}], 
    RowBox[{"\[LongEqual]", 
     RowBox[{"2", "+", 
      RowBox[{"1", "/"}]}]}], 
    StyleBox["r", "TI"], "+", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["r", "TI"], 
      RowBox[{"-", "2"}]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d36fc91a-7d60-4bca-969d-4cdf70d93adf"],
 " for the interior. Both read dimension two when many graph layers are \
resolved. Their difference at small radii comes from the boundary \
convention."
}], "Text",
 CellDingbat->None,ExpressionUUID->"5de81710-bf2e-4acd-929a-cd281830a7b3"],

Cell[TextData[{
 ButtonBox["LogDifferenceQuotients",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients"], 
    None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients"],
 " assigns radii one, two, and so on to its input list. The profiles below \
therefore start at radius one."
}], "Text",
 CellDingbat->None,ExpressionUUID->"8a6a2a61-e3c9-4f18-84ff-65ef182cd5ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"GridGraph", "[", " ", 
      RowBox[{"{", " ", 
       RowBox[{"41", ",", " ", "41"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"regions", " ", "=", " ", 
     RowBox[{"Table", "[", " ", 
      RowBox[{
       RowBox[{"InfraBall", "[", " ", 
        RowBox[{"centre", ",", " ", "r"}], " ", "]"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"r", ",", " ", "1", ",", " ", "18"}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"measure", " ", "|->", " ", 
        RowBox[{"LogDifferenceQuotients", "[", " ", 
         RowBox[{"InfraMeasurement", "[", " ", 
          RowBox[{"graph", ",", " ", "regions", ",", " ", "measure"}], " ", 
          "]"}], " ", "]"}]}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<CountingMeasure\>\"", ",", 
         " ", "\"\<RiemannianMeasure\>\""}], " ", "}"}]}], " ", "]"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<counting\>\"", ",", " ", "\"\<Riemannian\>\""}], " ", 
       "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<dimension\>\""}], " ", "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", " ", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], " ", "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "700"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"0833fdb9-0376-4512-a9d5-840fcf4b694c"],

