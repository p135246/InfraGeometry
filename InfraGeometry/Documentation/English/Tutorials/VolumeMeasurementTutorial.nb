Cell[TextData[{
 "The gap between the two masses is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    StyleBox["a", "TI"], 
    StyleBox["R", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4f5f8cb4-f1e0-49ca-b456-9be1e6cccd9e"],
 ", the area assigned to one graph layer. Their mean satisfies"
}], "Text",
 CellDingbat->None,ExpressionUUID->"0c94d108-0e93-423d-8bad-e8eef1362b62"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], "2"], "(", 
      TemplateBox[{
        RowBox[{
          StyleBox["Int", FontSlant -> "Plain"], 
          SubscriptBox[
           StyleBox["B", "TI"], 
           StyleBox["r", "TI"]], "|+", 
          FractionBox["1", "2"], "|\[PartialD]", 
          SubscriptBox[
           StyleBox["B", "TI"], 
           StyleBox["r", "TI"]]}]},
       "Abs"], ")"}], 
     RowBox[{"\[LongEqual]", "2"}], 
     SuperscriptBox[
      StyleBox["R", "TI"], "2"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "."}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9de52504-02c9-43ea-a6a6-f9fce297cd62"],
 "  "
}], "DisplayFormula",ExpressionUUID->"44a54af8-b878-4f23-a9c3-754f3586b10f"],

Cell[TextData[{
 "Thus half weight on the boundary removes the first-order error for these \
square-lattice balls. At fixed ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0b76809-25b2-47e2-931c-2feea648e259"],
 ", halving the spacing divides the remaining error by four. No such \
cancellation has been established here for an arbitrary mesh."
}], "Text",
 CellDingbat->None,ExpressionUUID->"cb5b4818-f0aa-40a6-bd72-57dff6710b09"],

Cell["A sampled disk at three resolutions", "Section",ExpressionUUID->"3602ad1d-8623-4c94-a82c-6a8f421719de"],

Cell[TextData[{
 "Sample the unit square uniformly and join points within ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Epsilon]", "\[LongEqual]"}], 
    SuperscriptBox[
     StyleBox["N", "TI"], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6145b5bd-4e79-464f-95aa-3a83ce81ae61"],
 ". Use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "\[LongEqual]", 
    StyleBox[
     RowBox[{"R", "o", "u", "n", "d"}], "TI"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], "/", "\[Epsilon]"}], ")"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3bd052b5-4dcf-412e-8410-f97e7bbd163e"],
 " and compare the graph ball with the disk of radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["N", "TI"]], 
    RowBox[{"\[LongEqual]", "\[Epsilon]"}], 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3284bad6-8155-4646-b607-bca7b134c223"],
 " about the chosen centre. The prescribed edge scale supplies the length \
unit. There is no fitted hop length. The convergence argument below applies \
inside this convex domain when the reference disk stays inside the square."
}], "Text",
 CellDingbat->None,ExpressionUUID->"60f5b37b-2a91-44d0-93c0-2e6cb4205955"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ripsVolumes", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"points", " ", "=", " ", 
          RowBox[{"BlockRandom", "[", " ", 
           RowBox[{
            RowBox[{"RandomPoint", "[", " ", 
             RowBox[{
              RowBox[{"Rectangle", "[", "]"}], ",", " ", "count"}], " ", 
             "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], ",",
          "\n", "      ", 
         RowBox[{"epsilon", " ", "=", " ", 
          RowBox[{"count", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "3"}], ")"}]}]}]}], " ", "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"graph", " ", "=", " ", 
          RowBox[{"NearestNeighborGraph", "[", " ", 
           RowBox[{"points", ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{"All", ",", " ", "epsilon"}], " ", "}"}]}], " ", "]"}]}],
          ",", " ", 
         RowBox[{"nearest", " ", "=", " ", 
          RowBox[{"Nearest", "[", " ", "points", " ", "]"}]}], ",", "\n", 
         "      ", 
         RowBox[{"centre", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Nearest", "[", " ", 
            RowBox[{"points", ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"1", "/", "2"}], ",", " ", 
               RowBox[{"1", "/", "2"}]}], " ", "}"}]}], " ", "]"}]}]}], ",", 
         " ", 
         RowBox[{"radius", " ", "=", " ", 
          RowBox[{"Round", "[", " ", 
           RowBox[{
            RowBox[{"(", " ", 
             RowBox[{"1", "/", "4"}], " ", ")"}], " ", "/", " ", "epsilon"}], 
           " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"ball", " ", "=", " ", 
         RowBox[{"InfraBall", "[", " ", 
          RowBox[{"centre", ",", " ", "radius"}], " ", "]"}]}], " ", "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"vertices", " ", "=", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", " ", 
           RowBox[{
           "graph", ",", " ", "ball", ",", " ", "\"\<VertexDensity\>\""}], 
           " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"interior", " ", "=", " ", 
         RowBox[{"InfraInterior", "[", " ", 
          RowBox[{"graph", ",", " ", "vertices"}], " ", "]"}]}], " ", "}"}], ",",
        "\n", "    ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"\"\<N\>\"", " ", "->", " ", "count"}], ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"epsilon", " ", "radius"}]}], ",", "\n", "      ", 
         RowBox[{"\"\<Counting\>\"", " ", "->", " ", 
          RowBox[{"N", "[", " ", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{
