            1, Rational[-1, 64] Rational[127, 3]^Rational[1, 2]}}, {{
            0, -0.1016626109163705}, {1, -0.1016626109163705}}]], 
         LineBox[
          
          NCache[{{0, Rational[1, 64] Rational[127, 3]^Rational[1, 2]}, {
            1, Rational[1, 64] Rational[127, 3]^Rational[1, 2]}}, {{
            0, 0.1016626109163705}, {1, 0.1016626109163705}}]]},
       FormatType->TraditionalForm,
       FrameTicks->None,
       PlotRange->NCache[{{0, 1}, {
           Rational[-1, 2], 
           Rational[1, 2]}}, {{0, 1}, {-0.5, 0.5}}]], 
      TemplateBox[{"\"n = \"", "32", "\", strip mass at least 3/4\""},
       "RowDefault"], Bottom], {483.75, -103.25}, {Center, Center}, {180., 193.},
     
     BaseStyle->{Graphics3DBoxOptions -> {SphericalRegion -> False}}]}, {}},
  ImageSize->1000,
  Method->{"IgnoreImageSizeAutomaticLimit" -> True},
  PlotRange->{{0, 580.5}, {-206.5, 0}},
  PlotRangePadding->Automatic]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"01a8e01d-9112-479d-a6d6-deb1ba0ca273"]
}, Open  ]],

Cell["Why the breadth vanishes", "Section",ExpressionUUID->"91e3fdf1-6a2e-481e-b8d1-f5a3e63ce96e"],

Cell[TextData[{
 "Choose one of the paths uniformly and write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c93649ad-a8d9-4434-b19d-8222c5a2eeb4"],
 " for its number of vertical steps minus horizontal steps after ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a624978-53d1-43d0-aa22-e27c8be9d152"],
 " steps. The vertical-step count is hypergeometric, because the ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a105148a-566f-45df-b9dc-61b8d78d3a07"],
 " vertical steps occupy a uniformly chosen subset of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "365a7c2f-358a-4c45-b583-2842a55111d7"],
 " positions. Consequently,"
}], "Text",
 CellDingbat->None,ExpressionUUID->"dead3b7e-df19-4f4d-8d42-6600fb4c3acb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], 
     RowBox[{"\[LongEqual]", "0"}]}], ",", "    ", 
    RowBox[{
     RowBox[{
      StyleBox["E",
       FontSlant->"Plain"], 
      SubsuperscriptBox[
       StyleBox["S", "TI"], 
       StyleBox["k", "TI"], "2"]}], "\[LongEqual]", 
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["k", "TI"], "(", 
        RowBox[{"2", 
         StyleBox["n", "TI"], "-", 
         StyleBox["k", "TI"]}], ")"}], 
       RowBox[{"2", 
        StyleBox["n", "TI"], 
        RowBox[{"-", "1"}]}]], "."}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"240c0e61-8d89-4ec0-8867-297d89be37d0"],
 "  "
}], "DisplayFormula",ExpressionUUID->"234491a0-4495-4158-9ef6-e13086898adb"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{"+", "1"}]}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{"+", "1"}]}]], "-", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"\[Element]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0e3ba5d4-c7d3-46c6-9bc2-bb3222e413c5"],
 ". Given ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad03c393-3de0-43b9-befe-51db6b929ede"],
 ", the mean next increment is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["k", "TI"]], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b7161576-f244-4cce-942e-432f0c370b99"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["S", "TI"], 
       StyleBox["k", "TI"]], 
      SubscriptBox["\[Xi]", 
       RowBox[{
        StyleBox["k", "TI"], 
        RowBox[{"+", "1"}]}]]}], ")"}], 
    RowBox[{"\[LongEqual]", "-"}], 
    StyleBox["k", "TI"], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["n", "TI"], 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a0175607-2e4f-4a4c-89fc-e87fae7fefc6"],
 ". The midpoint of edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7b5c7c88-2c1b-4f25-81b8-63f984578198"],
 " has coordinates"
}], "Text",
 CellDingbat->None,ExpressionUUID->"68a3e576-113d-45d8-8ff7-cacb9d2fc609"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["X", "TI"], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       StyleBox["k", "TI"], 
       RowBox[{
        RowBox[{"+", "1"}], "/", "2"}]}], 
      RowBox[{"2", 
       StyleBox["n", "TI"]}]]}], ",", "    ", 
    RowBox[{
     StyleBox["Y", "TI"], "\[LongEqual]", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox[
         StyleBox["S", "TI"], 
         StyleBox["k", "TI"]], "+", 
        SubscriptBox["\[Xi]", 
         RowBox[{
          StyleBox["k", "TI"], 
          RowBox[{"+", "1"}]}]], 
        RowBox[{"/", "2"}]}], 
       RowBox[{"2", 
        StyleBox["n", "TI"]}]], "."}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4d529969-c344-457e-8f27-7eff1eb80f45"],
 "  "
}], "DisplayFormula",ExpressionUUID->"fb56921b-2990-4c16-98f8-0539bbcf4935"],

Cell[TextData[{
 "Uniform edge choice makes ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5dd42d85-3817-4145-9b52-5bc485f23e19"],
 " uniform on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0", ",", "\[Ellipsis]", ",", "2"}], 
     StyleBox["n", "TI"], 
     RowBox[{"-", "1"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad6efc3b-2668-42ab-a1d5-923083a75498"],
 ". The second moment average is"
}], "Text",
 CellDingbat->None,ExpressionUUID->"7c46252b-3f13-4d51-93f1-000ab5d8c0c7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["Y", "TI"], "2"], "\[LongEqual]", 
    FractionBox["1", 
     RowBox[{"2", 
      StyleBox["n", "TI"]}]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{"\[LongEqual]", "0"}]}], 
     RowBox[{"2", 
      StyleBox["n", "TI"], 
      RowBox[{"-", "1"}]}],
     LimitsPositioning->True], 
    FractionBox[
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{"(", 
       RowBox[{"2", 
        StyleBox["n", "TI"], "-", 
        StyleBox["k", "TI"], 
        RowBox[{"-", "1"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        StyleBox["n", "TI"], 
        RowBox[{"-", "1"}]}], ")"}], 
      RowBox[{
       RowBox[{"+", "1"}], "/", "4"}]}], 
     RowBox[{"4", 
      SuperscriptBox[
       StyleBox["n", "TI"], "2"]}]], "\[LongEqual]", 
    FractionBox[
     RowBox[{"4", 
      StyleBox["n", "TI"], 
      RowBox[{"-", "1"}]}], 
     RowBox[{"48", 
      SuperscriptBox[
       StyleBox["n", "TI"], "2"]}]], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ad579e69-2e5c-4213-9e01-4c18c2e6a15f"],
 "  "
}], "DisplayFormula",ExpressionUUID->"8d7fae05-e65b-4b07-aebf-c769a8c2e81f"],

Cell["Chebyshev's inequality gives", "Text",
 CellDingbat->None,ExpressionUUID->"9d9d9ec2-6f2d-4a41-acdf-447b1df2d2cf"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Pr", 
    RowBox[{"(", 
     RowBox[{"|", 
      StyleBox["Y", "TI"], 
      RowBox[{"|>", "\[Delta]"}]}], ")"}], "\[LessEqual]", 
    FractionBox[
     RowBox[{"4", 
      StyleBox["n", "TI"], 
      RowBox[{"-", "1"}]}], 
     RowBox[{"48", 
      SuperscriptBox[
       StyleBox["n", "TI"], "2"], 
      SuperscriptBox["\[Delta]", "2"]}]], "<", 
    FractionBox["1", 
     RowBox[{"12", 
      StyleBox["n", "TI"], 
      SuperscriptBox["\[Delta]", "2"]}]], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f77aab68-5a77-4ba4-bb5c-1ef594ac48a7"],
 "  "
}], "DisplayFormula",ExpressionUUID->"1b5609b9-232f-4192-bea5-d095d4a2923d"],

Cell[TextData[{
 "For each fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", ">", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2cc945e7-cb6a-4293-bf03-ac01f46f1a14"],
 ", this bound tends to zero. Taking ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "\[LongEqual]", "2"}], 
    SqrtBox[
     RowBox[{
      StyleBox["E",
       FontSlant->"Plain"], 
      SuperscriptBox[
       StyleBox["Y", "TI"], "2"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"73001ff9-ff60-4752-8afa-82db318f8816"],
 " instead gives the three-quarter mass guarantee for the shrinking strips in \
the figure. For continuous ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0bb8c79f-5f42-42c4-af0a-49dbfa8c334a"],
 ", uniform continuity on the fixed aligned square then gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Y", "TI"]}], ")"}], "-", 
    StyleBox["E",
     FontSlant->"Plain"], 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["X", "TI"], 
      RowBox[{",", "0"}]}], ")"}], 
    RowBox[{"\[Rule]", "0"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ac21895-e93f-4cd4-abdd-856a5c0bd2c9"],
 ". The second expectation is a midpoint Riemann sum. Therefore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13e845e7-4db5-470c-9337-53e840f41d2a"],
 " converges weakly to uniform length on the segment:"
}], "Text",
 CellDingbat->None,ExpressionUUID->"9ecfb56d-f8cd-46d6-ba6a-1646ce4d900d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    StyleBox["f", "TI"], "\[DifferentialD]", 
    SubscriptBox["\[Mu]", 
     StyleBox["n", "TI"]], "\[LongRightArrow]", 
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    StyleBox["f", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["t", "TI"], 
      RowBox[{",", "0"}]}], ")"}], "\[DifferentialD]", 
    StyleBox["t", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "65c737cd-a180-4705-9042-06d1c3752b0e"],
 "  "
}], "DisplayFormula",ExpressionUUID->"b5cd8272-b79f-4768-b689-b9d2d4c0db7f"],

Cell[TextData[{
 "for every bounded continuous ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "248db989-1c3c-49e7-bb35-b59e5d452c69"],
 ". The unscaled transverse width grows like ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b51877d6-c113-48cf-9fcc-f85a9061611b"],
 " lattice spacings, while its width relative to endpoint separation \
decreases like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["n", "TI"], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"effb1ec2-cce9-4ee9-8f6a-b42ede1e60f0"],
 "."
}], "Text",
 CellDingbat->None,ExpressionUUID->"700dd95f-359d-416c-95ee-829430a60e8c"],

Cell["Measuring the limit", "Section",ExpressionUUID->"cfd807c7-a0cd-41bb-8591-23589f6c5692"],

Cell[TextData[{
 "For a point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Y", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8dae8acf-6971-4928-ad94-bc29f53ae4eb"],
 " sampled from ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f6ed4cfc-28fd-4c70-9a66-a02526a188c3"],
 ", define its width and longitudinal discrepancy by"
}], "Text",
 CellDingbat->None,ExpressionUUID->"995ccaee-f9b1-4435-9d7a-2fd2098e0f62"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["w", "TI"], "\[LongEqual]", 
     SqrtBox[
      RowBox[{
       StyleBox["E",
        FontSlant->"Plain"], 
       SuperscriptBox[
        StyleBox["Y", "TI"], "2"]}]]}], ",", "    ", 
    RowBox[{
     StyleBox["D", "TI"], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["sup", 
       StyleBox["t", "TI"],
       LimitsPositioning->True], 
      TemplateBox[{
        RowBox[{
          RowBox[{"Pr", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["X", "TI"], "\[LessEqual]", 
                StyleBox["t", "TI"]}], ")"}], "-", 
            StyleBox["U", "TI"], 
            RowBox[{"(", 
              StyleBox["t", "TI"], ")"}]}]}]},
       "Abs"]}]}], ","}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d03048d1-eb1d-423b-b960-69a1ed771c5b"],
 "  "
}], "DisplayFormula",ExpressionUUID->"0df937ac-1a0f-4e6f-908a-6eea2f53a5a6"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "700dd173-6e60-40dc-a941-8f9329006a40"],
 " is the distribution function of the uniform law on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "1"}], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6a0f2420-dfce-4b13-b7da-651d95f65466"],
 ". The square-grid formulas are"
}], "Text",
 CellDingbat->None,ExpressionUUID->"fdab6df0-0ddb-49ea-a693-2cb15508eedd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["n", "TI"]], "\[LongEqual]", 
     SqrtBox[
      FractionBox[
       RowBox[{"4", 
        StyleBox["n", "TI"], 
        RowBox[{"-", "1"}]}], 
       RowBox[{"48", 
        SuperscriptBox[
         StyleBox["n", "TI"], "2"]}]]]}], ",", "    ", 
    RowBox[{
     SubscriptBox[
      StyleBox["D", "TI"], 
      StyleBox["n", "TI"]], "\[LongEqual]", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", 
        StyleBox["n", "TI"]}]], "."}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7907d9f7-1fae-4a00-845e-a6621a1fdbc0"],
 "  "
}], "DisplayFormula",ExpressionUUID->"9682a654-9433-44ef-b722-d843fd617db7"],

Cell["\<\
The second formula follows from the largest discrepancy at a jump of the \
midpoint distribution. The helper below computes both quantities from edge \
densities and the graph's current embedding.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"89478c6e-9c34-414b-ae7b-0150b39e9b2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lineReadouts", "[", " ", 
   RowBox[{"g_Graph", ",", " ", "a_", ",", " ", "b_"}], " ", "]"}], " ", ":=",
   "\n", "  ", 
  RowBox[{"With", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"density", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", " ", 
          RowBox[{"a", ",", " ", "b"}], " ", "]"}], ",", 
         " ", "\"\<EdgeDensity\>\""}], " ", "]"}]}], ",", "\n", "      ", 
      RowBox[{"coordinates", " ", "=", " ", 
       RowBox[{"AssociationThread", "[", " ", 
        RowBox[{
         RowBox[{"VertexList", "[", " ", "g", " ", "]"}], ",", " ", 
         RowBox[{"GraphEmbedding", "[", " ", "g", " ", "]"}]}], " ", 
        "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{
        RowBox[{"Values", "[", " ", "density", " ", "]"}], " ", "/", " ", 
        RowBox[{"Total", "[", " ", "density", " ", "]"}]}]}], ",", " ", 
      RowBox[{"direction", " ", "=", " ", 
       RowBox[{
        RowBox[{"coordinates", "[", " ", "b", " ", "]"}], " ", "-", " ", 
        RowBox[{"coordinates", "[", " ", "a", " ", "]"}]}]}]}], " ", "}"}], ",",
     "\n", "    ", 
    RowBox[{"{", " ", 
     RowBox[{"midpoints", " ", "=", " ", 
      RowBox[{"Map", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"edge", " ", "|->", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", " ", 
            RowBox[{"direction", ",", " ", 
             RowBox[{"Cross", "[", " ", "direction", " ", "]"}]}], " ", "}"}],
            " ", ".", "\n", "          ", 
           RowBox[{"(", " ", 
            RowBox[{
             RowBox[{"Mean", "[", " ", 
              RowBox[{"Lookup", "[", " ", 
               RowBox[{"coordinates", ",", " ", 
                RowBox[{"List", " ", "@@", " ", "edge"}]}], " ", "]"}], " ", 
              "]"}], " ", "-", " ", 
             RowBox[{"coordinates", "[", " ", "a", " ", "]"}]}], " ", ")"}]}],
           " ", "/", " ", 
          RowBox[{"(", " ", 
           RowBox[{"direction", " ", ".", " ", "direction"}], " ", ")"}]}]}], 
        ",", "\n", "        ", 
        RowBox[{"Keys", "[", " ", "density", " ", "]"}]}], " ", "]"}]}], " ", 
     "}"}], ",", "\n", "    ", 
    RowBox[{"{", " ", 
     RowBox[{"order", " ", "=", " ", 
      RowBox[{"Ordering", "[", " ", 
       RowBox[{"midpoints", "[", 
        RowBox[{"[", " ", 
         RowBox[{"All", ",", " ", "1"}], " ", "]"}], "]"}], " ", "]"}]}], " ",
      "}"}], ",", "\n", "    ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"cumulative", " ", "=", " ", 
       RowBox[{"Accumulate", "[", " ", 
        RowBox[{"masses", "[", 
         RowBox[{"[", " ", "order", " ", "]"}], "]"}], " ", "]"}]}], ",", " ", 
      RowBox[{"positions", " ", "=", " ", 
       RowBox[{"Clip", "[", " ", 
        RowBox[{
         RowBox[{"midpoints", "[", 
          RowBox[{"[", " ", 
           RowBox[{"order", ",", " ", "1"}], " ", "]"}], "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"0", ",", " ", "1"}], " ", "}"}]}], " ", "]"}]}]}], " ", 
     "}"}], ",", "\n", "    ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", " ", 
       RowBox[{"masses", " ", ".", " ", 
        RowBox[{
         RowBox[{"midpoints", "[", 
          RowBox[{"[", " ", 
           RowBox[{"All", ",", " ", "2"}], " ", "]"}], "]"}], "^", "2"}]}], 
       " ", "]"}], ",", "\n", "      ", 
      RowBox[{"Max", "[", " ", 
       RowBox[{
        RowBox[{"Abs", "[", " ", 
         RowBox[{"cumulative", " ", "-", " ", "positions"}], " ", "]"}], ",", 
        " ", 
        RowBox[{"Abs", "[", " ", 
         RowBox[{"cumulative", " ", "-", " ", 
          RowBox[{"masses", "[", 
           RowBox[{"[", " ", "order", " ", "]"}], "]"}], " ", "-", " ", 
          "positions"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d492a8fa-f151-4153-9076-c36e72476efc"],

Cell["\<\
The orange points are measured from the graphs; the blue curves are the exact \
formulas. Both plots use the same endpoint and mass normalization as the \
pictures.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"00510adf-0219-4a62-b3a3-950d850a2be3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"readouts", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", " ", 
