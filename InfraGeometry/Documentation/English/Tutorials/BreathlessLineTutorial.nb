Cell["Beyond the grid", "Section",ExpressionUUID->"46bac2a3-f5eb-416c-a8d5-1cb77001b3b8"],

Cell[TextData[{
 "The columns below are square, triangular and hexagonal tilings and an \
irregular mesh. The rows show medium and large substrates in their inherited \
coordinates, with endpoints aligned to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a7d623d5-83a3-4390-ad74-8e80372e25ed"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"33506b52-2725-4ba5-88e6-69cfb969bbb6"],
 ". The blue occupation is compared with the dashed straight chord. On the \
shell at half the graph radius, choose its first vertex and then the vertex \
with the largest number of shortest paths to it. This selection rule applies \
uniformly across substrates."
}], "Text",
 CellDingbat->None,ExpressionUUID->"26d9c196-d3e9-4bdd-9ec7-51d17a3f9ae7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lineSubstrates", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"BlockRandom", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrate", "[", " ", 
            RowBox[{"name", ",", " ", "size", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            " ", "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
        " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"centre", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "g", " ", "]"}]}]}], ",", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Floor", "[", " ", 
           RowBox[{
            RowBox[{"GraphRadius", "[", " ", "g", " ", "]"}], " ", "/", " ", 
            "2"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"shell", " ", "=", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", " ", 
             RowBox[{"centre", ",", " ", "r"}], " ", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", "[", " ", "shell", " ", "]"}]}], " ", "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"MaximalBy", "[", " ", 
           RowBox[{"shell", ",", " ", 
            RowBox[{"v", " ", "|->", " ", 
             RowBox[{"InfraMeasurement", "[", " ", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", " ", 
                RowBox[{"a", ",", " ", "v"}], " ", "]"}], ",", 
               " ", "\"\<Cardinality\>\""}], " ", "]"}]}]}], " ", "]"}]}]}], 
        " ", "}"}], ",", "\n", "    ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"\"\<Graph\>\"", " ", "->", " ", "g"}], ",", " ", 
         RowBox[{"\"\<Endpoints\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"a", ",", " ", "b"}], " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}], ",", " ", 
         RowBox[{"\"\<Shell\>\"", " ", "->", " ", "shell"}]}], " ", "|>"}]}], 
      " ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"size", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
         " ", "\"\<Large\>\""}], " ", "}"}]}], " ", "}"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<TriangularTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\"", ",", 
         " ", "\"\<SquareMeshGraph\>\""}], " ", "}"}]}], " ", "}"}]}], " ", 
    "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Map", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"data", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
          
          RowBox[{"a", " ", "=", " ", 
           RowBox[{
            RowBox[{"data", "[", " ", "\"\<Endpoints\>\"", " ", "]"}], "[", 
            RowBox[{"[", " ", "1", " ", "]"}], "]"}]}], ",", " ", 
          RowBox[{"b", " ", "=", " ", 
           RowBox[{
            RowBox[{"data", "[", " ", "\"\<Endpoints\>\"", " ", "]"}], "[", 
            RowBox[{"[", " ", "2", " ", "]"}], "]"}]}]}], " ", "}"}], ",", 
        "\n", "      ", 
        RowBox[{"{", " ", 
         RowBox[{"coordinates", " ", "=", " ", 
          RowBox[{"AssociationThread", "[", " ", 
           RowBox[{
            RowBox[{"VertexList", "[", " ", "g", " ", "]"}], ",", " ", 
            RowBox[{"GraphEmbedding", "[", " ", "g", " ", "]"}]}], " ", 
           "]"}]}], " ", "}"}], ",", "\n", "      ", 
        RowBox[{"{", " ", 
         RowBox[{"direction", " ", "=", " ", 
          RowBox[{
           RowBox[{"coordinates", "[", " ", "b", " ", "]"}], " ", "-", " ", 
           RowBox[{"coordinates", "[", " ", "a", " ", "]"}]}]}], " ", "}"}], ",",
         "\n", "      ", 
        RowBox[{"{", " ", 
         RowBox[{"aligned", " ", "=", " ", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{"point", " ", "|->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"{", " ", 
                RowBox[{"direction", ",", " ", 
                 RowBox[{"Cross", "[", " ", "direction", " ", "]"}]}], " ", 
                "}"}], " ", ".", "\n", "          ", 
               RowBox[{"(", " ", 
                RowBox[{"point", " ", "-", " ", 
                 RowBox[{"coordinates", "[", " ", "a", " ", "]"}]}], " ", 
                ")"}]}], " ", "/", " ", 
              RowBox[{"(", " ", 
               RowBox[{"direction", " ", ".", " ", "direction"}], " ", 
               ")"}]}]}], ",", " ", 
            RowBox[{"GraphEmbedding", "[", " ", "g", " ", "]"}]}], " ", 
           "]"}]}], " ", "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", " ", 
         RowBox[{
          RowBox[{"Graph", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], " ", 
           "]"}], ",", " ", 
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraSegment", "[", " ", 
              RowBox[{"a", ",", " ", "b"}], " ", "]"}], " ", "->", " ", 
             "StandardBlue"}], ",", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"a", ",", " ", "b"}], " ", "}"}], " ", "->", " ", 
             "StandardBlue"}]}], " ", "}"}], ",", "\n", "        ", 
          RowBox[{"Epilog", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"StandardRed", ",", " ", "Dashed", ",", " ", 
             RowBox[{"Line", "[", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{"0", ",", " ", "0"}], " ", "}"}], ",", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"1", ",", " ", "0"}], " ", "}"}]}], " ", "}"}], " ", 
              "]"}]}], " ", "}"}]}], " ", ",", "\n", "        ", 
          RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"Rest", "[", " ", "lineSubstrates", " ", "]"}], ",", " ", 
     RowBox[{"{", " ", "2", " ", "}"}]}], " ", "]"}], ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"ee3a41c7-3a99-4170-8533-dd98d91bcbd4"],

