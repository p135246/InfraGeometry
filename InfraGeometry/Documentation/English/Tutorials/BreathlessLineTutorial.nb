Notebook[{

Cell[CellGroupData[{
Cell["The Breathless Line", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[StyleBox["Reviewed by Pavel Hajek.", "TI"]], "Text",
 CellDingbat->None,ExpressionUUID->"29195e13-f070-4eda-87ea-ef3991911312"],

Cell["\<\
Can a family of shortest paths spread across a graph produce a line with no \
breadth? On the square grid, the normalized occupation measure converges to \
uniform length on a straight segment, though the union of the paths still \
fills a square. We prove this and compare the finite measurements to the \
formula.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"0bd0432b-05f1-45c0-8c7e-501889886115"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"74acae6b-ad9f-42a3-8061-9c283e00fd57"],

Cell["A probability measure on a segment", "Section",ExpressionUUID->"9d996800-2f74-4dff-98a6-d68070329fbe"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e5381dc3-8cbe-45e0-bbcb-71f53f58b228"],
 " be distinct vertices of a finite connected unweighted graph. Suppose there \
are ",
 Cell[BoxData[
  FormBox[
   StyleBox["N", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "435203ec-78f2-40f2-9963-047850eca0d2"],
 " shortest paths between them, each of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aaa55d1f-475e-4fb7-b195-444305cd8d59"],
 ". If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["E", "TI"]], "(", 
    StyleBox["e", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f6cc7712-dd4f-4c63-ba19-05da8bbbbe88"],
 " counts these paths through edge ",
 Cell[BoxData[
  FormBox[
   StyleBox["e", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ee93d4a9-cdac-43f0-88ef-71ff98e981d3"],
 ", then"
}], "Text",
 CellDingbat->None,ExpressionUUID->"10c67cf7-8e0f-4d0f-a276-1f62cdbed709"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["e", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["E", "TI"]], 
    RowBox[{"(", 
     StyleBox["e", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["N", "TI"], 
    StyleBox["L", "TI"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"812b6aa5-eab9-4c38-83f1-c2e71a2963e8"],
 "  "
}], "DisplayFormula",ExpressionUUID->"008a567a-ef9c-41db-a5f8-f473eba81420"],

Cell[TextData[{
 "Choose a path uniformly, then choose one of its edges uniformly. The \
probability of observing edge ",
 Cell[BoxData[
  FormBox[
   StyleBox["e", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "88a1779c-6f83-4360-ad5b-14ca3aa773bf"],
 " is"
}], "Text",
 CellDingbat->None,ExpressionUUID->"4283ea7c-047c-4ce2-8347-c4f3f72f5635"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["E", "TI"]], 
    RowBox[{"(", 
     StyleBox["e", "TI"], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["E", "TI"]], "(", 
      StyleBox["e", "TI"], ")"}], 
     StyleBox[
      RowBox[{"N", "L"}], "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"03fcc3df-91fe-4fb8-b33f-abd836d00592"],
 "  "
}], "DisplayFormula",ExpressionUUID->"ac459804-28f2-4281-8554-91ef53b881d2"],

Cell[TextData[{
 "The occupation probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["E", "TI"]], 
    RowBox[{"(", 
     StyleBox["e", "TI"], ")"}], "/", 
    StyleBox["N", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "db20bb45-90f3-4d88-b63e-b33b395aec45"],
 " has total mass ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3a855c59-fec6-4895-b8ff-8990449f9089"],
 "; dividing by ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ac73e4e2-2713-4955-bd84-7936a9715c5a"],
 " makes a probability distribution over locations. ",
 ButtonBox["InfraMeasurement",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement"], None},
  ButtonNote->"paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement"],
 " supplies ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["E", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4d655eb6-28bc-4164-8bc6-3394f10fcb7b"],
 " through ",
 Cell["\"EdgeDensity\"", "InlineCode",ExpressionUUID->
  "c00d4fb8-8829-418a-a033-d633cedabbf6"],
 ", without enumerating the paths."
}], "Text",
 CellDingbat->None,ExpressionUUID->"a293c88f-915c-4416-8186-1d8b1c671736"],

Cell[TextData[{
 "Choose an embedding and align the endpoints to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"01f8b319-a87e-4a04-bd2e-d2e18537778c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"95eabbbc-323d-41ab-a376-d832a587eabb"],
 " using translation, rotation and uniform rescaling. Place the mass of each \
edge at its midpoint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], "(", 
    StyleBox["e", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"32ce71d0-0584-458c-b1f5-247d13df7ae9"],
 ":"
}], "Text",
 CellDingbat->None,ExpressionUUID->"d074551c-a670-4862-bb45-4f8ab6dd13f4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Mu]", "\[LongEqual]"}], 
    UnderscriptBox["\[Sum]", 
     StyleBox["e", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["E", "TI"]], 
    RowBox[{"(", 
     StyleBox["e", "TI"], ")"}], 
    SubscriptBox["\[Delta]", 
     RowBox[{
      StyleBox["x", "TI"], "(", 
      StyleBox["e", "TI"], ")"}]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d757f603-744f-4461-977d-da39ba3681f4"],
 "  "
}], "DisplayFormula",ExpressionUUID->"454b0ba6-8d7a-40b4-bed7-6cbe5f818ce9"],

Cell["\<\
This is the normalization used across scales: endpoint separation and total \
mass are both one. The graph determines the paths and weights; the embedding \
determines their positions.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"0eb306c9-4955-4a07-926b-8ca31c2258f2"],

Cell["The square grid", "Section",ExpressionUUID->"d925242e-ad04-4991-9a64-779c6f7aadeb"],

Cell[TextData[{
 "Take the grid ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", ",", "\[Ellipsis]", ","}], 
      StyleBox["n", "TI"]}], "}"}], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"08741ffd-0938-467e-bcba-c225fb25adc6"],
 " with endpoints ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3fa3b630-13bc-4d04-be20-7f4aff3df4b1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["n", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2b94371e-7179-4362-a5c1-d236753402eb"],
 ". Every shortest path has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b2af8b29-d6a4-4777-8e99-bc8483882bf4"],
 " steps, with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "144af9ac-2af9-457e-9ba9-72e70cb9a1b0"],
 " horizontal and ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0f67166f-e701-4f44-a0a0-dc3f982961c8"],
 " vertical steps. There are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"2", 
       StyleBox["n", "TI"]}], 
     StyleBox["n", "TI"]},
    "Binomial"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d5279327-c55a-4bc3-b7d0-b4c0ec1423d3"],
 " such paths. The aligned coordinates are"
}], "Text",
 CellDingbat->None,ExpressionUUID->"10814a03-fdf2-4888-a9f5-ed137a292a24"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["n", "TI"]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["i", "TI"], "+", 
        StyleBox["j", "TI"]}], 
       RowBox[{"2", 
        StyleBox["n", "TI"]}]], ",", 
      FractionBox[
       RowBox[{
        StyleBox["j", "TI"], "-", 
        StyleBox["i", "TI"]}], 
       RowBox[{"2", 
        StyleBox["n", "TI"]}]]}], ")"}], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ea840e3a-a636-4fb8-bdd8-3ced16ce1b77"],
 "  "
}], "DisplayFormula",ExpressionUUID->"e22b9365-45a8-4f0f-86ab-8a8a97a97485"],

Cell[TextData[{
 "The panels show ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], 
    RowBox[{
     RowBox[{"\[LongEqual]", "8"}], ",", "16", ",", "32"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0d02b396-ab73-43fa-994b-f740cbf508ed"],
 " with endpoints fixed. Thickness records relative occupation within each \
panel. Every grid edge lies on some shortest path, so the narrowing reflects \
changing weights rather than shrinking support. The dashed orange lines \
enclose a strip of half-width ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", 
        StyleBox["n", "TI"], 
        RowBox[{"-", "1"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"48", 
        SuperscriptBox[
         StyleBox["n", "TI"], "2"]}], ")"}]}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"42c6283d-5472-4450-8918-92d733b3bc38"],
 ". The second-moment computation below shows that this strip contains at \
least three quarters of the occupation mass at every ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b1cdd91d-8c63-4796-a74f-52b46ed8d8e3"],
 ". Its width shrinks while the gray boundary of the support stays fixed."
}], "Text",
 CellDingbat->None,ExpressionUUID->"58a52639-256f-4815-a95c-91671ef7b02e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", " ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"coordinates", " ", "=", " ", 
         RowBox[{"Map", "[", " ", 
          RowBox[{
           RowBox[{"point", " ", "|->", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"Total", "[", " ", "point", " ", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"point", "[", 
                 RowBox[{"[", " ", "2", " ", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"point", "[", 
                 RowBox[{"[", " ", "1", " ", "]"}], "]"}]}]}], " ", "}"}], 
             " ", "/", " ", 
             RowBox[{"(", " ", 
              RowBox[{"2", " ", "n"}], " ", ")"}]}]}], ",", "\n", "        ", 
           
           RowBox[{"Tuples", "[", " ", 
            RowBox[{
             RowBox[{"Range", "[", " ", 
              RowBox[{"0", ",", " ", "n"}], " ", "]"}], ",", " ", "2"}], " ", 
            "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"GridGraph", "[", " ", 
          RowBox[{
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"n", " ", "+", " ", "1"}], ",", " ", 
             RowBox[{"n", " ", "+", " ", "1"}]}], " ", "}"}], ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}], ",", 
           "\n", "        ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{
            "InfraSubstrateStyle", "[", " ", "\"\<Large\>\"", " ", "]"}]}]}], 
          " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"halfWidth", " ", "=", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", " ", 
           RowBox[{
            RowBox[{"(", " ", 
             RowBox[{
              RowBox[{"4", " ", "n"}], " ", "-", " ", "1"}], " ", ")"}], " ", 
            "/", " ", 
            RowBox[{"(", " ", 
             RowBox[{"48", " ", 
              RowBox[{"n", "^", "2"}]}], " ", ")"}]}], " ", "]"}]}]}], " ", 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Labeled", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"InfraSegment", "[", " ", 
               RowBox[{"1", ",", " ", 
                RowBox[{
                 RowBox[{"(", " ", 
                  RowBox[{"n", " ", "+", " ", "1"}], " ", ")"}], "^", "2"}]}],
                " ", "]"}], " ", "->", " ", "StandardBlue"}], ",", "\n", 
             "        ", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{"1", ",", " ", 
                RowBox[{
                 RowBox[{"(", " ", 
                  RowBox[{"n", " ", "+", " ", "1"}], " ", ")"}], "^", "2"}]}],
                " ", "}"}], " ", "->", " ", "StandardBlue"}]}], " ", "}"}], ",",
            "\n", "        ", 
           RowBox[{"Epilog", " ", "->", " ", 
            RowBox[{"{", "\n", "          ", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Line", "[", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", "0"}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], ",", " ", 
                   RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}]}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"1", ",", " ", "0"}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], ",", " ", 
                   RowBox[{"1", "/", "2"}]}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", "0"}], " ", "}"}]}], " ", "}"}], " ",
                "]"}], ",", "\n", "          ", "StandardOrange", ",", " ", 
              "Dashed", ",", "\n", "          ", 
              RowBox[{"Line", "[", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"-", "halfWidth"}]}], " ", "}"}], ",", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"1", ",", " ", 
                   RowBox[{"-", "halfWidth"}]}], " ", "}"}]}], " ", "}"}], 
               " ", "]"}], ",", "\n", "          ", 
              RowBox[{"Line", "[", " ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"{", " ", 
                  RowBox[{"0", ",", " ", "halfWidth"}], " ", "}"}], ",", " ", 
                 
                 RowBox[{"{", " ", 
                  RowBox[{"1", ",", " ", "halfWidth"}], " ", "}"}]}], " ", 
                "}"}], " ", "]"}]}], " ", "}"}]}], ",", "\n", "        ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{"0", ",", " ", "1"}], " ", "}"}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
                RowBox[{"1", "/", "2"}]}], " ", "}"}]}], " ", "}"}]}], ",", 
           " ", 
           RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{"0.1", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Row", "[", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<n = \>\"", ",", " ", "n", ",", 
            " ", "\"\<, strip mass at least 3/4\>\""}], " ", "}"}], " ", 
          "]"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"8", ",", " ", "16", ",", " ", "32"}], " ", "}"}]}], " ", 
      "}"}]}], " ", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"486be2e4-1943-4367-9209-5f55b7ae52ac"],

