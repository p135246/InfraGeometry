Cell[TextData[{
 "The width decreases on these meshes, while the longitudinal discrepancy \
first decreases then rises. The meshes are separate discretizations, so \
endpoints can shift with resolution. These finite measurements test the \
selection procedure but do not establish a limit for fixed endpoints. For a \
nested sequence, one could barycentrically subdivide a fixed triangulated \
square, retain its inherited coordinates and the same two corners, then ask \
whether both ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec762d2d-8722-4235-a922-69e6a16be409"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bd6cb214-a156-4a12-adb3-c9f97ee76ca3"],
 " tend to zero. Refinement alone leaves this unsettled when every new edge \
still carries unit graph cost."
}], "Text",
 CellDingbat->None,ExpressionUUID->"d007552c-5b45-4e27-9811-83b77b2b580e"],

Cell["Triangles on different substrates", "Section",ExpressionUUID->"617276c5-f1ed-4916-aff4-e53bc80d0d68"],

Cell["\<\
The top row shows large square, cube and sphere meshes; the bottom row shows \
a square torus, Sierpinski triangle and binary tree. Choose two far-apart \
vertices using successive graph-distance searches, then a third vertex as far \
as possible from the closer endpoint. Three colors display their \
shortest-path families in the graph's native layout. No coordinate alignment \
enters this construction. On a tree, the three sides share branches, so a \
graph triangle need not resemble a Euclidean triangle.\
\>", "Text",
 CellDingbat->None,ExpressionUUID->"b831be80-bf2f-4930-b584-35a0dd3bce5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Partition", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"BlockRandom", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrate", "[", " ", 
              RowBox[{
               RowBox[{"specification", "[", 
                RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", 
               " ", "\"\<Large\>\""}], " ", "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"vertices", " ", "=", " ", 
            RowBox[{"VertexList", "[", " ", "g", " ", "]"}]}], ",", " ", 
           RowBox[{"distances", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", "[", " ", "g", " ", "]"}]}]}], " ",
           "}"}], ",", "\n", "        ", 
         RowBox[{"{", " ", 
          RowBox[{"firstIndex", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Ordering", "[", " ", 
             RowBox[{
              RowBox[{"distances", "[", 
               RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", " ", 
              RowBox[{"-", "1"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", " ", 
          RowBox[{"secondIndex", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Ordering", "[", " ", 
             RowBox[{
              RowBox[{"distances", "[", 
               RowBox[{"[", " ", "firstIndex", " ", "]"}], "]"}], ",", " ", 
              RowBox[{"-", "1"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", " ", 
          RowBox[{"thirdIndex", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Ordering", "[", "\n", "            ", 
             RowBox[{
              RowBox[{"Min", " ", "/@", " ", 
               RowBox[{"Transpose", "[", " ", 
                RowBox[{"distances", "[", 
                 RowBox[{"[", " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"firstIndex", ",", " ", "secondIndex"}], " ", 
                   "}"}], " ", "]"}], "]"}], " ", "]"}]}], ",", " ", 
              RowBox[{"-", "1"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"a", " ", "=", " ", 
            RowBox[{"vertices", "[", 
             RowBox[{"[", " ", "firstIndex", " ", "]"}], "]"}]}], ",", " ", 
           RowBox[{"b", " ", "=", " ", 
            RowBox[{"vertices", "[", 
             RowBox[{"[", " ", "secondIndex", " ", "]"}], "]"}]}], ",", " ", 
           RowBox[{"third", " ", "=", " ", 
            RowBox[{"vertices", "[", 
             RowBox[{"[", " ", "thirdIndex", " ", "]"}], "]"}]}]}], " ", 
          "}"}], ",", "\n", "        ", 
         RowBox[{"Labeled", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", "\n", "            ", 
              RowBox[{
               RowBox[{
                RowBox[{"InfraSegment", "[", " ", 
                 RowBox[{"a", ",", " ", "b"}], " ", "]"}], " ", "->", " ", 
                "StandardBlue"}], ",", "\n", "            ", 
               RowBox[{
                RowBox[{"InfraSegment", "[", " ", 
                 RowBox[{"b", ",", " ", "third"}], " ", "]"}], " ", "->", " ",
                 "StandardOrange"}], ",", "\n", "            ", 
               RowBox[{
                RowBox[{"InfraSegment", "[", " ", 
                 RowBox[{"third", ",", " ", "a"}], " ", "]"}], " ", "->", " ",
                 "StandardRed"}], ",", "\n", "            ", 
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{"a", ",", " ", "b", ",", " ", "third"}], " ", "}"}], 
                " ", "->", " ", "StandardBlue"}]}], " ", "}"}], " ", ",", 
             "\n", "            ", 
             RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"1.25", ",", " ", "5"}], " ", "}"}]}]}], " ", "]"}], ",",
            "\n", "          ", 
           RowBox[{"specification", "[", 
            RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "]"}]}], " ", 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{"specification", ",", " ", 
         RowBox[{"{", "\n", "          ", 
          RowBox[{
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
             " ", "\"\<square mesh\>\""}], " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            RowBox[{"\"\<CubeMeshGraph\>\"", ",", " ", "\"\<cube mesh\>\""}], 
            " ", "}"}], ",", "\n", "          ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SphereMeshGraph\>\"", ",", 
             " ", "\"\<sphere mesh\>\""}], " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SquareTorusGraph\>\"", ",", 
             " ", "\"\<square torus\>\""}], " ", "}"}], ",", "\n", 
           "          ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", 
             " ", "\"\<Sierpinski triangle\>\""}], " ", "}"}], ",", " ", 
           RowBox[{"{", " ", 
            
            RowBox[{"\"\<BinaryTreeGraph\>\"", ",", 
             " ", "\"\<binary tree\>\""}], " ", "}"}]}], " ", "}"}]}], " ", 
        "}"}]}], " ", "]"}], ",", "\n", "    ", "3"}], " ", "]"}], ",", "\n", 
   "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "1200"}]}], " ", "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"9974809c-b03c-4522-be39-b5810f0054ab"],

