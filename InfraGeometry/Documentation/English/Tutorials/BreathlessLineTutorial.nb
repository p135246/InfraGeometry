Cell[TextData[{
 "If three normalized side measures converge in a common ambient space, their \
equal mixture converges to the mixture of the three limits. When those limits \
are uniform measures on straight segments, each side has mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e40f2ff-6db2-44de-bab5-c3ec6f863dc4"],
 "; this equals normalized perimeter length only when the side lengths \
match."
}], "Text",
 CellDingbat->None,ExpressionUUID->"429ec011-be8a-4f89-9341-1c6ce6785d22"],

Cell[TextData[{
 "The grid example shows that occupation can concentrate on Euclidean \
segments without making graph distances Euclidean. ",
 ButtonBox["The Metric Tensor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["paclet:WolframInstitute/InfraGeometry/tutorial/MetricTensorTutorial"]\
, None},
  ButtonNote->
   "paclet:WolframInstitute/InfraGeometry/tutorial/MetricTensorTutorial"],
 " examines this remaining anisotropy."
}], "Text",
 CellDingbat->None,ExpressionUUID->"628a61b3-fbbe-4a41-b5c2-9b3b0b324ebd"],

